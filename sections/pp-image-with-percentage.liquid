{% assign gradient_style = '' %}
{% if section.settings.gradient != blank %}
  {% assign gradient_style = 'background: ' | append: section.settings.gradient | append: ';' %}
{% endif %}

<div class="pp-section pp-percentage-section page-width" style="{{ gradient_style }} padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px;">
  <div class="pp-percentage-inner">
    {%- if section.settings.image != blank -%}
      <div class="pp-percentage-media" style="border-radius: {{ section.settings.image_border_radius }}px;">
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
      </div>
    {%- endif -%}
    <div class="pp-percentage-content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="{{ block.settings.heading_size }}" style="text-align: {{ block.settings.heading_alignment }}; color: {{ block.settings.heading_color }};" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'percent' -%}
            <div class="pp-percent-item" style="border: {{ block.settings.border_size }}px solid {{ block.settings.border_color }};" {{ block.shopify_attributes }}>
              <div class="pp-percent-bar">
                <div class="pp-percent-fill" style="width: {{ block.settings.percent_value }}%; background: {{ block.settings.percent_filled_color }};"></div>
              </div>
              <div class="pp-percent-value" style="color: {{ block.settings.percent_text_color }};">{{ block.settings.percent_value }}%</div>
              <div class="rte" style="color: {{ block.settings.text_color }};">{{ block.settings.text }}</div>
            </div>
          {%- when 'button' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.button_link != blank -%}
                <a href="{{ block.settings.button_link }}" class="button" style="background: {{ block.settings.button_background_color }}; color: {{ block.settings.button_text_color }};">{{ block.settings.button_label }}</a>
              {%- endif -%}
              {%- if block.settings.button_subtext != blank -%}
                <p class="caption" style="color: {{ block.settings.button_subtext_color }};">{{ block.settings.button_subtext }}</p>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .pp-percentage-inner { display: flex; flex-direction: column; gap: 2rem; }
  @media screen and (min-width: 750px) {
    .pp-percentage-inner { flex-direction: row; align-items: center; }
    .pp-percentage-media, .pp-percentage-content { flex: 1; }
  }
  .pp-percentage-media img { width: 100%; height: auto; display: block; }
  .pp-percentage-content { display: flex; flex-direction: column; gap: 1.6rem; }
  .pp-percent-item { padding: 1.4rem; border-radius: 8px; }
  .pp-percent-bar { width: 100%; height: 8px; border-radius: 4px; background: #eee; overflow: hidden; margin-bottom: 0.6rem; }
  .pp-percent-fill { height: 100%; }
  .pp-percent-value { font-weight: 700; font-size: 1.8rem; margin-bottom: 0.4rem; }
</style>

{% schema %}
{
  "name": "PP - Image With Percent",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "desktop_image_width", "options": [{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"}], "default": "large", "label": "Image width" },
    { "type": "range", "id": "image_border_radius", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 8, "label": "Image corner radius" },
    { "type": "select", "id": "layout", "options": [{"value":"text_first","label":"Text first"},{"value":"image_first","label":"Image first"}], "default": "image_first", "label": "Desktop layout" },
    { "type": "select", "id": "mobile_layout", "options": [{"value":"text_first","label":"Text first"},{"value":"image_first","label":"Image first"}], "default": "image_first", "label": "Mobile layout" },
    { "type": "color_background", "id": "gradient", "label": "Background color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Bottom padding" },
    { "type": "range", "id": "margin_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Top margin" },
    { "type": "range", "id": "margin_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Bottom margin" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "default": "Heading", "label": "Heading" },
        { "type": "select", "id": "heading_size", "options": [{"value":"h2","label":"Small"},{"value":"h1","label":"Medium"},{"value":"h0","label":"Large"}], "default": "h1", "label": "Heading size" },
        { "type": "select", "id": "heading_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left", "label": "Alignment" },
        { "type": "select", "id": "heading_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left", "label": "Mobile alignment" },
        { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" }
      ]
    },
    {
      "type": "percent",
      "name": "Percent stat",
      "settings": [
        { "type": "range", "id": "percent_value", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 100, "label": "Value" },
        { "type": "color", "id": "percent_filled_color", "label": "Filled color", "default": "#000000" },
        { "type": "color", "id": "percent_unfilled_color", "label": "Unfilled color", "default": "#C7C7C7" },
        { "type": "color", "id": "percent_text_color", "label": "Value text color", "default": "#000000" },
        { "type": "color", "id": "percent_background_color", "label": "Background color", "default": "#ffffff" },
        { "type": "richtext", "id": "text", "default": "<p>Description</p>", "label": "Description" },
        { "type": "select", "id": "text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "body", "label": "Text size" },
        { "type": "select", "id": "text_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left", "label": "Alignment" },
        { "type": "select", "id": "text_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left", "label": "Mobile alignment" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
        { "type": "range", "id": "border_size", "min": 0, "max": 5, "step": 1, "unit": "px", "default": 1, "label": "Border size" },
        { "type": "color", "id": "border_color", "label": "Border color", "default": "#d0d5dd" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "button_label", "default": "Shop Now", "label": "Label" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "checkbox", "id": "button_link_newtab", "default": false, "label": "Open in new tab" },
        { "type": "color", "id": "button_text_color", "label": "Text color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_background_color", "label": "Background color", "default": "#000000" },
        { "type": "range", "id": "button_border_width", "min": 0, "max": 10, "step": 1, "unit": "px", "default": 0, "label": "Border width" },
        { "type": "color", "id": "button_border_color", "label": "Border color", "default": "#000000" },
        { "type": "select", "id": "button_width", "options": [{"value":"fit","label":"Fit"},{"value":"full","label":"Full"}], "default": "full", "label": "Width" },
        { "type": "select", "id": "button_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left", "label": "Alignment" },
        { "type": "select", "id": "button_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left", "label": "Mobile alignment" },
        { "type": "select", "id": "button_rounded_corners", "options": [{"value":"none","label":"None"},{"value":"medium","label":"Medium"},{"value":"full","label":"Full"}], "default": "medium", "label": "Corners" },
        { "type": "range", "id": "button_padding_vertical", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 15, "label": "Vertical padding" },
        { "type": "range", "id": "button_padding_horizontal", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 15, "label": "Horizontal padding" },
        { "type": "text", "id": "button_subtext", "label": "Subtext" },
        { "type": "select", "id": "button_subtext_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "body", "label": "Subtext size" },
        { "type": "color", "id": "button_subtext_color", "label": "Subtext color", "default": "#000000" },
        { "type": "select", "id": "button_action", "options": [{"value":"link","label":"Link"},{"value":"scroll","label":"Scroll"}], "default": "link", "label": "Action" },
        { "type": "text", "id": "button_action_scroll_element", "label": "Scroll target" }
      ]
    }
  ],
  "presets": [
    { "name": "PP - Image With Percent", "blocks": [{"type":"heading"},{"type":"percent"},{"type":"percent"},{"type":"percent"},{"type":"button"}] }
  ]
}
{% endschema %}
