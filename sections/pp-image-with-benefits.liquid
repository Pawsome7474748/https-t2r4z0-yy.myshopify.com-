{% assign gradient_style = '' %}
{% if section.settings.gradient != blank %}
  {% assign gradient_style = 'background: ' | append: section.settings.gradient | append: ';' %}
{% endif %}

<div class="pp-section pp-benefits-section page-width" style="{{ gradient_style }} padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="{{ section.settings.heading_size }}" style="text-align: {{ section.settings.heading_alignment }}; color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <div class="rte" style="text-align: {{ section.settings.text_alignment }}; color: {{ section.settings.text_color }};">{{ section.settings.text }}</div>
  {%- endif -%}
  <div class="pp-benefits-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'benefit' -%}
        <div class="pp-benefit-card" {{ block.shopify_attributes }}>
          <span class="pp-benefit-emoji">{{ block.settings.emoji }}</span>
          <h3 class="{{ block.settings.heading_size }}" style="color: {{ block.settings.heading_color }};">{{ block.settings.heading }}</h3>
          <div class="rte" style="color: {{ block.settings.text_color }};">{{ block.settings.text }}</div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<style>
  .pp-benefits-section { text-align: center; }
  .pp-benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }
  @media screen and (min-width: 750px) {
    .pp-benefits-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .pp-benefit-card { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
  .pp-benefit-emoji { font-size: 3.6rem; line-height: 1; }
</style>

{% schema %}
{
  "name": "PP - Image With Benefits",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "default": "Why customers love it", "label": "Heading" },
    { "type": "select", "id": "heading_size", "options": [{"value":"h2","label":"Small"},{"value":"h1","label":"Medium"},{"value":"h0","label":"Large"}], "default": "h1", "label": "Heading size" },
    { "type": "select", "id": "heading_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Alignment" },
    { "type": "select", "id": "heading_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "subtitle", "label": "Text size" },
    { "type": "select", "id": "text_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Alignment" },
    { "type": "select", "id": "text_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "select", "id": "desktop_image_width", "options": [{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"}], "default": "large", "label": "Image width" },
    { "type": "range", "id": "image_border_radius", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0, "label": "Image corner radius" },
    { "type": "color_background", "id": "gradient", "label": "Background color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 20, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 20, "label": "Bottom padding" },
    { "type": "range", "id": "margin_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Top margin" },
    { "type": "range", "id": "margin_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Bottom margin" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "emoji", "default": "😂", "label": "Emoji" },
        { "type": "select", "id": "emoji_size", "options": [{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"}], "default": "medium", "label": "Emoji size" },
        { "type": "inline_richtext", "id": "heading", "default": "Benefit", "label": "Heading" },
        { "type": "select", "id": "heading_size", "options": [{"value":"h4","label":"Small"},{"value":"h3","label":"Medium"},{"value":"h2","label":"Large"}], "default": "h3", "label": "Heading size" },
        { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
        { "type": "richtext", "id": "text", "default": "<p>Benefit text</p>", "label": "Text" },
        { "type": "select", "id": "text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "body", "label": "Text size" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" }
      ]
    }
  ],
  "presets": [
    { "name": "PP - Image With Benefits", "blocks": [{"type":"benefit"},{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}] }
  ]
}
{% endschema %}
