{% assign gradient_style = '' %}
{% if section.settings.gradient != blank %}
  {% assign gradient_style = 'background: ' | append: section.settings.gradient | append: ';' %}
{% endif %}

{%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
{%- assign half = benefit_blocks.size | plus: 1 | divided_by: 2 -%}

<div class="pp-section pp-benefits-section page-width" style="{{ gradient_style }} padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px;">

  {%- if section.settings.heading != blank -%}
    <h2 class="{{ section.settings.heading_size }} pp-benefits-heading" style="text-align: {{ section.settings.heading_alignment }}; color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.text != blank -%}
    <div class="rte pp-benefits-subtitle" style="text-align: {{ section.settings.text_alignment }}; color: {{ section.settings.text_color }};">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- if section.settings.product_info != blank -%}
    <div class="pp-product-info" style="color: {{ section.settings.product_info_color }};">{{ section.settings.product_info }}</div>
  {%- endif -%}

  <div class="pp-benefits-layout">
    <div class="pp-benefits-col pp-benefits-col--left">
      {%- for block in benefit_blocks -%}
        {%- if forloop.index <= half -%}
          <div class="pp-benefit-item" {{ block.shopify_attributes }}>
            <div class="pp-benefit-item__head">
              <span class="pp-benefit-check" style="color: {{ section.settings.checkmark_color }};">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M7.5 12.5l3 3 6-6.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <h3 class="{{ block.settings.heading_size }}" style="color: {{ block.settings.heading_color }};">
                <span class="pp-benefit-emoji">{{ block.settings.emoji }}</span> {{ block.settings.heading }}
              </h3>
            </div>
            <div class="rte pp-benefit-text" style="color: {{ block.settings.text_color }};">{{ block.settings.text }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.logo_image != blank -%}
      <div class="pp-benefits-logo">
        {{ section.settings.logo_image | image_url: width: 500 | image_tag: alt: section.settings.heading, loading: 'lazy' }}
      </div>
    {%- endif -%}

    <div class="pp-benefits-col pp-benefits-col--right">
      {%- for block in benefit_blocks -%}
        {%- if forloop.index > half -%}
          <div class="pp-benefit-item" {{ block.shopify_attributes }}>
            <div class="pp-benefit-item__head">
              <span class="pp-benefit-check" style="color: {{ section.settings.checkmark_color }};">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M7.5 12.5l3 3 6-6.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <h3 class="{{ block.settings.heading_size }}" style="color: {{ block.settings.heading_color }};">
                <span class="pp-benefit-emoji">{{ block.settings.emoji }}</span> {{ block.settings.heading }}
              </h3>
            </div>
            <div class="rte pp-benefit-text" style="color: {{ block.settings.text_color }};">{{ block.settings.text }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .pp-benefits-heading { text-align: center; }
  .pp-benefits-subtitle { text-align: center; margin-top: .6rem; }
  .pp-product-info { text-align: center; font-size: 1.1rem; font-weight: 700; margin: 1rem 0 0; letter-spacing: 0.05em; }

  .pp-benefits-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    margin-top: 2.8rem;
    align-items: center;
  }
  @media screen and (min-width: 750px) {
    .pp-benefits-layout { grid-template-columns: 1fr 1fr 1fr; gap: 2rem; }
  }

  .pp-benefits-col { display: flex; flex-direction: column; gap: 2rem; }
  .pp-benefits-col--right { text-align: left; }
  @media screen and (min-width: 750px) {
    .pp-benefits-col--right .pp-benefit-item__head { justify-content: flex-start; }
  }

  .pp-benefits-logo { display: flex; justify-content: center; order: -1; }
  @media screen and (min-width: 750px) { .pp-benefits-logo { order: 0; } }
  .pp-benefits-logo img { max-width: 260px; width: 100%; height: auto; }

  .pp-benefit-item__head { display: flex; align-items: flex-start; gap: .7rem; }
  .pp-benefit-item__head h3 { margin: 0; line-height: 1.3; }
  .pp-benefit-check { flex: 0 0 auto; display: inline-flex; margin-top: .3rem; }
  .pp-benefit-check svg { width: 1.9rem; height: 1.9rem; }
  .pp-benefit-emoji { font-size: 1em; line-height: 1; }
  .pp-benefit-text { margin-top: .5rem; }
</style>

{% schema %}
{
  "name": "PP - Image With Benefits",
  "settings": [
    { "type": "image_picker", "id": "logo_image", "label": "Logo image" },
    { "type": "inline_richtext", "id": "heading", "default": "Why You'll Love It", "label": "Heading" },
    { "type": "select", "id": "heading_size", "options": [{"value":"h2","label":"Small"},{"value":"h1","label":"Medium"},{"value":"h0","label":"Large"}], "default": "h1", "label": "Heading size" },
    { "type": "select", "id": "heading_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Alignment" },
    { "type": "select", "id": "heading_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#0A3161" },
    { "type": "richtext", "id": "text", "label": "Subtitle text" },
    { "type": "select", "id": "text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "subtitle", "label": "Text size" },
    { "type": "select", "id": "text_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Alignment" },
    { "type": "select", "id": "text_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0A3161" },
    { "type": "richtext", "id": "product_info", "label": "Product info (extra line)" },
    { "type": "color", "id": "product_info_color", "label": "Product info color", "default": "#0A3161" },
    { "type": "color", "id": "checkmark_color", "label": "Checkmark icon color", "default": "#B31942" },
    { "type": "color_background", "id": "gradient", "label": "Background color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 20, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 20, "label": "Bottom padding" },
    { "type": "range", "id": "margin_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Top margin" },
    { "type": "range", "id": "margin_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Bottom margin" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "emoji", "default": "😄", "label": "Icon/emoji" },
        { "type": "inline_richtext", "id": "heading", "default": "Benefit", "label": "Heading" },
        { "type": "select", "id": "heading_size", "options": [{"value":"h4","label":"Small"},{"value":"h3","label":"Medium"},{"value":"h2","label":"Large"}], "default": "h3", "label": "Heading size" },
        { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#0A3161" },
        { "type": "richtext", "id": "text", "default": "<p>Benefit text</p>", "label": "Description" },
        { "type": "select", "id": "text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "body", "label": "Text size" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#0A3161" }
      ]
    }
  ],
  "presets": [
    { "name": "PP - Image With Benefits", "blocks": [{"type":"benefit"},{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}] }
  ]
}
{% endschema %}
