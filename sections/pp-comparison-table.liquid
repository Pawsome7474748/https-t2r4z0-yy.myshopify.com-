{% assign gradient_style = '' %}
{% if section.settings.gradient != blank %}
  {% assign gradient_style = 'background: ' | append: section.settings.gradient | append: ';' %}
{% endif %}

<div class="pp-section pp-comparison-section page-width" style="{{ gradient_style }} padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px;">
  {%- for block in section.blocks -%}
    {%- if block.type == 'heading' -%}
      <h2 class="{{ block.settings.heading_size }}" style="text-align: {{ block.settings.heading_alignment }}; color: {{ block.settings.heading_color }};" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
    {%- elsif block.type == 'text' -%}
      <div class="rte" style="text-align: {{ block.settings.text_alignment }}; color: {{ block.settings.text_color }};" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
    {%- endif -%}
  {%- endfor -%}

  <div class="pp-comparison-table" style="background: {{ section.settings.table_color }};">
    <div class="pp-comparison-row pp-comparison-row--head">
      <span></span>
      <span style="color: {{ section.settings.table_headline_color }};">Us</span>
      <span style="color: {{ section.settings.table_headline_color }};">{{ section.settings.table_headline_secondary }}</span>
    </div>
    {%- for block in section.blocks -%}
      {%- if block.type == 'tableitem' -%}
        <div class="pp-comparison-row" style="color: {{ section.settings.text_color }};" {{ block.shopify_attributes }}>
          <span>{{ block.settings.text }}</span>
          <span class="pp-comparison-mark" style="color: {{ block.settings.button_checkmark_color }};">&#10003;</span>
          <span class="pp-comparison-mark" style="color: {{ block.settings.button_x_color }};">&#10005;</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<style>
  .pp-comparison-section { text-align: center; }
  .pp-comparison-table { margin-top: 2rem; border-radius: 8px; overflow: hidden; }
  .pp-comparison-row { display: grid; grid-template-columns: 1fr auto auto; gap: 1.6rem; align-items: center; padding: 1.2rem 1.6rem; border-bottom: 1px solid rgba(255,255,255,0.1); text-align: left; }
  .pp-comparison-row--head { font-weight: 700; text-align: center; }
  .pp-comparison-row--head span:first-child { text-align: left; }
  .pp-comparison-mark { font-size: 1.8rem; text-align: center; min-width: 2.4rem; }
</style>

{% schema %}
{
  "name": "PP - Comparison Table",
  "settings": [
    { "type": "text", "id": "table_headline_secondary", "default": "Others", "label": "Secondary column label" },
    { "type": "color", "id": "table_headline_color", "label": "Column label color", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Row text color", "default": "#ffffff" },
    { "type": "color", "id": "table_color", "label": "Table background color", "default": "#000000" },
    { "type": "color_background", "id": "gradient", "label": "Background color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40, "label": "Bottom padding" },
    { "type": "range", "id": "margin_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Top margin" },
    { "type": "range", "id": "margin_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Bottom margin" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "default": "Why ours is better", "label": "Heading" },
        { "type": "select", "id": "heading_size", "options": [{"value":"h2","label":"Small"},{"value":"h1","label":"Medium"},{"value":"h0","label":"Large"}], "default": "h1", "label": "Heading size" },
        { "type": "select", "id": "heading_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left", "label": "Alignment" },
        { "type": "select", "id": "heading_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
        { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "default": "<p>Text</p>", "label": "Text" },
        { "type": "select", "id": "text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "subtitle", "label": "Text size" },
        { "type": "select", "id": "text_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Alignment" },
        { "type": "select", "id": "text_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" }
      ]
    },
    {
      "type": "tableitem",
      "name": "Table item",
      "settings": [
        { "type": "text", "id": "text", "default": "Feature", "label": "Text" },
        { "type": "select", "id": "checkmark", "options": [{"value":"us","label":"Us only"},{"value":"both","label":"Both"}], "default": "us", "label": "Checkmark" },
        { "type": "color", "id": "button_checkmark_color", "label": "Checkmark color", "default": "#23c55e" },
        { "type": "color", "id": "button_x_color", "label": "X color", "default": "#000000" }
      ]
    }
  ],
  "presets": [
    { "name": "PP - Comparison Table", "blocks": [{"type":"heading"},{"type":"text"},{"type":"tableitem"},{"type":"tableitem"},{"type":"tableitem"}] }
  ]
}
{% endschema %}
