{% comment %}
========================================================================
  DEWY — "Dry eye isn't a moisture problem" (Contrarian reframe)
  COMPLIANCE: no cure/medication-replacement claims. Warm compress framed
  as first-line (TFOS DEWS II, AOA, AAO), used alongside professional care.
========================================================================
{% endcomment %}

<style>
  .nm{ --ink:#182A2E; --paper:#FAF9F6; --mist:#E7F0F1; --dew:#4FA5AC; --dew-deep:#2E6E74;
    --amber:#E0A75C; --line:#D8E3E4; --shadow:0 20px 55px -28px rgba(24,42,46,.5);
    font-family:{{ section.settings.body_font.family }}, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color:var(--ink); background:var(--paper); line-height:1.75; -webkit-font-smoothing:antialiased; }
  .nm *{ box-sizing:border-box; }
  .nm__wrap{ max-width:1080px; margin:0 auto; padding:0 40px; }
  .nm__col{ max-width:900px; }
  .nm__masthead{ border-bottom:1px solid var(--line); padding:20px 0; margin-bottom:44px; display:flex; align-items:baseline; justify-content:space-between; }
  .nm__logo{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif; font-weight:600; font-size:24px; letter-spacing:.06em; color:var(--dew-deep); margin:0; }
  .nm__logo span{ color:var(--amber); }
  .nm__eyebrow{ font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:#8a978f; }
  .nm h1{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif; font-weight:600; font-size:clamp(30px,4.6vw,52px); line-height:1.1; letter-spacing:-.01em; margin:0 0 20px; max-width:15ch; }
  .nm h2{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif; font-weight:600; font-size:clamp(23px,3vw,33px); line-height:1.2; margin:52px 0 18px; }
  .nm__byline{ font-size:15px; color:var(--dew-deep); border-bottom:1px solid var(--line); padding-bottom:24px; margin-bottom:30px; }
  .nm__byline strong{ color:var(--ink); }
  .nm p{ margin:0 0 20px; font-size:19px; } .nm__lead{ font-size:22px; line-height:1.6; } .nm__rte p{ font-size:19px; }
  .nm__mythfact{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin:28px 0; }
  .nm__myth,.nm__fact{ border-radius:14px; padding:24px 26px; }
  .nm__myth{ background:#F3ECE4; border:1px solid #E6D8C6; }
  .nm__fact{ background:var(--mist); border:1px solid #CFE3E5; }
  .nm__tag{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; margin:0 0 10px; }
  .nm__myth .nm__tag{ color:#B07B3D; } .nm__fact .nm__tag{ color:var(--dew-deep); }
  .nm__myth p,.nm__fact p{ margin:0; font-size:17px; }
  .nm__pull{ background:var(--mist); border-left:4px solid var(--dew); padding:22px 28px; border-radius:4px; margin:30px 0; font-size:21px; color:var(--dew-deep); }
  .nm__figure{ margin:34px 0; } .nm__figure img{ width:100%; border-radius:14px; display:block; box-shadow:var(--shadow); }
  .nm__cap{ font-size:13px; color:#8a978f; margin-top:10px; }
  .nm__mech{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin:24px 0; }
  .nm__mech-item{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:22px 24px; }
  .nm__mech-item h3{ margin:0 0 8px; font-size:19px; font-weight:700; } .nm__mech-item p{ margin:0; font-size:16px; }
  .nm__evidence{ background:var(--ink); color:var(--paper); border-radius:16px; padding:36px 34px; margin:40px 0; }
  .nm__evidence h2{ color:#fff; margin:0 0 16px; } .nm__evidence p{ font-size:17px; color:#D6E5E6; }
  .nm__offer{ background:var(--mist); border-radius:18px; padding:40px 34px; text-align:center; margin:46px 0; }
  .nm__price{ font-size:21px; margin-bottom:8px; } .nm__price s{ color:#94a39e; margin-right:10px; } .nm__price b{ color:var(--dew-deep); font-size:34px; }
  .nm__cta{ display:inline-block; background:var(--dew-deep); color:#fff; font-size:19px; font-weight:600; text-decoration:none; padding:18px 46px; border-radius:999px; margin:18px 0 10px; transition:transform .12s, background .2s; }
  .nm__cta:hover{ background:var(--dew); transform:translateY(-1px); }
  .nm__reassure{ font-size:14px; color:var(--dew-deep); margin:8px 0 0; }
  .nm__reviews{ display:grid; grid-template-columns:1fr 1fr; gap:18px; margin:24px 0; }
  .nm__review{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:22px 24px; font-size:16px; }
  .nm__review .who{ margin-top:12px; font-weight:700; color:var(--dew-deep); font-size:14px; }
  .nm__stars{ color:var(--amber); letter-spacing:2px; }
  .nm__faq details{ border-bottom:1px solid var(--line); padding:18px 0; }
  .nm__faq summary{ font-weight:600; font-size:18px; cursor:pointer; list-style:none; display:flex; justify-content:space-between; align-items:center; }
  .nm__faq summary::after{ content:"+"; color:var(--dew); font-size:24px; } .nm__faq details[open] summary::after{ content:"\2013"; }
  .nm__faq p{ margin:14px 0 0; font-size:16px; }
  .nm__disc{ background:#F1EEE6; color:#6b6257; font-size:12.5px; line-height:1.65; padding:24px; border-radius:10px; margin:44px 0 12px; }
  .nm__foot{ text-align:center; font-size:12px; color:#8a978f; padding:22px 0 64px; }
  @media (max-width:760px){ .nm__wrap{ padding:0 22px; } .nm__mythfact,.nm__mech,.nm__reviews{ grid-template-columns:1fr; } .nm p,.nm__rte p{ font-size:18px; } .nm__lead{ font-size:20px; } .nm h1{ max-width:none; } }
</style>

<section class="nm">
  <div class="nm__wrap">
    <div class="nm__masthead"><p class="nm__logo">{{ section.settings.brand_name }}<span>.</span></p><span class="nm__eyebrow">{{ section.settings.eyebrow }}</span></div>
    <div class="nm__col">
      <h1>{{ section.settings.headline }}</h1>
      <div class="nm__byline">By <strong>{{ section.settings.author }}</strong> · {{ section.settings.byline_role }}</div>
      <p class="nm__lead">{{ section.settings.lead }}</p>
      <div class="nm__rte">{{ section.settings.intro_body }}</div>
      {% if section.settings.hero_image != blank %}<div class="nm__figure"><img src="{{ section.settings.hero_image | image_url: width:1400 }}" alt="{{ section.settings.brand_name }}" loading="lazy">{% if section.settings.hero_caption != blank %}<p class="nm__cap">{{ section.settings.hero_caption }}</p>{% endif %}</div>{% endif %}

      <h2>{{ section.settings.reveal_title }}</h2>
      <div class="nm__rte">{{ section.settings.reveal_intro }}</div>
      <div class="nm__mythfact">
        <div class="nm__myth"><p class="nm__tag">What everyone assumes</p><p>{{ section.settings.myth_text }}</p></div>
        <div class="nm__fact"><p class="nm__tag">What's actually true</p><p>{{ section.settings.fact_text }}</p></div>
      </div>
      <div class="nm__pull">{{ section.settings.pullquote }}</div>

      <h2>{{ section.settings.why_title }}</h2>
      <div class="nm__rte">{{ section.settings.why_body }}</div>

      <h2>{{ section.settings.mech_title }}</h2>
      <div class="nm__rte">{{ section.settings.mech_intro }}</div>
      <div class="nm__mech">
        <div class="nm__mech-item"><h3>{{ section.settings.mech1_title }}</h3><p>{{ section.settings.mech1_body }}</p></div>
        <div class="nm__mech-item"><h3>{{ section.settings.mech2_title }}</h3><p>{{ section.settings.mech2_body }}</p></div>
        <div class="nm__mech-item"><h3>{{ section.settings.mech3_title }}</h3><p>{{ section.settings.mech3_body }}</p></div>
        <div class="nm__mech-item"><h3>{{ section.settings.mech4_title }}</h3><p>{{ section.settings.mech4_body }}</p></div>
      </div>

      <div class="nm__evidence"><h2>{{ section.settings.evidence_title }}</h2><div>{{ section.settings.evidence_body }}</div></div>

      <div class="nm__offer"><p class="nm__price">{% if section.settings.compare_price != blank %}<s>{{ section.settings.compare_price }}</s>{% endif %}<b>{{ section.settings.price }}</b></p><a class="nm__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a><p class="nm__reassure">{{ section.settings.reassure }}</p></div>

      {% if section.settings.show_reviews %}<h2>{{ section.settings.reviews_title }}</h2><div class="nm__reviews">{% for block in section.blocks %}{% if block.type == 'review' %}<div class="nm__review" {{ block.shopify_attributes }}><div class="nm__stars">★★★★★</div><div>{{ block.settings.text }}</div><div class="who">— {{ block.settings.name }}</div></div>{% endif %}{% endfor %}</div>{% endif %}

      <h2>{{ section.settings.faq_title }}</h2>
      <div class="nm__faq">{% for block in section.blocks %}{% if block.type == 'faq' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><p>{{ block.settings.a }}</p></details>{% endif %}{% endfor %}</div>

      <div class="nm__offer"><p class="nm__price">{% if section.settings.compare_price != blank %}<s>{{ section.settings.compare_price }}</s>{% endif %}<b>{{ section.settings.price }}</b></p><a class="nm__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a><p class="nm__reassure">{{ section.settings.reassure }}</p></div>
      <div class="nm__disc">{{ section.settings.disclaimer }}</div>
      <div class="nm__foot">© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name }}. {{ section.settings.footer_note }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dewy — Not Moisture",
  "settings": [
    { "type": "header", "content": "Fonts" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n6" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" },
    { "type": "header", "content": "Masthead" },
    { "type": "text", "id": "brand_name", "label": "Brand", "default": "Dewy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Eye comfort, explained honestly" },
    { "type": "header", "content": "Headline & intro" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Dry eye isn't a moisture problem" },
    { "type": "text", "id": "author", "label": "Author", "default": "Thomas Cage" },
    { "type": "text", "id": "byline_role", "label": "Byline role", "default": "founder of Dewy" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "It sounds like it should be. The name says 'dry,' so you add moisture — drops, gels, more drops. And for an hour, it helps. Then you're gritty again. Here's the part almost nobody explains: for most people, dryness isn't the actual problem. Evaporation is." },
    { "type": "richtext", "id": "intro_body", "label": "Intro body", "default": "<p>Once you understand the difference, every drop that ever let you down suddenly makes sense — and so does what to do instead.</p>" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_caption", "label": "Caption" },
    { "type": "header", "content": "The reveal (myth vs fact)" },
    { "type": "text", "id": "reveal_title", "label": "Title", "default": "The assumption that keeps you stuck" },
    { "type": "richtext", "id": "reveal_intro", "label": "Intro", "default": "<p>The whole category is built on one idea — that dry eye means not enough moisture. For the most common type of dry eye, that idea is simply wrong:</p>" },
    { "type": "textarea", "id": "myth_text", "label": "Myth text", "default": "Dry eye means your eyes don't make enough tears — so the fix is to add more moisture with drops." },
    { "type": "textarea", "id": "fact_text", "label": "Fact text", "default": "For most people the tears are there — they're just evaporating too fast, because the thin oil layer that's meant to seal them in has broken down. The problem isn't too little water. It's a missing lid on the jar." },
    { "type": "textarea", "id": "pullquote", "label": "Pull quote", "default": "Meibomian gland dysfunction — an oil-layer problem — is the leading cause of dry eye. Adding water to an evaporation problem is why the drops keep wearing off." },
    { "type": "header", "content": "Why it happens" },
    { "type": "text", "id": "why_title", "label": "Title", "default": "Why the oil layer breaks down" },
    { "type": "richtext", "id": "why_body", "label": "Body", "default": "<p>Tiny glands along your eyelid rims produce the oily top layer of your tears. With age they slow and clog, and hormonal shifts around perimenopause speed it up. Less oil reaches the surface, tears evaporate faster than they're replaced, and your eyes feel dry — even though the watery layer the drops top up was never really the issue.</p>" },
    { "type": "header", "content": "Mechanism" },
    { "type": "text", "id": "mech_title", "label": "Title", "default": "So what actually helps" },
    { "type": "richtext", "id": "mech_intro", "label": "Intro", "default": "<p>You don't fix an oil problem with water. You warm the oil so it flows again — which is exactly what Dewy is built to do.</p>" },
    { "type": "text", "id": "mech1_title", "label": "P1", "default": "Warmth where it counts" },
    { "type": "textarea", "id": "mech1_body", "label": "P1 body", "default": "Research indicates the eyelid needs to reach around 40°C to soften the thickened oils in the glands. Dewy holds gentle, even warmth across the whole lid — not a flannel that's scalding then cold in 90 seconds." },
    { "type": "text", "id": "mech2_title", "label": "P2", "default": "A routine you'll keep" },
    { "type": "textarea", "id": "mech2_body", "label": "P2 body", "default": "Warm compresses fail people because a hot towel is a nuisance. Dewy is a 10-minute ritual you'll actually repeat — consistency is the whole game." },
    { "type": "text", "id": "mech3_title", "label": "P3", "default": "Soft, reusable, calming" },
    { "type": "textarea", "id": "mech3_body", "label": "P3 body", "default": "Comfortable enough to become the nice part of your evening rather than a chore. Comfort is what makes it a habit." },
    { "type": "text", "id": "mech4_title", "label": "P4", "default": "Use it with your drops" },
    { "type": "textarea", "id": "mech4_body", "label": "P4 body", "default": "Drops still have a place for the water layer. Dewy addresses the oil layer they can't reach — the two do different jobs, and many people use both." },
    { "type": "header", "content": "Evidence (keep wording)" },
    { "type": "text", "id": "evidence_title", "label": "Title", "default": "What the eye specialists say" },
    { "type": "richtext", "id": "evidence_body", "label": "Body", "default": "<p>We won't tell you Dewy is a cure or a replacement for anything your optometrist has given you — it isn't, and anyone who says that about a warm mask is being dishonest with you.</p><p>What's true: warm-compress and lid-warming therapy is recognised as a <strong>first-line</strong> approach for evaporative dry eye and meibomian gland dysfunction in the international TFOS DEWS II consensus, and recommended by major eye-care bodies including the American Optometric Association and American Academy of Ophthalmology. It's one of the simplest, best-evidenced first steps you can take at home — often used alongside professional care.</p>" },
    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "price", "label": "Price", "default": "$39" },
    { "type": "text", "id": "compare_price", "label": "Compare-at (genuine only)" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Try Dewy — 60-night comfort guarantee" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "reassure", "label": "Reassurance", "default": "Free shipping · 60-night money-back guarantee · No subscription" },
    { "type": "header", "content": "Reviews" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews", "default": true },
    { "type": "text", "id": "reviews_title", "label": "Reviews title", "default": "What customers tell us" },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_title", "label": "FAQ title", "default": "Honest answers" },
    { "type": "header", "content": "Legal" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Dewy is a comfort product. It is not a medicine and is not intended to diagnose, treat, cure, or prevent any disease. This page is general educational information, not medical advice, and does not replace guidance from a qualified eye-care professional. If you have persistent, painful, or worsening symptoms, or any sudden change in vision, see an optometrist or doctor. Statements about warm-compress therapy describe the general approach as set out in published eye-care guidance, not results guaranteed from this product. Individual results vary." },
    { "type": "text", "id": "footer_note", "label": "Footer", "default": "All rights reserved." }
  ],
  "blocks": [
    { "type": "review", "name": "Review (REAL only)", "settings": [
      { "type": "textarea", "id": "text", "label": "Review", "default": "[Replace with a real, consented customer review before publishing. Do not invent reviews.]" },
      { "type": "text", "id": "name", "label": "Name", "default": "Customer name" } ] },
    { "type": "faq", "name": "FAQ", "settings": [
      { "type": "text", "id": "q", "label": "Q", "default": "So drops are useless?" },
      { "type": "textarea", "id": "a", "label": "A", "default": "Not at all — drops help the water layer and have their place. The point is that for many people the oil layer is the missing piece, which is what a warm compress addresses. Many people use both." } ] }
  ],
  "presets": [ { "name": "Dewy — Not Moisture", "blocks": [ {"type":"review"},{"type":"review"},{"type":"review"},{"type":"faq"},{"type":"faq"},{"type":"faq"} ] } ]
}
{% endschema %}
