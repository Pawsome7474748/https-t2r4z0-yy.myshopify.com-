{% comment %}
  DEWY — Photo review grid ("Real Success Stories" style)
  Photos + names must be real, consented customer submissions — no invented people.
{% endcomment %}

<style>
  .pr-section {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: 4.8rem 2.4rem;
  }
  .pr-wrap { max-width: 1400px; margin: 0 auto; }
  .pr-badge {
    display: flex;
    justify-content: center;
    margin-bottom: 1.6rem;
  }
  .pr-badge__inner {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background: {{ section.settings.card_color }};
    border: 1px solid rgba(94, 234, 212, 0.2);
    border-radius: 999px;
    padding: 0.8rem 1.8rem;
    font-size: 1.5rem;
    font-weight: 600;
  }
  .pr-badge__stars { color: #facc15; letter-spacing: 0.1em; }
  .pr-heading {
    text-align: center;
    font-size: clamp(3.2rem, 3.6vw, 4.4rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 1.2rem;
    color: #ffffff;
  }
  .pr-heading em { color: {{ section.settings.accent_color }}; font-style: normal; }
  .pr-subheading {
    text-align: center;
    font-size: 1.8rem;
    opacity: 0.8;
    margin: 0 0 4rem;
  }
  .pr-track {
    display: flex;
    gap: 1.8rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1.2rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .pr-track::-webkit-scrollbar { display: none; }
  .pr-card {
    flex: 0 0 280px;
    scroll-snap-align: start;
    background: {{ section.settings.card_color }};
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(94, 234, 212, 0.12);
    display: flex;
    flex-direction: column;
  }
  .pr-card__photo { position: relative; aspect-ratio: 4 / 5; }
  .pr-card__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pr-card__overlay {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    background: linear-gradient(0deg, rgba(13,33,30,0.92) 0%, rgba(13,33,30,0.55) 65%, rgba(13,33,30,0) 100%);
    padding: 3.2rem 1.6rem 1.2rem;
  }
  .pr-card__stars { color: #facc15; font-size: 1.4rem; letter-spacing: 0.08em; margin-bottom: 0.4rem; }
  .pr-card__name { font-weight: 700; font-size: 1.5rem; display: flex; align-items: center; gap: 0.6rem; }
  .pr-card__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 1.15rem;
    font-weight: 500;
    color: {{ section.settings.accent_color }};
    opacity: 0.9;
  }
  .pr-card__body { padding: 1.8rem 1.6rem; flex: 1; display: flex; flex-direction: column; }
  .pr-card__quote { font-size: 1.5rem; line-height: 1.55; margin: 0 0 1.8rem; opacity: 0.92; flex: 1; }
  .pr-card__product {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid rgba(94, 234, 212, 0.15);
    padding-top: 1.4rem;
  }
  .pr-card__product img {
    width: 40px; height: 40px; border-radius: 8px; object-fit: cover; flex-shrink: 0;
    background: rgba(94, 234, 212, 0.08);
  }
  .pr-card__product-name { font-size: 1.3rem; font-weight: 600; margin: 0; }
  .pr-card__product-price { font-size: 1.3rem; color: {{ section.settings.accent_color }}; margin: 0; }
  .pr-nav { display: flex; justify-content: center; gap: 1.2rem; margin-top: 2.4rem; }
  .pr-nav button {
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(94, 234, 212, 0.25);
    background: {{ section.settings.card_color }};
    color: {{ section.settings.text_color }};
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 150ms ease;
  }
  .pr-nav button:hover { background: rgba(94, 234, 212, 0.15); }
  @media screen and (max-width: 600px) {
    .pr-card { flex: 0 0 240px; }
  }
</style>

<section class="pr-section">
  <div class="pr-wrap">
    {%- liquid
      assign review_blocks = section.blocks | where: 'type', 'photo_review'
      assign rating_total = 0
      for block in review_blocks
        assign rating_total = rating_total | plus: block.settings.rating
      endfor
      if review_blocks.size > 0
        assign rating_avg = rating_total | times: 1.0 | divided_by: review_blocks.size | round: 1
      endif
    -%}
    {%- if review_blocks.size > 0 -%}
      <div class="pr-badge">
        <span class="pr-badge__inner">
          <span class="pr-badge__stars">★★★★★</span>
          Rated {{ rating_avg }}/5 based on {{ review_blocks.size }} verified review{% if review_blocks.size != 1 %}s{% endif %}
        </span>
      </div>
    {%- endif -%}

    <h2 class="pr-heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="pr-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="pr-track" data-pr-track>
      {%- for block in review_blocks -%}
        <div class="pr-card" {{ block.shopify_attributes }}>
          <div class="pr-card__photo">
            {%- if block.settings.photo != blank -%}
              <img src="{{ block.settings.photo | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
            {%- endif -%}
            <div class="pr-card__overlay">
              {%- if block.settings.name != blank -%}
                <div class="pr-card__stars" aria-hidden="true">
                  {%- assign r_floor = block.settings.rating | floor -%}
                  {%- for i in (1..5) -%}{%- if i <= r_floor -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
                </div>
                <div class="pr-card__name">
                  {{ block.settings.name }}
                  <span class="pr-card__verified">✓ Verified Buyer</span>
                </div>
              {%- else -%}
                <div class="pr-card__name">
                  <span class="pr-card__verified">✓ Verified Buyer</span>
                </div>
              {%- endif -%}
            </div>
          </div>
          <div class="pr-card__body">
            {%- if block.settings.quote != blank -%}<p class="pr-card__quote">"{{ block.settings.quote }}"</p>{%- else -%}<div class="pr-card__quote"></div>{%- endif -%}
            <div class="pr-card__product">
              {%- if product.featured_image != blank -%}
                <img src="{{ product.featured_image | image_url: width: 80 }}" alt="{{ product.title | escape }}">
              {%- endif -%}
              <div>
                <p class="pr-card__product-name">{{ product.title | truncate: 28 }}</p>
                <p class="pr-card__product-price">{{ product.price | money }}</p>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="pr-nav">
      <button type="button" data-pr-prev aria-label="Previous reviews">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" data-pr-next aria-label="Next reviews">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.currentScript.closest('.pr-section');
    if (!section) return;
    var track = section.querySelector('[data-pr-track]');
    var prev = section.querySelector('[data-pr-prev]');
    var next = section.querySelector('[data-pr-next]');
    if (!track) return;
    function scrollByCard(dir) {
      var card = track.querySelector('.pr-card');
      var amount = card ? card.getBoundingClientRect().width + 18 : 300;
      track.scrollBy({ left: dir * amount, behavior: 'smooth' });
    }
    if (prev) prev.addEventListener('click', function () { scrollByCard(-1); });
    if (next) next.addEventListener('click', function () { scrollByCard(1); });
  })();
</script>

{% schema %}
{
  "name": "Dewy — Photo reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Stories From Real Customers" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#0d211e" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#eaf6f3" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#5eead4" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#123a34" }
  ],
  "blocks": [
    {
      "type": "photo_review",
      "name": "Photo review (REAL customers only)",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Customer photo" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer name" },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review quote", "default": "Review text goes here." }
      ]
    }
  ],
  "presets": [
    { "name": "Dewy — Photo reviews", "blocks": [ {"type":"photo_review"},{"type":"photo_review"},{"type":"photo_review"} ] }
  ]
}
{% endschema %}
