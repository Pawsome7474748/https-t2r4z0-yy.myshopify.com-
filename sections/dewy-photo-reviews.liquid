{% comment %}
  DEWY — Photo review grid ("Real Success Stories" style)
  Photos + names must be real, consented customer submissions — no invented people.
{% endcomment %}

<style>
  .pr-section {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: 6.4rem 2.4rem;
  }
  .pr-wrap { max-width: 1400px; margin: 0 auto; }
  .pr-badge {
    display: flex;
    justify-content: center;
    margin-bottom: 2.4rem;
  }
  .pr-badge__inner {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background: {{ section.settings.card_color }};
    border-radius: 999px;
    padding: 0.9rem 2rem;
    font-size: 1.5rem;
    font-weight: 600;
  }
  .pr-badge__stars { color: #facc15; letter-spacing: 0.1em; }
  .pr-heading {
    text-align: center;
    font-size: clamp(3.2rem, 3.6vw, 4.6rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 1.4rem;
    color: #ffffff;
  }
  .pr-heading span { color: {{ section.settings.accent_color }}; }
  .pr-subheading {
    text-align: center;
    font-size: 1.8rem;
    opacity: 0.75;
    margin: 0 0 5.6rem;
  }
  .pr-track {
    display: flex;
    gap: 2.4rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1.2rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .pr-track::-webkit-scrollbar { display: none; }
  .pr-card {
    flex: 0 0 300px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }
  .pr-card__photo {
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    background: {{ section.settings.card_color }};
    margin-bottom: 1.6rem;
  }
  .pr-card__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pr-card__stars { color: #facc15; font-size: 1.4rem; letter-spacing: 0.08em; margin-bottom: 0.8rem; }
  .pr-star { position: relative; display: inline-block; color: rgba(250, 204, 21, 0.3); }
  .pr-star::before { content: "★"; position: absolute; left: 0; top: 0; width: var(--pr-star-fill, 0%); overflow: hidden; color: #facc15; }
  .pr-card__meta { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1.4rem; flex-wrap: wrap; }
  .pr-card__name { font-weight: 700; font-size: 1.6rem; }
  .pr-card__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 1.2rem;
    font-weight: 500;
    color: {{ section.settings.accent_color }};
    opacity: 0.9;
  }
  .pr-card__quote { font-size: 1.55rem; line-height: 1.6; margin: 0 0 2rem; opacity: 0.9; flex: 1; }
  .pr-card__product {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: {{ section.settings.card_color }};
    border-radius: 12px;
    padding: 0.9rem 1.2rem;
    text-decoration: none;
    color: inherit;
  }
  .pr-card__product img {
    width: 36px; height: 36px; border-radius: 7px; object-fit: cover; flex-shrink: 0;
    background: rgba(94, 234, 212, 0.08);
  }
  .pr-card__product-name { font-size: 1.25rem; font-weight: 600; margin: 0; }
  .pr-card__product-price { font-size: 1.25rem; color: {{ section.settings.accent_color }}; margin: 0; }
  .pr-nav { display: flex; justify-content: center; gap: 1.2rem; margin-top: 3.2rem; }
  .pr-nav button {
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(94, 234, 212, 0.25);
    background: {{ section.settings.card_color }};
    color: {{ section.settings.text_color }};
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 150ms ease;
  }
  .pr-nav button:hover { background: rgba(94, 234, 212, 0.15); }
  @media screen and (max-width: 600px) {
    .pr-card { flex: 0 0 250px; }
  }
</style>

<section class="pr-section">
  <div class="pr-wrap">
    {%- liquid
      assign review_blocks = section.blocks | where: 'type', 'photo_review'
      assign rated_blocks = review_blocks | where: 'settings.name', blank
      assign rating_total = 0
      assign rating_count = 0
      for block in review_blocks
        if block.settings.name != blank
          assign rating_total = rating_total | plus: block.settings.rating
          assign rating_count = rating_count | plus: 1
        endif
      endfor
      if rating_count > 0
        assign rating_avg = rating_total | times: 1.0 | divided_by: rating_count | round: 1
      endif
    -%}
    {%- if rating_count > 0 -%}
      <div class="pr-badge">
        <span class="pr-badge__inner">
          <span class="pr-badge__stars">★★★★★</span>
          Rated {{ rating_avg }}/5 based on {{ rating_count }}+ Verified Review{% if rating_count != 1 %}s{% endif %}
        </span>
      </div>
    {%- endif -%}

    <h2 class="pr-heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="pr-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="pr-track" data-pr-track>
      {%- for block in review_blocks -%}
        <div class="pr-card" {{ block.shopify_attributes }}>
          <div class="pr-card__photo">
            {%- if block.settings.photo != blank -%}
              <img src="{{ block.settings.photo | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
            {%- endif -%}
          </div>
          {%- if block.settings.name != blank -%}
            <div class="pr-card__stars" aria-hidden="true">
              {%- assign r_floor = block.settings.rating | floor -%}
              {%- assign r_frac = block.settings.rating | minus: r_floor -%}
              {%- assign r_next = r_floor | plus: 1 -%}
              {%- for i in (1..5) -%}
                {%- if i <= r_floor -%}
                  <span class="pr-star" style="--pr-star-fill: 100%">★</span>
                {%- elsif i == r_next and r_frac >= 0.25 -%}
                  <span class="pr-star" style="--pr-star-fill: 50%">★</span>
                {%- else -%}
                  <span class="pr-star" style="--pr-star-fill: 0%">★</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="pr-card__meta">
              <span class="pr-card__name">{{ block.settings.name }}</span>
              <span class="pr-card__verified">✓ Verified Buyer</span>
            </div>
          {%- else -%}
            <div class="pr-card__meta">
              <span class="pr-card__verified">✓ Verified Buyer</span>
            </div>
          {%- endif -%}
          {%- if block.settings.quote != blank -%}<p class="pr-card__quote">"{{ block.settings.quote }}"</p>{%- endif -%}
          {%- assign card_product = block.settings.product | default: product -%}
          {%- if card_product != blank -%}
            <a href="{{ card_product.url }}" class="pr-card__product">
              {%- if card_product.featured_image != blank -%}
                <img src="{{ card_product.featured_image | image_url: width: 80 }}" alt="{{ card_product.title | escape }}">
              {%- endif -%}
              <div>
                <p class="pr-card__product-name">{{ card_product.title | truncate: 28 }}</p>
                <p class="pr-card__product-price">{{ card_product.price | money }}</p>
              </div>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="pr-nav">
      <button type="button" data-pr-prev aria-label="Previous reviews">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" data-pr-next aria-label="Next reviews">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <script>
      (function () {
        var section = document.currentScript.closest('.pr-section');
        if (!section) return;
        var track = section.querySelector('[data-pr-track]');
        var prev = section.querySelector('[data-pr-prev]');
        var next = section.querySelector('[data-pr-next]');
        if (!track) return;
        function scrollByCard(dir) {
          var card = track.querySelector('.pr-card');
          var amount = card ? card.getBoundingClientRect().width + 24 : 320;
          track.scrollBy({ left: dir * amount, behavior: 'smooth' });
        }
        if (prev) prev.addEventListener('click', function () { scrollByCard(-1); });
        if (next) next.addEventListener('click', function () { scrollByCard(1); });
      })();
    </script>
  </div>
</section>

{% schema %}
{
  "name": "Dewy — Photo reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Stories From Real Customers" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#0d211e" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#eaf6f3" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#5eead4" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#123a34" }
  ],
  "blocks": [
    {
      "type": "photo_review",
      "name": "Photo review (REAL only)",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Customer photo" },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 0.5, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review quote" },
        { "type": "product", "id": "product", "label": "Product", "info": "Leave blank on product pages to use the current product automatically. Required on non-product pages like the homepage." }
      ]
    }
  ],
  "presets": [
    { "name": "Dewy — Photo reviews", "blocks": [ {"type":"photo_review"},{"type":"photo_review"},{"type":"photo_review"} ] }
  ]
}
{% endschema %}
