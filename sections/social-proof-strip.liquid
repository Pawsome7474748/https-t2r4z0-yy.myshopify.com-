<div class="social-proof-strip color-{{ section.settings.color_scheme }}">
  <div class="social-proof-strip__inner page-width">
    <div class="social-proof-strip__orders">
      <span class="social-proof-strip__avatars" aria-hidden="true">
        {%- assign initials = "CG,GT,AB,LT,MM" | split: "," -%}
        {%- for initial in initials -%}
          <span class="social-proof-strip__avatar">{{ initial }}</span>
        {%- endfor -%}
      </span>
      <span class="social-proof-strip__text">{{ section.settings.orders_text }}</span>
    </div>
    <div class="social-proof-strip__divider" aria-hidden="true"></div>
    <div class="social-proof-strip__rating">
      <span class="social-proof-strip__stars" aria-hidden="true">
        {%- for i in (1..5) -%}
          <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.6 6 .7-4.5 4.1 1.2 6-5.3-3-5.3 3 1.2-6-4.5-4.1 6-.7L10 1.5z"/></svg>
        {%- endfor -%}
      </span>
      <span class="social-proof-strip__text">({{ section.settings.review_count }} Verified Reviews)</span>
    </div>
  </div>
</div>

<style>
  .social-proof-strip {
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .social-proof-strip__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    font-size: 1.3rem;
  }
  .social-proof-strip__orders,
  .social-proof-strip__rating {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .social-proof-strip__avatars {
    display: inline-flex;
  }
  .social-proof-strip__avatar {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--gradient-button, #16213E);
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid rgb(var(--color-background));
    margin-left: -0.8rem;
  }
  .social-proof-strip__avatar:first-child {
    margin-left: 0;
  }
  .social-proof-strip__text {
    font-weight: 600;
  }
  .social-proof-strip__divider {
    width: 1px;
    height: 1.6rem;
    background: currentColor;
    opacity: 0.2;
  }
  .social-proof-strip__stars {
    display: inline-flex;
    gap: 0.1rem;
    color: #facc15;
  }
  .social-proof-strip__stars svg {
    width: 1.4rem;
    height: 1.4rem;
  }
  @media screen and (max-width: 749px) {
    .social-proof-strip__inner {
      font-size: 1.1rem;
      gap: 1rem;
    }
    .social-proof-strip__divider {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Social proof strip",
  "class": "section-social-proof-strip",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "orders_text",
      "label": "Orders text",
      "default": "100+ orders in the last 24h"
    },
    {
      "type": "range",
      "id": "rating_value",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "label": "Rating value",
      "default": 4.5
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Review count",
      "default": 5
    }
  ]
}
{% endschema %}
