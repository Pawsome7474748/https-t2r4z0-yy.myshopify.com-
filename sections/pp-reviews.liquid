{%- assign grad = '' -%}
{%- if section.settings.gradient != blank -%}
  {%- assign grad = 'background:' | append: section.settings.gradient | append: ';' -%}
{%- endif -%}

<div
  id="sh-reviews"
  class="pp-section shr"
  style="{{ grad }} padding-top:{{ section.settings.padding_top }}px; padding-bottom:{{ section.settings.padding_bottom }}px; margin-top:{{ section.settings.margin_top }}px; margin-bottom:{{ section.settings.margin_bottom }}px;"
>
  <div class="page-width">
    <div class="shr__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="shr__eyebrow" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="{{ section.settings.heading_size }} shr__title" style="color:{{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
      <p class="shr__summary" style="color:{{ section.settings.text_color }};">
        <span class="shr__stars" style="color:{{ section.settings.heading_stars_color }};">★★★★★</span>
        <strong>{{ section.settings.rating_value }}</strong> out of 5 ·
        {{ section.blocks.size }} verified review{% if section.blocks.size != 1 %}s{% endif %}
      </p>
    </div>

    <div class="shr__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="shr__card" style="background:{{ block.settings.review_background_color }};" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="shr__media">
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.author_text }}
              </div>
            {%- endif -%}

            <div class="shr__body">
              <div class="shr__stars shr__stars--sm" style="color:{{ block.settings.stars_color }};">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.stars_number -%}★{%- else -%}<span class="shr__star-off">★</span>{%- endif -%}
                {%- endfor -%}
              </div>

              <p class="shr__who" style="color:{{ block.settings.author_color }};">
                <strong>{{ block.settings.author_text }}</strong>
                {%- if block.settings.author_badge_text != blank -%}
                  <span class="shr__badge" style="color:{{ section.settings.verified_color }};">
                    ✓ {{ block.settings.author_badge_text }}
                  </span>
                {%- endif -%}
              </p>

              <div class="shr__text" style="color:{{ block.settings.review_text_color }};">
                <div class="shr__clamp">{{ block.settings.review_text }}</div>
                <button type="button" class="shr__more" style="color:{{ section.settings.verified_color }};">Read more</button>
              </div>
            </div>

            <a href="{{ product.url | default: routes.root_url }}" class="shr__chip">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}
              {%- endif -%}
              <span class="shr__chip-txt">
                <span class="shr__chip-name">{{ product.title | default: 'Shirt Happens Tee' }}</span>
                <span class="shr__chip-price">{{ product.price | money }}</span>
              </span>
            </a>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .shr__head{text-align:center;margin-bottom:3rem}
  .shr__eyebrow{font-size:1.15rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin:0 0 .6rem}
  .shr__title{margin:0 0 .8rem}
  .shr__summary{font-size:1.35rem;margin:0;display:flex;align-items:center;justify-content:center;gap:.6rem;flex-wrap:wrap}
  .shr__stars{letter-spacing:.12em;font-size:1.6rem;line-height:1}
  .shr__stars--sm{font-size:1.35rem;letter-spacing:.08em;margin-bottom:.7rem}
  .shr__star-off{opacity:.28}

  .shr__grid{display:grid;grid-template-columns:1fr;gap:1.8rem}
  @media screen and (min-width:600px){.shr__grid{grid-template-columns:repeat(2,1fr)}}
  @media screen and (min-width:1100px){.shr__grid{grid-template-columns:repeat(4,1fr)}}

  .shr__card{display:flex;flex-direction:column;border-radius:14px;overflow:hidden;
    box-shadow:0 2px 14px rgba(10,49,97,.10)}
  .shr__media{aspect-ratio:1/1;overflow:hidden;background:rgba(0,0,0,.04)}
  .shr__media img{width:100%;height:100%;object-fit:cover;display:block}
  .shr__body{padding:1.4rem 1.4rem .6rem}
  .shr__who{margin:0 0 .8rem;font-size:1.3rem;display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}
  .shr__badge{font-size:1.1rem;font-weight:700;white-space:nowrap}

  .shr__text{font-size:1.25rem;line-height:1.55}
  .shr__clamp{position:relative;max-height:12.5em;overflow:hidden;
    -webkit-mask-image:linear-gradient(180deg,#000 72%,transparent 100%);
    mask-image:linear-gradient(180deg,#000 72%,transparent 100%)}
  .shr__clamp p{margin:0 0 .7em}
  .shr__clamp.is-open{max-height:none;-webkit-mask-image:none;mask-image:none}
  .shr__more{background:none;border:0;padding:.4rem 0 0;font:inherit;font-size:1.2rem;font-weight:700;
    text-decoration:underline;text-underline-offset:2px;cursor:pointer}

  .shr__chip{display:flex;align-items:center;gap:.9rem;margin:1rem 1.4rem 1.4rem;padding:.7rem .9rem;
    border:1px solid rgba(10,49,97,.15);border-radius:10px;text-decoration:none;background:rgba(255,255,255,.6)}
  .shr__chip img{width:3.4rem;height:3.4rem;object-fit:cover;border-radius:6px;flex:0 0 auto}
  .shr__chip-txt{display:flex;flex-direction:column;min-width:0}
  .shr__chip-name{font-size:1.15rem;font-weight:700;color:#0A3161;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .shr__chip-price{font-size:1.15rem;color:#B31942;font-weight:700}
</style>

<script>
  document.querySelectorAll('.shr__more').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var box = btn.previousElementSibling;
      var open = box.classList.toggle('is-open');
      btn.textContent = open ? 'Show less' : 'Read more';
    });
  });
</script>

{% schema %}
{
  "name": "PP - Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "default": "REAL CUSTOMERS", "label": "Eyebrow" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#B31942" },
    { "type": "inline_richtext", "id": "heading", "default": "In Their Words", "label": "Heading" },
    { "type": "select", "id": "heading_size", "options": [{"value":"h2","label":"Small"},{"value":"h1","label":"Medium"},{"value":"h0","label":"Large"}], "default": "h1", "label": "Heading size" },
    { "type": "select", "id": "heading_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Alignment" },
    { "type": "select", "id": "heading_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#0A3161" },
    { "type": "color", "id": "text_color", "label": "Summary text color", "default": "#0A3161" },
    { "type": "color", "id": "verified_color", "label": "Accent / verified color", "default": "#B31942" },
    { "type": "text", "id": "rating_value", "default": "4.6", "label": "Rating value" },
    { "type": "color", "id": "heading_stars_color", "label": "Star color", "default": "#FFC72C" },
    { "type": "select", "id": "heading_stars_size", "options": [{"value":"sm","label":"Small"},{"value":"lg","label":"Large"}], "default": "lg", "label": "Star size" },
    { "type": "select", "id": "stars_alignment", "options": [{"value":"start","label":"Left"},{"value":"center","label":"Center"}], "default": "center", "label": "Star alignment" },
    { "type": "select", "id": "stars_mobilealignment", "options": [{"value":"start","label":"Left"},{"value":"center","label":"Center"}], "default": "center", "label": "Star mobile alignment" },
    { "type": "range", "id": "heading_stars_number", "min": 1, "max": 5, "step": 1, "default": 5, "label": "Stars shown" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "subtitle", "label": "Text size" },
    { "type": "select", "id": "text_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Text alignment" },
    { "type": "select", "id": "text_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Text mobile alignment" },
    { "type": "color_background", "id": "gradient", "label": "Background color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 52, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 52, "label": "Bottom padding" },
    { "type": "range", "id": "margin_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Top margin" },
    { "type": "range", "id": "margin_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Bottom margin" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer photo" },
        { "type": "select", "id": "image_border_radius", "options": [{"value":"none","label":"None"},{"value":"low","label":"Low"},{"value":"medium","label":"Medium"}], "default": "low", "label": "Image corners" },
        { "type": "text", "id": "author_text", "default": "Customer", "label": "Name" },
        { "type": "select", "id": "author_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "subtitle", "label": "Name size" },
        { "type": "color", "id": "author_color", "label": "Name color", "default": "#0A3161" },
        { "type": "text", "id": "author_badge_text", "default": "Verified Buyer", "label": "Badge text" },
        { "type": "select", "id": "author_badge_text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "body", "label": "Badge size" },
        { "type": "color", "id": "author_badge_text_color", "label": "Badge text color", "default": "#B31942" },
        { "type": "color", "id": "author_badge_color", "label": "Badge background", "default": "#0A3161" },
        { "type": "select", "id": "stars_size", "options": [{"value":"sm","label":"Small"},{"value":"lg","label":"Large"}], "default": "sm", "label": "Star size" },
        { "type": "color", "id": "stars_color", "label": "Star color", "default": "#FFC72C" },
        { "type": "range", "id": "stars_number", "min": 1, "max": 5, "step": 1, "default": 5, "label": "Stars" },
        { "type": "select", "id": "stars_alignment", "options": [{"value":"start","label":"Left"},{"value":"center","label":"Center"}], "default": "start", "label": "Star alignment" },
        { "type": "select", "id": "stars_mobilealignment", "options": [{"value":"start","label":"Left"},{"value":"center","label":"Center"}], "default": "start", "label": "Star mobile alignment" },
        { "type": "richtext", "id": "review_text", "default": "<p>Great product.</p>", "label": "Review text" },
        { "type": "select", "id": "review_text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "body", "label": "Review size" },
        { "type": "color", "id": "review_text_color", "label": "Review text color", "default": "#0A3161" },
        { "type": "color", "id": "review_background_color", "label": "Card background", "default": "#ffffff" },
        { "type": "select", "id": "review_border_radius", "options": [{"value":"none","label":"None"},{"value":"low","label":"Low"},{"value":"medium","label":"Medium"}], "default": "low", "label": "Card corners" }
      ]
    }
  ],
  "presets": [
    { "name": "PP - Reviews", "blocks": [{"type":"review"},{"type":"review"},{"type":"review"},{"type":"review"}] }
  ]
}
{% endschema %}
