{% assign gradient_style = '' %}
{% if section.settings.gradient != blank %}
  {% assign gradient_style = 'background: ' | append: section.settings.gradient | append: ';' %}
{% endif %}

<div class="pp-section pp-reviews-section page-width" style="{{ gradient_style }} padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px;">
  <div class="pp-reviews-header" style="text-align: {{ section.settings.heading_alignment }};">
    <div class="pp-reviews-stars" style="color: {{ section.settings.heading_stars_color }};" aria-hidden="true">
      {%- for i in (1..section.settings.heading_stars_number) -%}
        <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20"><path d="M10 1.5l2.6 5.6 6 .7-4.5 4.1 1.2 6-5.3-3-5.3 3 1.2-6-4.5-4.1 6-.7L10 1.5z"/></svg>
      {%- endfor -%}
    </div>
    {%- if section.settings.heading != blank -%}
      <h2 class="{{ section.settings.heading_size }}" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte" style="color: {{ section.settings.text_color }};">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  <div class="pp-reviews-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'review' -%}
        <div class="pp-review-card" style="background: {{ block.settings.review_background_color }};" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="pp-review-image">
              {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}
            </div>
          {%- endif -%}
          <div class="pp-review-stars" style="color: {{ block.settings.stars_color }};" aria-hidden="true">
            {%- for i in (1..block.settings.stars_number) -%}
              <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path d="M10 1.5l2.6 5.6 6 .7-4.5 4.1 1.2 6-5.3-3-5.3 3 1.2-6-4.5-4.1 6-.7L10 1.5z"/></svg>
            {%- endfor -%}
          </div>
          <p class="pp-review-text" style="color: {{ block.settings.review_text_color }};">{{ block.settings.review_text }}</p>
          <div class="pp-review-author">
            <span style="color: {{ block.settings.author_color }};">{{ block.settings.author_text }}</span>
            {%- if block.settings.author_badge_text != blank -%}
              <span class="pp-review-badge" style="background: {{ block.settings.author_badge_color }}; color: {{ block.settings.author_badge_text_color }};">{{ block.settings.author_badge_text }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.button_link != blank -%}
    <div class="pp-reviews-cta" style="text-align: {{ section.settings.button_alignment }};">
      <a href="{{ section.settings.button_link }}" class="button" style="background: {{ section.settings.button_background_color }}; color: {{ section.settings.button_text_color }};">{{ section.settings.button_label }}</a>
    </div>
  {%- endif -%}
</div>

<style>
  .pp-reviews-header { max-width: 60rem; margin: 0 auto 2.4rem; }
  .pp-reviews-stars { display: inline-flex; gap: 0.1rem; margin-bottom: 0.8rem; }
  .pp-reviews-grid { display: grid; grid-template-columns: 1fr; gap: 1.6rem; }
  @media screen and (min-width: 750px) { .pp-reviews-grid { grid-template-columns: repeat(3, 1fr); } }
  .pp-review-card { border: 1px solid rgba(0,0,0,0.08); border-radius: 8px; padding: 1.6rem; display: flex; flex-direction: column; gap: 0.8rem; }
  .pp-review-image { border-radius: 8px; overflow: hidden; }
  .pp-review-image img { width: 100%; height: auto; display: block; }
  .pp-review-stars { display: inline-flex; gap: 0.1rem; }
  .pp-review-text { font-size: 1.4rem; line-height: 1.5; }
  .pp-review-author { display: flex; align-items: center; gap: 0.8rem; font-weight: 600; }
  .pp-review-badge { font-size: 1.1rem; font-weight: 700; padding: 0.2rem 0.7rem; border-radius: 999px; }
  .pp-reviews-cta { margin-top: 2.4rem; }
</style>

{% schema %}
{
  "name": "PP - Reviews",
  "settings": [
    { "type": "select", "id": "heading_stars_size", "options": [{"value":"sm","label":"Small"},{"value":"lg","label":"Large"}], "default": "lg", "label": "Stars size" },
    { "type": "color", "id": "heading_stars_color", "label": "Stars color", "default": "#facc15" },
    { "type": "select", "id": "stars_alignment", "options": [{"value":"start","label":"Left"},{"value":"center","label":"Center"}], "default": "center", "label": "Stars alignment" },
    { "type": "select", "id": "stars_mobilealignment", "options": [{"value":"start","label":"Left"},{"value":"center","label":"Center"}], "default": "center", "label": "Mobile stars alignment" },
    { "type": "range", "id": "heading_stars_number", "min": 0, "max": 5, "step": 1, "default": 5, "label": "Number of stars" },
    { "type": "inline_richtext", "id": "heading", "default": "Loved by our customers", "label": "Heading" },
    { "type": "select", "id": "heading_size", "options": [{"value":"h2","label":"Small"},{"value":"h1","label":"Medium"},{"value":"h0","label":"Large"}], "default": "h1", "label": "Heading size" },
    { "type": "select", "id": "heading_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Alignment" },
    { "type": "select", "id": "heading_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "subtitle", "label": "Text size" },
    { "type": "select", "id": "text_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Alignment" },
    { "type": "select", "id": "text_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "color_background", "id": "gradient", "label": "Background color" },
    { "type": "text", "id": "button_label", "default": "Shop Now", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "button_link_newtab", "default": false, "label": "Open in new tab" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#FFFFFF" },
    { "type": "color", "id": "button_background_color", "label": "Button background color", "default": "#000000" },
    { "type": "range", "id": "button_border_width", "min": 0, "max": 10, "step": 1, "unit": "px", "default": 0, "label": "Button border width" },
    { "type": "color", "id": "button_border_color", "label": "Button border color", "default": "#000000" },
    { "type": "select", "id": "button_width", "options": [{"value":"fit","label":"Fit"},{"value":"full","label":"Full"}], "default": "fit", "label": "Button width" },
    { "type": "select", "id": "button_width_mobile", "options": [{"value":"fit","label":"Fit"},{"value":"full","label":"Full"}], "default": "full", "label": "Mobile button width" },
    { "type": "select", "id": "button_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Button alignment" },
    { "type": "select", "id": "button_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile button alignment" },
    { "type": "select", "id": "button_rounded_corners", "options": [{"value":"none","label":"None"},{"value":"medium","label":"Medium"},{"value":"full","label":"Full"}], "default": "medium", "label": "Button corners" },
    { "type": "range", "id": "button_padding_vertical", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 15, "label": "Button vertical padding" },
    { "type": "range", "id": "button_padding_horizontal", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 15, "label": "Button horizontal padding" },
    { "type": "text", "id": "button_subtext", "label": "Button subtext" },
    { "type": "select", "id": "button_subtext_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "body", "label": "Subtext size" },
    { "type": "color", "id": "button_subtext_color", "label": "Subtext color", "default": "#000000" },
    { "type": "select", "id": "button_action", "options": [{"value":"link","label":"Link"},{"value":"scroll","label":"Scroll"}], "default": "link", "label": "Button action" },
    { "type": "text", "id": "button_action_scroll_element", "label": "Scroll target" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Bottom padding" },
    { "type": "range", "id": "margin_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Top margin" },
    { "type": "range", "id": "margin_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Bottom margin" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 30,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "image_border_radius", "options": [{"value":"low","label":"Low"},{"value":"medium","label":"Medium"},{"value":"high","label":"High"}], "default": "low", "label": "Image corners" },
        { "type": "text", "id": "author_text", "default": "Author's Name", "label": "Author" },
        { "type": "select", "id": "author_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "subtitle", "label": "Author text size" },
        { "type": "color", "id": "author_color", "label": "Author color", "default": "#000000" },
        { "type": "text", "id": "author_badge_text", "default": "Verified Buyer", "label": "Badge text" },
        { "type": "select", "id": "author_badge_text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "body", "label": "Badge text size" },
        { "type": "color", "id": "author_badge_text_color", "label": "Badge text color", "default": "#ffffff" },
        { "type": "color", "id": "author_badge_color", "label": "Badge color", "default": "#2993f1" },
        { "type": "select", "id": "stars_size", "options": [{"value":"sm","label":"Small"},{"value":"lg","label":"Large"}], "default": "sm", "label": "Stars size" },
        { "type": "color", "id": "stars_color", "label": "Stars color", "default": "#facc15" },
        { "type": "range", "id": "stars_number", "min": 0, "max": 5, "step": 1, "default": 5, "label": "Number of stars" },
        { "type": "select", "id": "stars_alignment", "options": [{"value":"start","label":"Left"},{"value":"center","label":"Center"}], "default": "start", "label": "Stars alignment" },
        { "type": "select", "id": "stars_mobilealignment", "options": [{"value":"start","label":"Left"},{"value":"center","label":"Center"}], "default": "start", "label": "Mobile stars alignment" },
        { "type": "textarea", "id": "review_text", "default": "Review text goes here.", "label": "Review text" },
        { "type": "select", "id": "review_text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "body", "label": "Review text size" },
        { "type": "color", "id": "review_text_color", "label": "Review text color", "default": "#000000" },
        { "type": "color", "id": "review_background_color", "label": "Card background color", "default": "#ffffff" },
        { "type": "select", "id": "review_border_radius", "options": [{"value":"low","label":"Low"},{"value":"medium","label":"Medium"},{"value":"high","label":"High"}], "default": "low", "label": "Card corners" }
      ]
    }
  ],
  "presets": [
    { "name": "PP - Reviews", "blocks": [{"type":"review"},{"type":"review"},{"type":"review"}] }
  ]
}
{% endschema %}
