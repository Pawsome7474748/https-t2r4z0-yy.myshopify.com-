{% comment %}
========================================================================
  DEWY — Founder Origin Story ("I built this because nothing worked")
  COMPLIANCE: no cure/medication-replacement claims. Warm compress = first-line
  (TFOS DEWS II, AOA, AAO), used alongside professional care.
========================================================================
{% endcomment %}

<style>
  .fs{ --ink:#20261F; --paper:#FBF9F3; --mist:#ECEFE4; --dew:#7BA05B; --dew-deep:#4E7038;
    --clay:#C98A5E; --line:#DEE1D4; --shadow:0 20px 55px -28px rgba(32,38,31,.5);
    font-family:{{ section.settings.body_font.family }}, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color:var(--ink); background:var(--paper); line-height:1.75; -webkit-font-smoothing:antialiased; }
  .fs *{ box-sizing:border-box; }
  .fs__wrap{ max-width:1080px; margin:0 auto; padding:0 40px; }
  .fs__col{ max-width:820px; }
  .fs__masthead{ border-bottom:1px solid var(--line); padding:20px 0; margin-bottom:44px; display:flex; align-items:baseline; justify-content:space-between; }
  .fs__logo{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif; font-weight:600; font-size:24px; letter-spacing:.06em; color:var(--dew-deep); margin:0; }
  .fs__logo span{ color:var(--clay); }
  .fs__eyebrow{ font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:#8a978f; }
  .fs h1{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif; font-weight:600; font-size:clamp(30px,4.4vw,48px); line-height:1.14; letter-spacing:-.01em; margin:0 0 20px; max-width:18ch; }
  .fs h2{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif; font-weight:600; font-size:clamp(23px,3vw,32px); line-height:1.2; margin:52px 0 18px; }
  .fs__byline{ font-size:15px; color:var(--dew-deep); border-bottom:1px solid var(--line); padding-bottom:24px; margin-bottom:30px; }
  .fs__byline strong{ color:var(--ink); }
  .fs p{ margin:0 0 20px; font-size:19px; } .fs__lead{ font-size:22px; line-height:1.6; } .fs__rte p{ font-size:19px; }
  .fs__pull{ background:var(--mist); border-left:4px solid var(--dew); padding:22px 28px; border-radius:4px; margin:30px 0; font-size:21px; color:var(--dew-deep); }
  .fs__figure{ margin:34px 0; } .fs__figure img{ width:100%; border-radius:14px; display:block; box-shadow:var(--shadow); }
  .fs__cap{ font-size:13px; color:#8a978f; margin-top:10px; }
  .fs__signature{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif; font-size:22px; color:var(--dew-deep); margin:8px 0 0; }
  .fs__mech{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin:24px 0; }
  .fs__mech-item{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:22px 24px; }
  .fs__mech-item h3{ margin:0 0 8px; font-size:19px; font-weight:700; } .fs__mech-item p{ margin:0; font-size:16px; }
  .fs__evidence{ background:var(--ink); color:var(--paper); border-radius:16px; padding:36px 34px; margin:40px 0; }
  .fs__evidence h2{ color:#fff; margin:0 0 16px; } .fs__evidence p{ font-size:17px; color:#DBE3D2; }
  .fs__offer{ background:var(--mist); border-radius:18px; padding:40px 34px; text-align:center; margin:46px 0; }
  .fs__price{ font-size:21px; margin-bottom:8px; } .fs__price s{ color:#94a39e; margin-right:10px; } .fs__price b{ color:var(--dew-deep); font-size:34px; }
  .fs__cta{ display:inline-block; background:var(--dew-deep); color:#fff; font-size:19px; font-weight:600; text-decoration:none; padding:18px 46px; border-radius:999px; margin:18px 0 10px; transition:transform .12s, background .2s; }
  .fs__cta:hover{ background:var(--dew); transform:translateY(-1px); }
  .fs__reassure{ font-size:14px; color:var(--dew-deep); margin:8px 0 0; }
  .fs__reviews{ display:grid; grid-template-columns:1fr 1fr; gap:18px; margin:24px 0; }
  .fs__review{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:22px 24px; font-size:16px; }
  .fs__review .who{ margin-top:12px; font-weight:700; color:var(--dew-deep); font-size:14px; }
  .fs__stars{ color:var(--clay); letter-spacing:2px; }
  .fs__faq details{ border-bottom:1px solid var(--line); padding:18px 0; }
  .fs__faq summary{ font-weight:600; font-size:18px; cursor:pointer; list-style:none; display:flex; justify-content:space-between; align-items:center; }
  .fs__faq summary::after{ content:"+"; color:var(--dew); font-size:24px; } .fs__faq details[open] summary::after{ content:"\2013"; }
  .fs__faq p{ margin:14px 0 0; font-size:16px; }
  .fs__disc{ background:#F1EEE4; color:#6b6257; font-size:12.5px; line-height:1.65; padding:24px; border-radius:10px; margin:44px 0 12px; }
  .fs__foot{ text-align:center; font-size:12px; color:#8a978f; padding:22px 0 64px; }
  @media (max-width:760px){ .fs__wrap{ padding:0 22px; } .fs__mech,.fs__reviews{ grid-template-columns:1fr; } .fs p,.fs__rte p{ font-size:18px; } .fs__lead{ font-size:20px; } .fs h1{ max-width:none; } }
</style>

<section class="fs">
  <div class="fs__wrap">
    <div class="fs__masthead"><p class="fs__logo">{{ section.settings.brand_name }}<span>.</span></p><span class="fs__eyebrow">{{ section.settings.eyebrow }}</span></div>
    <div class="fs__col">
      <h1>{{ section.settings.headline }}</h1>
      <div class="fs__byline">By <strong>{{ section.settings.author }}</strong> · {{ section.settings.byline_role }}</div>
      <p class="fs__lead">{{ section.settings.lead }}</p>
      <div class="fs__rte">{{ section.settings.intro_body }}</div>
      {% if section.settings.hero_image != blank %}<div class="fs__figure"><img src="{{ section.settings.hero_image | image_url: width:1400 }}" alt="{{ section.settings.brand_name }}" loading="lazy">{% if section.settings.hero_caption != blank %}<p class="fs__cap">{{ section.settings.hero_caption }}</p>{% endif %}</div>{% endif %}

      <h2>{{ section.settings.s1_title }}</h2>
      <div class="fs__rte">{{ section.settings.s1_body }}</div>
      <div class="fs__pull">{{ section.settings.pullquote }}</div>

      <h2>{{ section.settings.s2_title }}</h2>
      <div class="fs__rte">{{ section.settings.s2_body }}</div>

      <h2>{{ section.settings.mech_title }}</h2>
      <div class="fs__rte">{{ section.settings.mech_intro }}</div>
      <div class="fs__mech">
        <div class="fs__mech-item"><h3>{{ section.settings.mech1_title }}</h3><p>{{ section.settings.mech1_body }}</p></div>
        <div class="fs__mech-item"><h3>{{ section.settings.mech2_title }}</h3><p>{{ section.settings.mech2_body }}</p></div>
        <div class="fs__mech-item"><h3>{{ section.settings.mech3_title }}</h3><p>{{ section.settings.mech3_body }}</p></div>
        <div class="fs__mech-item"><h3>{{ section.settings.mech4_title }}</h3><p>{{ section.settings.mech4_body }}</p></div>
      </div>

      <div class="fs__rte">{{ section.settings.signoff_body }}</div>
      <p class="fs__signature">{{ section.settings.signature }}</p>

      <div class="fs__evidence"><h2>{{ section.settings.evidence_title }}</h2><div>{{ section.settings.evidence_body }}</div></div>

      <div class="fs__offer"><p class="fs__price">{% if section.settings.compare_price != blank %}<s>{{ section.settings.compare_price }}</s>{% endif %}<b>{{ section.settings.price }}</b></p><a class="fs__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a><p class="fs__reassure">{{ section.settings.reassure }}</p></div>

      {% if section.settings.show_reviews %}<h2>{{ section.settings.reviews_title }}</h2><div class="fs__reviews">{% for block in section.blocks %}{% if block.type == 'review' %}<div class="fs__review" {{ block.shopify_attributes }}><div class="fs__stars">★★★★★</div><div>{{ block.settings.text }}</div><div class="who">— {{ block.settings.name }}</div></div>{% endif %}{% endfor %}</div>{% endif %}

      <h2>{{ section.settings.faq_title }}</h2>
      <div class="fs__faq">{% for block in section.blocks %}{% if block.type == 'faq' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><p>{{ block.settings.a }}</p></details>{% endif %}{% endfor %}</div>

      <div class="fs__offer"><p class="fs__price">{% if section.settings.compare_price != blank %}<s>{{ section.settings.compare_price }}</s>{% endif %}<b>{{ section.settings.price }}</b></p><a class="fs__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a><p class="fs__reassure">{{ section.settings.reassure }}</p></div>
      <div class="fs__disc">{{ section.settings.disclaimer }}</div>
      <div class="fs__foot">© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name }}. {{ section.settings.footer_note }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dewy — Founder Story",
  "settings": [
    { "type": "header", "content": "Fonts" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n6" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" },
    { "type": "header", "content": "Masthead" },
    { "type": "text", "id": "brand_name", "label": "Brand", "default": "Dewy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why we made this" },
    { "type": "header", "content": "Headline & intro" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "I tried everything for my dry eyes. Then I made the thing that finally fit my life." },
    { "type": "text", "id": "author", "label": "Author", "default": "Thomas Cage" },
    { "type": "text", "id": "byline_role", "label": "Byline role", "default": "founder of Dewy" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "I'm not a doctor. I'm just someone who spent two years with gritty, tired eyes and a bathroom drawer full of things that didn't quite work — and got fed up enough to build something better." },
    { "type": "richtext", "id": "intro_body", "label": "Intro body", "default": "<p>If you've been through the same cycle — drops that fade in an hour, warm flannels that go cold in ninety seconds, advice you never manage to keep up — I want to tell you how I got out of it, because the fix turned out to be simpler and less glamorous than I expected.</p>" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (a real founder photo works best here)" },
    { "type": "text", "id": "hero_caption", "label": "Caption" },
    { "type": "header", "content": "Section 1 — the frustration" },
    { "type": "text", "id": "s1_title", "label": "Title", "default": "Everything I tried worked for about an hour" },
    { "type": "richtext", "id": "s1_body", "label": "Body", "default": "<p>Drops first, obviously. Bottle after bottle. They'd soothe things for a while and then I'd be right back to that sandpaper feeling by mid-afternoon. An optometrist eventually explained why: the drops were topping up the watery part of my tears, but the layer that had actually broken down was the oily one that stops tears evaporating. More water, missing lid on the jar.</p><p>The fix she suggested was a warm compress. Simple. Cheap. And I could not stick to it — a hot wet flannel is annoying, it cools in seconds, and it drips down your wrists. So I did it twice and gave up, like most people do.</p>" },
    { "type": "textarea", "id": "pullquote", "label": "Pull quote", "default": "The science wasn't the problem. The keeping-it-up was. Nothing I owned made the one thing that helped easy enough to actually do." },
    { "type": "header", "content": "Section 2 — building it" },
    { "type": "text", "id": "s2_title", "label": "Title", "default": "So I made the version I wished existed" },
    { "type": "richtext", "id": "s2_body", "label": "Body", "default": "<p>I wanted something that held a steady, comfortable warmth long enough to matter, that I'd actually look forward to, and that fit into the ten minutes before bed without any fuss. That's all Dewy is. It's not a miracle and I'll never pretend it is — it's the warm-compress step the eye specialists already recommend, made into something you'll genuinely keep doing.</p>" },
    { "type": "header", "content": "What it is" },
    { "type": "text", "id": "mech_title", "label": "Title", "default": "What Dewy actually is" },
    { "type": "richtext", "id": "mech_intro", "label": "Intro", "default": "<p>No mystery ingredients, no big promises. Just the sensible first step, done properly:</p>" },
    { "type": "text", "id": "mech1_title", "label": "P1", "default": "Steady, even warmth" },
    { "type": "textarea", "id": "mech1_body", "label": "P1 body", "default": "Research indicates the eyelid needs to reach around 40°C to soften the thickened oils in the glands. Dewy holds a comfortable, even warmth across the whole lid — the thing a flannel can't do." },
    { "type": "text", "id": "mech2_title", "label": "P2", "default": "Easy enough to keep up" },
    { "type": "textarea", "id": "mech2_body", "label": "P2 body", "default": "The whole reason I built it. Ten minutes, no mess, no dripping — a routine you'll actually repeat, which is the only thing that works." },
    { "type": "text", "id": "mech3_title", "label": "P3", "default": "Soft and reusable" },
    { "type": "textarea", "id": "mech3_body", "label": "P3 body", "default": "Washable, comfortable, and calming enough to become the nice part of your evening instead of a chore." },
    { "type": "text", "id": "mech4_title", "label": "P4", "default": "Works with your eye care" },
    { "type": "textarea", "id": "mech4_body", "label": "P4 body", "default": "Keep whatever your optometrist gave you. Dewy handles the oil-layer step alongside it — I still use my drops too." },
    { "type": "richtext", "id": "signoff_body", "label": "Sign-off body", "default": "<p>That's the honest story. If your eyes have been quietly wearing you down and nothing's stuck, I think Dewy is worth ten minutes of your evening. And if it isn't for you, you've got 30 days to send it back — no hard feelings.</p>" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "— Thomas" },
    { "type": "header", "content": "Evidence (keep wording)" },
    { "type": "text", "id": "evidence_title", "label": "Title", "default": "The part I want to be straight about" },
    { "type": "richtext", "id": "evidence_body", "label": "Body", "default": "<p>Dewy is not a cure and not a replacement for anything your optometrist has given you. What's true is that warm-compress therapy is recognised as a <strong>first-line</strong> approach for evaporative dry eye and meibomian gland dysfunction in the international TFOS DEWS II consensus, and recommended by major eye-care bodies including the American Optometric Association and American Academy of Ophthalmology. It's one of the simplest, best-evidenced first steps you can take at home — used alongside professional care. That's exactly what I built Dewy to make easy.</p>" },
    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "price", "label": "Price", "default": "$39" },
    { "type": "text", "id": "compare_price", "label": "Compare-at (genuine only)" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Try Dewy — 30-day returns" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "reassure", "label": "Reassurance", "default": "30-day returns · No subscription" },
    { "type": "header", "content": "Reviews" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews", "default": true },
    { "type": "text", "id": "reviews_title", "label": "Reviews title", "default": "From people who tried it" },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_title", "label": "FAQ title", "default": "Honest answers" },
    { "type": "header", "content": "Legal" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Dewy is a comfort product. It is not a medicine and is not intended to diagnose, treat, cure, or prevent any disease. This page is general educational information, not medical advice, and does not replace guidance from a qualified eye-care professional. If you have persistent, painful, or worsening symptoms, or any sudden change in vision, see an optometrist or doctor. Statements about warm-compress therapy describe the general approach as set out in published eye-care guidance, not results guaranteed from this product. Individual results vary." },
    { "type": "text", "id": "footer_note", "label": "Footer", "default": "All rights reserved." }
  ],
  "blocks": [
    { "type": "review", "name": "Review (REAL only)", "settings": [
      { "type": "textarea", "id": "text", "label": "Review", "default": "[Replace with a real, consented customer review before publishing. Do not invent reviews.]" },
      { "type": "text", "id": "name", "label": "Name", "default": "Customer name" } ] },
    { "type": "faq", "name": "FAQ", "settings": [
      { "type": "text", "id": "q", "label": "Q", "default": "Are you really the founder?" },
      { "type": "textarea", "id": "a", "label": "A", "default": "Yes — edit this section so the story reflects the real person behind the brand. An honest founder story is the whole point; keep it true." } ] }
  ],
  "presets": [ { "name": "Dewy — Founder Story", "blocks": [ {"type":"review"},{"type":"review"},{"type":"review"},{"type":"faq"},{"type":"faq"},{"type":"faq"} ] } ]
}
{% endschema %}
