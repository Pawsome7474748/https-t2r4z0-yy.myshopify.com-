{% comment %}
========================================================================
  DEWY — "The last generation just lived with this" (Emotional angle)
  COMPLIANCE: no cure/medication-replacement claims; warm compress framed
  as first-line (TFOS DEWS II, AOA, AAO) used alongside professional care.
========================================================================
{% endcomment %}

<style>
  .lg{ --ink:#1B2B25; --paper:#FBF9F4; --mist:#EBF1EC; --dew:#5FA98C; --dew-deep:#33705A;
    --rose:#D98C86; --line:#DBE3DD; --shadow:0 20px 55px -28px rgba(27,43,37,.5);
    font-family:{{ section.settings.body_font.family }}, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color:var(--ink); background:var(--paper); line-height:1.75; -webkit-font-smoothing:antialiased; }
  .lg *{ box-sizing:border-box; }
  .lg__wrap{ max-width:1080px; margin:0 auto; padding:0 40px; }
  .lg__col{ max-width:900px; }
  .lg__masthead{ border-bottom:1px solid var(--line); padding:20px 0; margin-bottom:44px;
    display:flex; align-items:baseline; justify-content:space-between; }
  .lg__logo{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif; font-weight:600;
    font-size:24px; letter-spacing:.06em; color:var(--dew-deep); margin:0; }
  .lg__logo span{ color:var(--rose); }
  .lg__eyebrow{ font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:#8a978f; }
  .lg h1{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif; font-weight:600;
    font-size:clamp(30px,4.6vw,50px); line-height:1.12; letter-spacing:-.01em; margin:0 0 20px; max-width:18ch; }
  .lg h2{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif; font-weight:600;
    font-size:clamp(23px,3vw,33px); line-height:1.2; margin:52px 0 18px; }
  .lg__byline{ font-size:15px; color:var(--dew-deep); border-bottom:1px solid var(--line);
    padding-bottom:24px; margin-bottom:30px; }
  .lg__byline strong{ color:var(--ink); }
  .lg p{ margin:0 0 20px; font-size:19px; }
  .lg__lead{ font-size:22px; line-height:1.6; }
  .lg__rte p{ font-size:19px; }
  .lg__pull{ background:var(--mist); border-left:4px solid var(--dew); padding:22px 28px; border-radius:4px;
    margin:30px 0; font-size:21px; color:var(--dew-deep); }
  .lg__figure{ margin:34px 0; }
  .lg__figure img{ width:100%; border-radius:14px; display:block; box-shadow:var(--shadow); }
  .lg__cap{ font-size:13px; color:#8a978f; margin-top:10px; }
  .lg__mech{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin:24px 0; }
  .lg__mech-item{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:22px 24px; }
  .lg__mech-item h3{ margin:0 0 8px; font-size:19px; font-weight:700; }
  .lg__mech-item p{ margin:0; font-size:16px; }
  .lg__evidence{ background:var(--ink); color:var(--paper); border-radius:16px; padding:36px 34px; margin:40px 0; }
  .lg__evidence h2{ color:#fff; margin:0 0 16px; }
  .lg__evidence p{ font-size:17px; color:#D9E6DF; }
  .lg__offer{ background:var(--mist); border-radius:18px; padding:40px 34px; text-align:center; margin:46px 0; }
  .lg__price{ font-size:21px; margin-bottom:8px; } .lg__price s{ color:#94a39e; margin-right:10px; }
  .lg__price b{ color:var(--dew-deep); font-size:34px; }
  .lg__cta{ display:inline-block; background:var(--dew-deep); color:#fff; font-size:19px; font-weight:600;
    text-decoration:none; padding:18px 46px; border-radius:999px; margin:18px 0 10px; transition:transform .12s, background .2s; }
  .lg__cta:hover{ background:var(--dew); transform:translateY(-1px); }
  .lg__reassure{ font-size:14px; color:var(--dew-deep); margin:8px 0 0; }
  .lg__reviews{ display:grid; grid-template-columns:1fr 1fr; gap:18px; margin:24px 0; }
  .lg__review{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:22px 24px; font-size:16px; }
  .lg__review .who{ margin-top:12px; font-weight:700; color:var(--dew-deep); font-size:14px; }
  .lg__stars{ color:var(--rose); letter-spacing:2px; }
  .lg__faq details{ border-bottom:1px solid var(--line); padding:18px 0; }
  .lg__faq summary{ font-weight:600; font-size:18px; cursor:pointer; list-style:none; display:flex; justify-content:space-between; align-items:center; }
  .lg__faq summary::after{ content:"+"; color:var(--dew); font-size:24px; }
  .lg__faq details[open] summary::after{ content:"\2013"; }
  .lg__faq p{ margin:14px 0 0; font-size:16px; }
  .lg__disc{ background:#F1EDE5; color:#6b6257; font-size:12.5px; line-height:1.65; padding:24px; border-radius:10px; margin:44px 0 12px; }
  .lg__foot{ text-align:center; font-size:12px; color:#8a978f; padding:22px 0 64px; }
  @media (max-width:760px){ .lg__wrap{ padding:0 22px; } .lg__mech,.lg__reviews{ grid-template-columns:1fr; }
    .lg p,.lg__rte p{ font-size:18px; } .lg__lead{ font-size:20px; } .lg h1{ max-width:none; } }
</style>

<section class="lg">
  <div class="lg__wrap">
    <div class="lg__masthead">
      <p class="lg__logo">{{ section.settings.brand_name }}<span>.</span></p>
      <span class="lg__eyebrow">{{ section.settings.eyebrow }}</span>
    </div>
    <div class="lg__col">
      <h1>{{ section.settings.headline }}</h1>
      <div class="lg__byline">By <strong>{{ section.settings.author }}</strong> · {{ section.settings.byline_role }}</div>
      <p class="lg__lead">{{ section.settings.lead }}</p>
      <div class="lg__rte">{{ section.settings.intro_body }}</div>
      {% if section.settings.hero_image != blank %}
      <div class="lg__figure"><img src="{{ section.settings.hero_image | image_url: width:1400 }}" alt="{{ section.settings.brand_name }}" loading="lazy">
      {% if section.settings.hero_caption != blank %}<p class="lg__cap">{{ section.settings.hero_caption }}</p>{% endif %}</div>{% endif %}

      <h2>{{ section.settings.s1_title }}</h2>
      <div class="lg__rte">{{ section.settings.s1_body }}</div>
      <div class="lg__pull">{{ section.settings.pullquote }}</div>

      <h2>{{ section.settings.s2_title }}</h2>
      <div class="lg__rte">{{ section.settings.s2_body }}</div>

      <h2>{{ section.settings.mech_title }}</h2>
      <div class="lg__rte">{{ section.settings.mech_intro }}</div>
      <div class="lg__mech">
        <div class="lg__mech-item"><h3>{{ section.settings.mech1_title }}</h3><p>{{ section.settings.mech1_body }}</p></div>
        <div class="lg__mech-item"><h3>{{ section.settings.mech2_title }}</h3><p>{{ section.settings.mech2_body }}</p></div>
        <div class="lg__mech-item"><h3>{{ section.settings.mech3_title }}</h3><p>{{ section.settings.mech3_body }}</p></div>
        <div class="lg__mech-item"><h3>{{ section.settings.mech4_title }}</h3><p>{{ section.settings.mech4_body }}</p></div>
      </div>

      <div class="lg__evidence"><h2>{{ section.settings.evidence_title }}</h2><div>{{ section.settings.evidence_body }}</div></div>

      <div class="lg__offer">
        <p class="lg__price">{% if section.settings.compare_price != blank %}<s>{{ section.settings.compare_price }}</s>{% endif %}<b>{{ section.settings.price }}</b></p>
        <a class="lg__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
        <p class="lg__reassure">{{ section.settings.reassure }}</p>
      </div>

      {% if section.settings.show_reviews %}
      <h2>{{ section.settings.reviews_title }}</h2>
      <div class="lg__reviews">{% for block in section.blocks %}{% if block.type == 'review' %}
        <div class="lg__review" {{ block.shopify_attributes }}><div class="lg__stars">★★★★★</div><div>{{ block.settings.text }}</div><div class="who">— {{ block.settings.name }}</div></div>
      {% endif %}{% endfor %}</div>{% endif %}

      <h2>{{ section.settings.faq_title }}</h2>
      <div class="lg__faq">{% for block in section.blocks %}{% if block.type == 'faq' %}
        <details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><p>{{ block.settings.a }}</p></details>
      {% endif %}{% endfor %}</div>

      <div class="lg__offer">
        <p class="lg__price">{% if section.settings.compare_price != blank %}<s>{{ section.settings.compare_price }}</s>{% endif %}<b>{{ section.settings.price }}</b></p>
        <a class="lg__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
        <p class="lg__reassure">{{ section.settings.reassure }}</p>
      </div>
      <div class="lg__disc">{{ section.settings.disclaimer }}</div>
      <div class="lg__foot">© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name }}. {{ section.settings.footer_note }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dewy — Last Generation",
  "settings": [
    { "type": "header", "content": "Fonts" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n6" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" },
    { "type": "header", "content": "Masthead" },
    { "type": "text", "id": "brand_name", "label": "Brand", "default": "Dewy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For the women who were told to just cope" },
    { "type": "header", "content": "Headline & intro" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "The last generation of women just lived with this. You don't have to." },
    { "type": "text", "id": "author", "label": "Author", "default": "Sarah, founder of Dewy" },
    { "type": "text", "id": "byline_role", "label": "Byline role", "default": "wrote this for her mum, and for herself" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "My mother spent her fifties blinking through gritty, burning eyes and never once mentioned it to a doctor. She thought it was just part of getting older — the thing you don't complain about. It wasn't. And you don't have to inherit her silence." },
    { "type": "richtext", "id": "intro_body", "label": "Intro body", "default": "<p>If your eyes feel dry, tired and gritty by the afternoon — if you've quietly started avoiding long drives at night, or reaching for drops that fade within the hour — you're part of a huge group of women nobody has really spoken to. Not because the problem is rare. Because the women who have it were raised to put up with it.</p>" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_caption", "label": "Caption" },
    { "type": "header", "content": "Section 1 — the silence" },
    { "type": "text", "id": "s1_title", "label": "Title", "default": "A whole generation told to just cope" },
    { "type": "richtext", "id": "s1_body", "label": "Body", "default": "<p>Dry, irritated eyes are strongly linked to the hormonal changes of perimenopause and menopause — and they're far more common in women than men in this stage of life. Yet for decades it went unnamed and undiscussed, lumped in with all the other midlife symptoms women were quietly expected to absorb. Our mothers didn't have the language, the information, or the permission to treat it. They just blinked harder and carried on.</p>" },
    { "type": "textarea", "id": "pullquote", "label": "Pull quote", "default": "It was never that the problem didn't matter. It's that no one told these women it was allowed to." },
    { "type": "header", "content": "Section 2 — you have what they didn't" },
    { "type": "text", "id": "s2_title", "label": "Title", "default": "You have something they never did" },
    { "type": "richtext", "id": "s2_body", "label": "Body", "default": "<p>Here's what's changed: we now understand the mechanism. As we age, the tiny oil glands along the eyelids slow and clog, the oily layer that stops tears evaporating thins out, and — sped along by hormonal shifts — the eyes dry faster than tears can replace. It's specific, it's understood, and it responds to a simple, well-evidenced first step your mother was never offered.</p><p>You don't have to grit your way through it the way she did. That's the whole point of Dewy.</p>" },
    { "type": "header", "content": "Mechanism" },
    { "type": "text", "id": "mech_title", "label": "Title", "default": "What Dewy does" },
    { "type": "richtext", "id": "mech_intro", "label": "Intro", "default": "<p>Dewy is a warm compress mask built around the one thing that actually helps a thinning oil layer — gentle, even warmth, held long enough to matter.</p>" },
    { "type": "text", "id": "mech1_title", "label": "P1 title", "default": "Warmth that reaches the glands" },
    { "type": "textarea", "id": "mech1_body", "label": "P1 body", "default": "Research indicates the eyelid needs to reach around 40°C to soften the thickened oils in the glands. Dewy holds a comfortable, even warmth across the whole lid — not a flannel that's scalding then cold in 90 seconds." },
    { "type": "text", "id": "mech2_title", "label": "P2 title", "default": "A ritual you'll actually keep" },
    { "type": "textarea", "id": "mech2_body", "label": "P2 body", "default": "The reason warm compresses fail people is that a hot towel is a nuisance. Dewy is a 10-minute routine you'll genuinely repeat — and consistency is the whole game." },
    { "type": "text", "id": "mech3_title", "label": "P3 title", "default": "Soft, reusable, calming" },
    { "type": "textarea", "id": "mech3_body", "label": "P3 body", "default": "Washable and comfortable enough to become the nice part of your evening rather than a chore. Comfort is what turns it into a habit." },
    { "type": "text", "id": "mech4_title", "label": "P4 title", "default": "Works alongside your eye care" },
    { "type": "textarea", "id": "mech4_body", "label": "P4 body", "default": "Keep whatever your optometrist recommends. Dewy addresses the oil layer as a first-line habit — the two do different jobs." },
    { "type": "header", "content": "Evidence (keep wording)" },
    { "type": "text", "id": "evidence_title", "label": "Title", "default": "What the eye specialists say" },
    { "type": "richtext", "id": "evidence_body", "label": "Body", "default": "<p>We won't tell you Dewy is a cure or a replacement for anything your optometrist has given you — it isn't, and anyone who says that about a warm mask is being dishonest with you.</p><p>What's true: warm-compress and lid-warming therapy is recognised as a <strong>first-line</strong> approach for evaporative dry eye and meibomian gland dysfunction in the international TFOS DEWS II consensus, and recommended by major eye-care bodies including the American Optometric Association and American Academy of Ophthalmology. It's one of the simplest, best-evidenced first things you can do at home — often used alongside professional care.</p>" },
    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "price", "label": "Price", "default": "$39" },
    { "type": "text", "id": "compare_price", "label": "Compare-at (must be genuine)" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Try Dewy — 60-night comfort guarantee" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "reassure", "label": "Reassurance", "default": "Free shipping · 60-night money-back guarantee · No subscription" },
    { "type": "header", "content": "Reviews" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews", "default": true },
    { "type": "text", "id": "reviews_title", "label": "Reviews title", "default": "From women like you" },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_title", "label": "FAQ title", "default": "Honest answers" },
    { "type": "header", "content": "Legal" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Dewy is a comfort product. It is not a medicine and is not intended to diagnose, treat, cure, or prevent any disease. This page is general educational information, not medical advice, and does not replace guidance from a qualified eye-care professional. If you have persistent, painful, or worsening symptoms, or any sudden change in vision, see an optometrist or doctor. Statements about warm-compress therapy describe the general approach as set out in published eye-care guidance, not results guaranteed from this product. Individual results vary." },
    { "type": "text", "id": "footer_note", "label": "Footer", "default": "All rights reserved." }
  ],
  "blocks": [
    { "type": "review", "name": "Review (REAL only)", "settings": [
      { "type": "textarea", "id": "text", "label": "Review", "default": "[Replace with a real, consented customer review before publishing. Do not invent reviews.]" },
      { "type": "text", "id": "name", "label": "Name", "default": "Customer name" } ] },
    { "type": "faq", "name": "FAQ", "settings": [
      { "type": "text", "id": "q", "label": "Q", "default": "Is this a replacement for my eye drops?" },
      { "type": "textarea", "id": "a", "label": "A", "default": "No. Keep using whatever your eye professional recommends. Many people use a warm compress alongside as a first-line habit." } ] }
  ],
  "presets": [ { "name": "Dewy — Last Generation", "blocks": [ {"type":"review"},{"type":"review"},{"type":"review"},{"type":"faq"},{"type":"faq"},{"type":"faq"} ] } ]
}
{% endschema %}
