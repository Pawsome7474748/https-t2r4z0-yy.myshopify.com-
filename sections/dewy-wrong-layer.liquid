{% comment %}
========================================================================
  DEWY — "The Wrong Layer" Presell / Advertorial Section
  Angle: Your eye drops are treating the wrong layer.
  ------------------------------------------------------------------------
  HOW TO USE:
  1. Shopify admin > Online Store > Themes > Edit code.
  2. Sections > Add a new section > name it "dewy-wrong-layer".
     Delete default content, paste this whole file, Save.
  3. Add the section to a page/template via the theme editor and fill in
     the settings (product link, price, images) in the side panel.

  COMPLIANCE (keep as written):
  - No claim that Dewy is better than / replaces medication.
  - Warm-compress framed as a clinically-recognised FIRST-LINE approach
    (TFOS DEWS II, AOA, AAO), used ALONGSIDE professional eye care.
  - Testimonial blocks are EMPTY placeholders — insert only REAL,
    consented reviews before publishing, or delete the block.
  - Confirm ARTG status for your SKU before advertising in Australia.
========================================================================
{% endcomment %}

<style>
  .wl {
    --ink:#182A27; --paper:#FCFAF6; --mist:#EAF1EE; --dew:#5FA99C;
    --dew-deep:#357064; --coral:#E68A72; --line:#DCE5E1;
    --shadow:0 20px 55px -28px rgba(24,42,39,.5);
    font-family: {{ section.settings.body_font.family }}, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color:var(--ink); background:var(--paper); line-height:1.7;
    -webkit-font-smoothing:antialiased;
  }
  .wl *{box-sizing:border-box;}

  /* Wider, article-style reading width (not a narrow center column) */
  .wl__wrap{ max-width:1080px; margin:0 auto; padding:0 40px; }
  .wl__col{ max-width:900px; }          /* body text runs wide like a real article */

  .wl__masthead{ border-bottom:1px solid var(--line); padding:20px 0; margin-bottom:44px;
    display:flex; align-items:baseline; justify-content:space-between; }
  .wl__logo{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif;
    font-weight:600; font-size:24px; letter-spacing:.06em; color:var(--dew-deep); margin:0; }
  .wl__logo span{ color:var(--coral); }
  .wl__eyebrow{ font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:#8a978f; }

  .wl h1{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif;
    font-weight:600; font-size:clamp(30px,4.6vw,50px); line-height:1.12; letter-spacing:-.01em;
    margin:0 0 20px; max-width:16ch; }
  .wl h2{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif;
    font-weight:600; font-size:clamp(23px,3vw,33px); line-height:1.2; margin:52px 0 18px; }

  .wl__byline{ font-size:15px; color:var(--dew-deep); border-bottom:1px solid var(--line);
    padding-bottom:24px; margin-bottom:30px; }
  .wl__byline strong{ color:var(--ink); }

  .wl p{ margin:0 0 20px; font-size:19px; }
  .wl__lead{ font-size:22px; line-height:1.6; }
  .wl__rte p{ font-size:19px; }

  /* The layer diagram — the signature visual of the "wrong layer" idea */
  .wl__layers{ display:grid; gap:0; margin:30px 0 8px; border-radius:14px; overflow:hidden;
    border:1px solid var(--line); box-shadow:var(--shadow); }
  .wl__layer{ padding:20px 26px; display:flex; align-items:center; gap:18px; }
  .wl__layer b{ font-size:18px; }
  .wl__layer span{ font-size:15px; color:#5c6b66; }
  .wl__layer-oil{ background:#FBEEDF; }
  .wl__layer-water{ background:#E4F0F3; }
  .wl__layer-mucin{ background:#EAF1EE; }
  .wl__layer-tag{ font-family:{{ section.settings.heading_font.family }}, Georgia, serif;
    font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:.08em;
    color:var(--dew-deep); min-width:74px; }
  .wl__layer-note{ background:var(--ink); color:var(--paper); padding:16px 26px; font-size:15px; }
  .wl__layer-note b{ color:var(--coral); }

  .wl__pull{ background:var(--mist); border-left:4px solid var(--dew); padding:22px 28px;
    border-radius:4px; margin:30px 0; font-size:21px; color:var(--dew-deep); }

  .wl__figure{ margin:34px 0; }
  .wl__figure img{ width:100%; border-radius:14px; display:block; box-shadow:var(--shadow); }
  .wl__cap{ font-size:13px; color:#8a978f; margin-top:10px; }

  .wl__mech{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin:24px 0; }
  .wl__mech-item{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:22px 24px; }
  .wl__mech-item h3{ margin:0 0 8px; font-size:19px; font-weight:700; }
  .wl__mech-item p{ margin:0; font-size:16px; }

  .wl__evidence{ background:var(--ink); color:var(--paper); border-radius:16px; padding:36px 34px; margin:40px 0; }
  .wl__evidence h2{ color:#fff; margin:0 0 16px; }
  .wl__evidence p{ font-size:17px; color:#D9E6E2; }
  .wl__evidence a{ color:var(--dew); }

  .wl__offer{ background:var(--mist); border-radius:18px; padding:40px 34px; text-align:center; margin:46px 0; }
  .wl__price{ font-size:21px; margin-bottom:8px; }
  .wl__price s{ color:#94a39e; margin-right:10px; }
  .wl__price b{ color:var(--dew-deep); font-size:34px; }
  .wl__cta{ display:inline-block; background:var(--dew-deep); color:#fff; font-size:19px; font-weight:600;
    text-decoration:none; padding:18px 46px; border-radius:999px; margin:18px 0 10px;
    transition:transform .12s ease, background .2s ease; }
  .wl__cta:hover{ background:var(--dew); transform:translateY(-1px); }
  .wl__reassure{ font-size:14px; color:var(--dew-deep); margin:8px 0 0; }

  .wl__reviews{ display:grid; grid-template-columns:1fr 1fr; gap:18px; margin:24px 0; }
  .wl__review{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:22px 24px; font-size:16px; }
  .wl__review .who{ margin-top:12px; font-weight:700; color:var(--dew-deep); font-size:14px; }
  .wl__stars{ color:var(--coral); letter-spacing:2px; }

  .wl__faq details{ border-bottom:1px solid var(--line); padding:18px 0; }
  .wl__faq summary{ font-weight:600; font-size:18px; cursor:pointer; list-style:none;
    display:flex; justify-content:space-between; align-items:center; }
  .wl__faq summary::after{ content:"+"; color:var(--dew); font-size:24px; }
  .wl__faq details[open] summary::after{ content:"\2013"; }
  .wl__faq p{ margin:14px 0 0; font-size:16px; }

  .wl__disc{ background:#F1EDE5; color:#6b6257; font-size:12.5px; line-height:1.65; padding:24px; border-radius:10px; margin:44px 0 12px; }
  .wl__foot{ text-align:center; font-size:12px; color:#8a978f; padding:22px 0 64px; }

  @media (max-width:760px){
    .wl__wrap{ padding:0 22px; }
    .wl__mech, .wl__reviews{ grid-template-columns:1fr; }
    .wl p, .wl__rte p{ font-size:18px; }
    .wl__lead{ font-size:20px; }
    .wl h1{ max-width:none; }
  }
</style>

<section class="wl">
  <div class="wl__wrap">

    <div class="wl__masthead">
      <p class="wl__logo">{{ section.settings.brand_name }}<span>.</span></p>
      <span class="wl__eyebrow">{{ section.settings.eyebrow }}</span>
    </div>

    <div class="wl__col">

      <!-- HEADLINE (the hook) -->
      <h1>{{ section.settings.headline }}</h1>
      <div class="wl__byline">By <strong>{{ section.settings.author }}</strong> · {{ section.settings.byline_role }}</div>

      <p class="wl__lead">{{ section.settings.lead }}</p>
      <div class="wl__rte">{{ section.settings.intro_body }}</div>

      {% if section.settings.hero_image != blank %}
      <div class="wl__figure">
        <img src="{{ section.settings.hero_image | image_url: width:1400 }}" alt="{{ section.settings.brand_name }}" loading="lazy">
        {% if section.settings.hero_caption != blank %}<p class="wl__cap">{{ section.settings.hero_caption }}</p>{% endif %}
      </div>
      {% endif %}

      <!-- THE REVEAL: three layers -->
      <h2>{{ section.settings.layers_title }}</h2>
      <div class="wl__rte">{{ section.settings.layers_intro }}</div>

      <div class="wl__layers">
        <div class="wl__layer wl__layer-oil">
          <span class="wl__layer-tag">Top</span>
          <div><b>{{ section.settings.layer_oil_title }}</b><br><span>{{ section.settings.layer_oil_desc }}</span></div>
        </div>
        <div class="wl__layer wl__layer-water">
          <span class="wl__layer-tag">Middle</span>
          <div><b>{{ section.settings.layer_water_title }}</b><br><span>{{ section.settings.layer_water_desc }}</span></div>
        </div>
        <div class="wl__layer wl__layer-mucin">
          <span class="wl__layer-tag">Base</span>
          <div><b>{{ section.settings.layer_mucin_title }}</b><br><span>{{ section.settings.layer_mucin_desc }}</span></div>
        </div>
        <div class="wl__layer-note">{{ section.settings.layer_note }}</div>
      </div>

      <div class="wl__pull">{{ section.settings.pullquote }}</div>

      <!-- AGITATION -->
      <h2>{{ section.settings.agitate_title }}</h2>
      <div class="wl__rte">{{ section.settings.agitate_body }}</div>

      <!-- MECHANISM: how Dewy addresses the oil layer -->
      <h2>{{ section.settings.mech_title }}</h2>
      <div class="wl__rte">{{ section.settings.mech_intro }}</div>
      <div class="wl__mech">
        <div class="wl__mech-item"><h3>{{ section.settings.mech1_title }}</h3><p>{{ section.settings.mech1_body }}</p></div>
        <div class="wl__mech-item"><h3>{{ section.settings.mech2_title }}</h3><p>{{ section.settings.mech2_body }}</p></div>
        <div class="wl__mech-item"><h3>{{ section.settings.mech3_title }}</h3><p>{{ section.settings.mech3_body }}</p></div>
        <div class="wl__mech-item"><h3>{{ section.settings.mech4_title }}</h3><p>{{ section.settings.mech4_body }}</p></div>
      </div>

      <!-- EVIDENCE (honest, cited) -->
      <div class="wl__evidence">
        <h2>{{ section.settings.evidence_title }}</h2>
        <div>{{ section.settings.evidence_body }}</div>
      </div>

      <!-- OFFER -->
      <div class="wl__offer">
        <p class="wl__price">{% if section.settings.compare_price != blank %}<s>{{ section.settings.compare_price }}</s>{% endif %}<b>{{ section.settings.price }}</b></p>
        <a class="wl__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
        <p class="wl__reassure">{{ section.settings.reassure }}</p>
      </div>

      <!-- REVIEWS (placeholders — replace with real) -->
      {% if section.settings.show_reviews %}
      <h2>{{ section.settings.reviews_title }}</h2>
      <div class="wl__reviews">
        {% for block in section.blocks %}{% if block.type == 'review' %}
        <div class="wl__review" {{ block.shopify_attributes }}>
          <div class="wl__stars">★★★★★</div>
          <div>{{ block.settings.text }}</div>
          <div class="who">— {{ block.settings.name }}</div>
        </div>
        {% endif %}{% endfor %}
      </div>
      {% endif %}

      <!-- FAQ -->
      <h2>{{ section.settings.faq_title }}</h2>
      <div class="wl__faq">
        {% for block in section.blocks %}{% if block.type == 'faq' %}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.q }}</summary>
          <p>{{ block.settings.a }}</p>
        </details>
        {% endif %}{% endfor %}
      </div>

      <!-- FINAL CTA -->
      <div class="wl__offer">
        <p class="wl__price">{% if section.settings.compare_price != blank %}<s>{{ section.settings.compare_price }}</s>{% endif %}<b>{{ section.settings.price }}</b></p>
        <a class="wl__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
        <p class="wl__reassure">{{ section.settings.reassure }}</p>
      </div>

      <div class="wl__disc">{{ section.settings.disclaimer }}</div>
      <div class="wl__foot">© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name }}. {{ section.settings.footer_note }}</div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dewy — Wrong Layer",
  "settings": [
    { "type": "header", "content": "Fonts" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n6" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" },

    { "type": "header", "content": "Masthead" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Dewy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Eye comfort, explained honestly" },

    { "type": "header", "content": "Headline & intro" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Your eye drops are treating the wrong layer" },
    { "type": "text", "id": "author", "label": "Author", "default": "The Dewy Team" },
    { "type": "text", "id": "byline_role", "label": "Byline role", "default": "Perimenopausal eye-comfort essentials" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "If your eyes feel gritty by mid-afternoon, sting at the screen, and somehow water for no reason — and every drop you've tried feels great for an hour and then fades — you're not doing anything wrong. You've just been handed the wrong tool for the actual problem. Here's what's really going on, because once you see it you can't un-see it." },
    { "type": "richtext", "id": "intro_body", "label": "Intro body", "default": "<p>Most people never get told this part, and it changes how you think about relief.</p>" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_caption", "label": "Hero caption" },

    { "type": "header", "content": "The three layers" },
    { "type": "text", "id": "layers_title", "label": "Section title", "default": "Your tears aren't one thing. They're three." },
    { "type": "richtext", "id": "layers_intro", "label": "Intro", "default": "<p>Most people picture tears as just water. They're not. A healthy tear film has three layers stacked on top of each other, and each one has a job:</p>" },
    { "type": "text", "id": "layer_oil_title", "label": "Oil layer title", "default": "The oil layer" },
    { "type": "text", "id": "layer_oil_desc", "label": "Oil layer desc", "default": "Made by tiny glands in your eyelids. Its job is to stop the tears underneath from evaporating. This is the layer that fails most." },
    { "type": "text", "id": "layer_water_title", "label": "Water layer title", "default": "The water layer" },
    { "type": "text", "id": "layer_water_desc", "label": "Water layer desc", "default": "The big wet middle layer. This is the part most eye drops top up." },
    { "type": "text", "id": "layer_mucin_title", "label": "Base layer title", "default": "The mucin layer" },
    { "type": "text", "id": "layer_mucin_desc", "label": "Base layer desc", "default": "The sticky base that helps everything spread evenly across your eye." },
    { "type": "textarea", "id": "layer_note", "label": "Punchline note", "default": "Here's the catch: most drops refill the WATER layer. But the layer that's usually failing is the OIL layer on top. That's why the relief washes out in an hour — you're topping up water that has nothing holding it in." },
    { "type": "textarea", "id": "pullquote", "label": "Pull quote", "default": "When the oil layer thins, your tears evaporate before they can do their job. More water doesn't fix a missing lid on the jar." },

    { "type": "header", "content": "Agitation" },
    { "type": "text", "id": "agitate_title", "label": "Title", "default": "Why the oil layer gives out — especially in your 40s and 50s" },
    { "type": "richtext", "id": "agitate_body", "label": "Body", "default": "<p>Those oil glands along your lash line slow down and clog as we age, and the hormonal shifts of perimenopause speed it up. The oil thickens, the glands block, and less of it reaches your tears. It's gradual, so you adapt — you blink harder, you reach for drops, you assume it's just screens or getting older.</p><p>It isn't in your head, and it isn't only age. It's a specific, well-understood mechanism. And the good news about a specific mechanism is that it has a specific first step.</p>" },

    { "type": "header", "content": "Mechanism (how Dewy helps)" },
    { "type": "text", "id": "mech_title", "label": "Title", "default": "What actually helps the oil layer" },
    { "type": "richtext", "id": "mech_intro", "label": "Intro", "default": "<p>You can't fix a thickened-oil problem with more water. You warm the oil so it flows again — which is exactly what Dewy is built to do.</p>" },
    { "type": "text", "id": "mech1_title", "label": "Point 1 title", "default": "Warmth where it counts" },
    { "type": "textarea", "id": "mech1_body", "label": "Point 1 body", "default": "Research indicates the eyelid needs to reach around 40°C to soften the thickened oils in the glands. Dewy holds a gentle, even warmth across the whole lid — not a flannel that's scalding then cold in 90 seconds." },
    { "type": "text", "id": "mech2_title", "label": "Point 2 title", "default": "A routine you'll actually keep" },
    { "type": "textarea", "id": "mech2_body", "label": "Point 2 body", "default": "Warm compresses fail people because a hot towel is a nuisance, so nobody keeps it up. Dewy is a 10-minute ritual you'll genuinely repeat — and consistency is the whole game here." },
    { "type": "text", "id": "mech3_title", "label": "Point 3 title", "default": "Reusable, soft, calming" },
    { "type": "textarea", "id": "mech3_body", "label": "Point 3 body", "default": "Washable and comfortable enough that it becomes the nice part of your evening instead of a chore. That's deliberate — comfort is what turns it into a habit." },
    { "type": "text", "id": "mech4_title", "label": "Point 4 title", "default": "Works with your drops, not instead of them" },
    { "type": "textarea", "id": "mech4_body", "label": "Point 4 body", "default": "Keep using whatever your optometrist recommends. Dewy addresses the oil layer those drops can't reach — the two do different jobs." },

    { "type": "header", "content": "Evidence (keep wording as-is)" },
    { "type": "text", "id": "evidence_title", "label": "Title", "default": "What the eye specialists actually say" },
    { "type": "richtext", "id": "evidence_body", "label": "Body", "default": "<p>We won't tell you Dewy is a cure, or that it beats anything your optometrist has given you — it isn't and it doesn't, and anyone who says that about a warm mask is being dishonest with you.</p><p>What's true: warm-compress and lid-warming therapy is recognised as a <strong>first-line</strong> approach for evaporative dry eye and meibomian gland dysfunction in the international TFOS DEWS II consensus, and is recommended by major eye-care bodies including the American Optometric Association and American Academy of Ophthalmology. Meibomian gland dysfunction — an oil-layer problem — is the leading cause of dry eye. A warm compress is simply one of the best-evidenced first things you can do at home, often used alongside professional care.</p><p>Not a miracle. Just the sensible, specialist-backed first step — done in a way you'll actually stick to.</p>" },

    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "price", "label": "Price", "default": "$24.89" },
    { "type": "text", "id": "compare_price", "label": "Compare-at (must be genuine)", "default": "$33.99" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the Cooling Gel Eye Mask" },
    { "type": "url", "id": "cta_url", "label": "Button link (product page)" },
    { "type": "text", "id": "reassure", "label": "Reassurance line", "default": "Shipping calculated at checkout · 30-day returns · One-time purchase, no subscription" },

    { "type": "header", "content": "Reviews" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews", "default": true },
    { "type": "text", "id": "reviews_title", "label": "Reviews title", "default": "What customers tell us" },

    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_title", "label": "FAQ title", "default": "Honest answers" },

    { "type": "header", "content": "Legal" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Dewy is a comfort product. It is not a medicine and is not intended to diagnose, treat, cure, or prevent any disease. This page is general educational information, not medical advice, and does not replace guidance from a qualified eye-care professional. If you have persistent, painful, or worsening symptoms, or any sudden change in vision, see an optometrist or doctor. Statements about warm-compress therapy describe the general approach as set out in published eye-care guidance, not results guaranteed from this product. Individual results vary." },
    { "type": "text", "id": "footer_note", "label": "Footer note", "default": "All rights reserved." }
  ],
  "blocks": [
    { "type": "review", "name": "Review (real only)",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Review text", "default": "[Replace with a real, consented customer review before publishing. Do not invent reviews.]" },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer name" }
      ]
    },
    { "type": "faq", "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "q", "label": "Question", "default": "Do I stop using my eye drops?" },
        { "type": "textarea", "id": "a", "label": "Answer", "default": "No. Keep using whatever your eye professional recommends. Dewy works on the oil layer, which is a different job. Many people use both." }
      ]
    }
  ],
  "presets": [
    { "name": "Dewy — Wrong Layer",
      "blocks": [
        { "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" },
        { "type": "faq" }, { "type": "faq" }, { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
