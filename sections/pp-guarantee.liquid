{% assign gradient_style = '' %}
{% if section.settings.gradient != blank %}
  {% assign gradient_style = 'background: ' | append: section.settings.gradient | append: ';' %}
{% endif %}

<div class="pp-section pp-guarantee-section page-width" style="{{ gradient_style }} padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px;">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'icon' -%}
        <div class="pp-guarantee-icon" style="color: {{ block.settings.icon_color }}; text-align: {{ block.settings.icon_alignment }};" {{ block.shopify_attributes }}>
          {%- case block.settings.icon_type -%}
            {%- when 'checkmark' or 'checkmark-circle' -%}
              <svg width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24" fill="none" style="margin: 0 auto;"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M8 12.5l2.5 2.5L16 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- else -%}
              <svg width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24" fill="none" style="margin: 0 auto;"><path d="M12 2l8 3v6c0 5-3.4 8.7-8 11-4.6-2.3-8-6-8-11V5l8-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {%- endcase -%}
        </div>
      {%- when 'heading' -%}
        <h2 class="{{ block.settings.heading_size }}" style="text-align: {{ block.settings.heading_alignment }}; color: {{ block.settings.heading_color }};" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
      {%- when 'text' -%}
        <div class="rte" style="text-align: {{ block.settings.text_alignment }}; color: {{ block.settings.text_color }};" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- when 'button' -%}
        <div style="text-align: {{ block.settings.button_alignment }};" {{ block.shopify_attributes }}>
          {%- if block.settings.button_link != blank -%}
            <a href="{{ block.settings.button_link }}" class="button" style="background: {{ block.settings.button_background_color }}; color: {{ block.settings.button_text_color }};">{{ block.settings.button_label }}</a>
          {%- endif -%}
          {%- if block.settings.button_subtext != blank -%}
            <p class="caption" style="color: {{ block.settings.button_subtext_color }};">{{ block.settings.button_subtext }}</p>
          {%- endif -%}
        </div>
    {%- endcase -%}
  {%- endfor -%}
</div>

<style>
  .pp-guarantee-section { text-align: center; max-width: 60rem; margin-left: auto; margin-right: auto; display: flex; flex-direction: column; gap: 1.2rem; align-items: center; }
</style>

{% schema %}
{
  "name": "PP - Guarantee",
  "settings": [
    { "type": "color_background", "id": "gradient", "label": "Background color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Bottom padding" },
    { "type": "range", "id": "margin_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Top margin" },
    { "type": "range", "id": "margin_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "label": "Bottom margin" }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon",
      "settings": [
        { "type": "select", "id": "icon_type", "options": [{"value":"shield","label":"Shield"},{"value":"checkmark","label":"Checkmark"},{"value":"checkmark-circle","label":"Checkmark circle"}], "default": "shield", "label": "Icon" },
        { "type": "range", "id": "icon_size", "min": 20, "max": 150, "step": 5, "unit": "px", "default": 65, "label": "Icon size" },
        { "type": "select", "id": "icon_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Alignment" },
        { "type": "select", "id": "icon_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
        { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#000000" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "default": "Peace of mind", "label": "Heading" },
        { "type": "select", "id": "heading_size", "options": [{"value":"h2","label":"Small"},{"value":"h1","label":"Medium"},{"value":"h0","label":"Large"}], "default": "h1", "label": "Heading size" },
        { "type": "select", "id": "heading_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Alignment" },
        { "type": "select", "id": "heading_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
        { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "default": "<p>Text</p>", "label": "Text" },
        { "type": "select", "id": "text_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "subtitle", "label": "Text size" },
        { "type": "select", "id": "text_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Alignment" },
        { "type": "select", "id": "text_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "button_label", "default": "Shop Now", "label": "Label" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "checkbox", "id": "button_link_newtab", "default": false, "label": "Open in new tab" },
        { "type": "color", "id": "button_text_color", "label": "Text color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_background_color", "label": "Background color", "default": "#000000" },
        { "type": "range", "id": "button_border_width", "min": 0, "max": 10, "step": 1, "unit": "px", "default": 0, "label": "Border width" },
        { "type": "color", "id": "button_border_color", "label": "Border color", "default": "#000000" },
        { "type": "select", "id": "button_width", "options": [{"value":"fit","label":"Fit"},{"value":"full","label":"Full"}], "default": "fit", "label": "Width" },
        { "type": "select", "id": "button_width_mobile", "options": [{"value":"fit","label":"Fit"},{"value":"full","label":"Full"}], "default": "full", "label": "Mobile width" },
        { "type": "select", "id": "button_alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Alignment" },
        { "type": "select", "id": "button_mobilealignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "center", "label": "Mobile alignment" },
        { "type": "select", "id": "button_rounded_corners", "options": [{"value":"none","label":"None"},{"value":"medium","label":"Medium"},{"value":"full","label":"Full"}], "default": "medium", "label": "Corners" },
        { "type": "range", "id": "button_padding_vertical", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 15, "label": "Vertical padding" },
        { "type": "range", "id": "button_padding_horizontal", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 15, "label": "Horizontal padding" },
        { "type": "text", "id": "button_subtext", "label": "Subtext" },
        { "type": "select", "id": "button_subtext_style", "options": [{"value":"body","label":"Small"},{"value":"subtitle","label":"Large"}], "default": "body", "label": "Subtext size" },
        { "type": "color", "id": "button_subtext_color", "label": "Subtext color", "default": "#000000" },
        { "type": "select", "id": "button_action", "options": [{"value":"link","label":"Link"},{"value":"scroll","label":"Scroll"}], "default": "link", "label": "Action" },
        { "type": "text", "id": "button_action_scroll_element", "label": "Scroll target" }
      ]
    }
  ],
  "presets": [
    { "name": "PP - Guarantee", "blocks": [{"type":"icon"},{"type":"heading"},{"type":"text"},{"type":"button"}] }
  ]
}
{% endschema %}
