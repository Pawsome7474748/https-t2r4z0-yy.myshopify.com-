{% comment %}
  Renders the cart drawer.

  Rebuilt as a self-contained drawer: its own markup, styles and JS. Quantity
  and remove go straight to /cart/change.js and the drawer repaints itself from
  the Section Rendering API, so nothing here depends on Dawn's cart.js or the
  quantity-popover behaviour that was swallowing the remove clicks.

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{%- comment -%} Add-on variants render as sub-rows under the shirts. {%- endcomment -%}
{%- assign ship_id = 49165504643242 -%}
{%- assign guar_id = 49165504708778 -%}

{%- assign shirt_count = 0 -%}
{%- for item in cart.items -%}
  {%- unless item.variant_id == ship_id or item.variant_id == guar_id -%}
    {%- assign shirt_count = shirt_count | plus: item.quantity -%}
  {%- endunless -%}
{%- endfor -%}

{%- assign ship_goal = 3 -%}
{%- assign ship_left = ship_goal | minus: shirt_count -%}
{%- assign ship_pct = shirt_count | times: 100 | divided_by: ship_goal -%}
{%- if ship_pct > 100 -%}{%- assign ship_pct = 100 -%}{%- endif -%}

<style>
  .drawer { visibility: hidden; }

  .shc{--shc-navy:#0A3161;--shc-red:#B31942;--shc-line:#E4E6EA;--shc-mute:#6B7280;
    display:flex;flex-direction:column;height:100%;font-weight:700;color:var(--shc-navy)}

  /* header */
  .shc__head{position:relative;display:flex;align-items:center;justify-content:center;
    padding:1.8rem 4.4rem;border-bottom:1px solid var(--shc-line);flex:0 0 auto}
  .shc__title{margin:0;font-size:2.4rem;font-weight:800;letter-spacing:-.01em}
  .shc__close{position:absolute;right:0;top:50%;transform:translateY(-50%);
    background:none;border:0;padding:1rem;cursor:pointer;color:var(--shc-navy);line-height:0}
  .shc__close svg{width:2.2rem;height:2.2rem}

  /* reservation timer */
  .shc-expiry{display:flex;align-items:center;justify-content:center;gap:.7rem;
    background:#FDF0F2;color:var(--shc-red);font-size:1.25rem;font-weight:800;
    padding:.9rem 1rem;flex:0 0 auto}
  .shc-expiry b{font-variant-numeric:tabular-nums;font-weight:800}
  .shc-expiry__dot{width:.9rem;height:.9rem;border-radius:50%;background:var(--shc-red);
    animation:shcPulse 1.4s ease-out infinite}
  @keyframes shcPulse{0%{box-shadow:0 0 0 0 rgba(179,25,66,.55)}100%{box-shadow:0 0 0 .9rem rgba(179,25,66,0)}}

  /* free shipping meter */
  .shc-ship{padding:1.4rem 0 1.6rem;flex:0 0 auto}
  .shc-ship__cap{text-align:center;font-size:1.35rem;font-weight:700;margin:0 0 .9rem}
  .shc-ship__cap b{font-weight:800}
  .shc-ship__track{position:relative;height:1rem;border-radius:999px;background:var(--shc-red)}
  .shc-ship__fill{position:absolute;inset:0 auto 0 0;border-radius:999px;
    background:linear-gradient(90deg,var(--shc-navy),#1D4ED8);transition:width .4s ease}
  .shc-ship__knob{position:absolute;top:50%;transform:translate(-50%,-50%);
    width:1.8rem;height:1.8rem;border-radius:50%;background:#fff;
    border:3px solid var(--shc-navy);transition:left .4s ease}
  .shc-ship.is-on .shc-ship__fill{background:linear-gradient(90deg,#1B8A4B,#22A85C)}
  .shc-ship.is-on .shc-ship__knob{border-color:#1B8A4B}
  .shc-ship.is-on .shc-ship__cap{color:#1B8A4B}
  .shc-ship__truck{display:flex;justify-content:flex-end;align-items:center;gap:.5rem;
    margin-top:.7rem;font-size:1.2rem;font-weight:800}
  .shc-ship__truck svg{width:2.2rem;height:2.2rem}

  /* items */
  .shc__items{flex:1 1 auto;overflow-y:auto;overflow-x:hidden;padding:.4rem 0 1.6rem}
  .shc-item{display:grid;grid-template-columns:8rem 1fr auto;gap:1.2rem;
    padding:1.6rem 0;border-bottom:1px solid var(--shc-line);align-items:start}
  .shc-item--sub{grid-template-columns:2rem 5.6rem 1fr auto;padding:1.2rem 0}
  .shc-item__arrow{color:var(--shc-mute);font-size:1.6rem;line-height:2.4rem}
  .shc-item__media img{width:100%;height:auto;border-radius:10px;border:1px solid var(--shc-line);display:block}
  .shc-item--sub .shc-item__media img{border-radius:10px;background:#fff}
  .shc-item__name{display:block;font-size:1.7rem;font-weight:800;line-height:1.25;
    color:var(--shc-navy);text-decoration:none}
  .shc-item--sub .shc-item__name{font-size:1.5rem}
  .shc-item__badge{display:inline-flex;align-items:center;gap:.5rem;margin-top:.7rem;
    background:var(--shc-navy);color:#fff;font-size:1.2rem;font-weight:800;
    padding:.45rem .9rem;border-radius:8px}
  .shc-item__badge svg{width:1.4rem;height:1.4rem}
  .shc-item__opts{margin:.7rem 0 0;font-size:1.25rem;font-weight:700;color:var(--shc-mute)}

  .shc-qty{display:inline-flex;align-items:center;margin-top:1rem;
    border:1px solid var(--shc-line);border-radius:10px;overflow:hidden;background:#fff}
  .shc-qty button{width:3.6rem;height:3.6rem;border:0;background:none;cursor:pointer;
    font-size:2rem;line-height:1;color:var(--shc-navy);font-weight:700;font-family:inherit}
  .shc-qty button:hover{background:#F4F4F4}
  .shc-qty button:disabled{opacity:.35;cursor:default}
  .shc-qty span{min-width:3.4rem;text-align:center;font-size:1.5rem;font-weight:800;
    font-variant-numeric:tabular-nums}

  .shc-item__right{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:.5rem}
  .shc-item__was{font-size:1.45rem;font-weight:700;color:var(--shc-red);text-decoration:line-through}
  .shc-item__now{font-size:1.8rem;font-weight:800}
  .shc-save{display:inline-flex;align-items:center;gap:.5rem;background:var(--shc-navy);
    color:#fff;font-size:1.2rem;font-weight:800;padding:.5rem .9rem;border-radius:8px}
  .shc-save svg{width:1.4rem;height:1.4rem}
  .shc-trash{border:0;background:none;padding:.6rem;cursor:pointer;color:var(--shc-navy);line-height:0}
  .shc-trash:hover{color:var(--shc-red)}
  .shc-trash svg{width:2rem;height:2rem}
  .shc-item.is-busy{opacity:.45;pointer-events:none}

  /* footer */
  .shc__foot{flex:0 0 auto;border-top:1px solid var(--shc-line);padding:1.6rem 0 2rem}
  .shc-disc{display:flex;align-items:center;gap:.8rem;font-size:1.4rem;margin:0 0 1.1rem}
  .shc-disc__pill{display:inline-flex;align-items:center;gap:.5rem;background:#EEF0F3;
    padding:.4rem .9rem;border-radius:8px;font-size:1.25rem;font-weight:800}
  .shc-disc__pill svg{width:1.4rem;height:1.4rem}
  .shc-disc__amt{margin-left:auto;font-weight:800}
  .shc-total{display:flex;align-items:baseline;gap:1rem;margin:0 0 1.4rem}
  .shc-total__cap{font-size:2rem;font-weight:800}
  .shc-total__was{margin-left:auto;font-size:1.6rem;font-weight:700;color:var(--shc-mute);
    text-decoration:line-through}
  .shc-total__now{font-size:2.2rem;font-weight:800}
  .shc-checkout{width:100%;display:flex;align-items:center;justify-content:center;gap:1rem;
    border:0;border-radius:12px;padding:1.8rem 2rem;font-family:inherit;font-size:1.7rem;
    font-weight:800;letter-spacing:.02em;cursor:pointer;
    color:{{ settings.cartdrawer_button_text_color | default: '#FFFFFF' }};
    background:{{ settings.cartdrawer_button_color | default: '#B31942' }};
    transition:filter .15s}
  .shc-checkout:hover{filter:brightness(1.08)}
  .shc-checkout:disabled{opacity:.5;cursor:default}
  .shc-checkout svg{width:1.8rem;height:1.8rem}
  .shc-continue{display:block;width:100%;margin:1.2rem 0 0;background:none;border:0;
    font-family:inherit;font-size:1.4rem;font-weight:800;color:var(--shc-navy);
    cursor:pointer;text-decoration:none;text-align:center}
  .shc-tax{display:block;text-align:center;font-size:1.15rem;font-weight:700;
    color:var(--shc-mute);margin-top:.9rem;line-height:1.4}
  .shc-pay{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;margin-top:1.2rem}
  .shc-pay svg,.shc-pay img{height:2.6rem;width:auto;border-radius:5px}

  /* express wallet buttons (Apple Pay, Shop Pay, Google Pay) */
  .shc-wallets{margin-top:1rem}
  .shc-wallets [data-shopify-buttoncontainer]{justify-content:center;gap:.8rem}

  .shc-note{margin:1rem 0 0;font-size:1.3rem;font-weight:800;color:var(--shc-red);text-align:center}

  @media (prefers-reduced-motion:reduce){
    .shc-expiry__dot{animation:none}
    .shc-ship__fill,.shc-ship__knob{transition:none}
  }
</style>

<cart-drawer class="pagepilot-layout drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="shc">
            <div class="shc__head">
              <h2 class="shc__title">Your cart</h2>
              <button class="shc__close drawer__close" type="button" data-shc-close aria-label="{{ 'accessibility.close' | t }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
              </button>
            </div>
            <div class="cart-drawer__warnings" style="padding:4rem 2rem;text-align:center">
              <h3 style="font-size:2rem;font-weight:800;margin:0 0 1.6rem">Your cart is empty</h3>
              <a href="{{ routes.all_products_collection_url }}" class="shc-checkout" style="text-decoration:none">
                Continue shopping
              </a>
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="shc">

          <div class="shc__head drawer__header">
            <h2 class="shc__title">My cart &bull; {{ cart.item_count }}</h2>
            <button class="shc__close drawer__close" type="button" data-shc-close aria-label="{{ 'accessibility.close' | t }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
            </button>
          </div>

          <div class="shc-expiry" data-shc-expiry hidden>
            <span class="shc-expiry__dot" aria-hidden="true"></span>
            <span>Cart reserved for <b data-shc-timer>2:00</b></span>
          </div>

          <div class="shc-ship{% if ship_left <= 0 %} is-on{% endif %}">
            <p class="shc-ship__cap">
              {%- if ship_left <= 0 -%}
                🎉 <b>Free shipping unlocked!</b>
              {%- else -%}
                Add <b>{{ ship_left }} more</b> {% if ship_left == 1 %}shirt{% else %}shirts{% endif %} to unlock <b>FREE shipping</b>
              {%- endif -%}
            </p>
            <div class="shc-ship__track">
              <span class="shc-ship__fill" style="width:{{ ship_pct }}%"></span>
              <span class="shc-ship__knob" style="left:{{ ship_pct }}%"></span>
            </div>
            <div class="shc-ship__truck">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M1 3h12v13H1zM13 8h4l4 4v4h-8z"/><circle cx="6" cy="19" r="2"/><circle cx="17" cy="19" r="2"/>
              </svg>
              <span>Free shipping</span>
            </div>
          </div>

          <div class="shc__items drawer__contents">
            {%- for item in cart.items -%}
              {%- if item.variant_id == ship_id or item.variant_id == guar_id -%}{%- continue -%}{%- endif -%}
              {%- assign saving = item.original_line_price | minus: item.final_line_price -%}
              <div class="shc-item" data-shc-line data-key="{{ item.key }}">
                <div class="shc-item__media">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="80" height="80" loading="lazy">
                  {%- endif -%}
                </div>
                <div class="shc-item__main">
                  <a class="shc-item__name" href="{{ item.url }}">{{ item.product.title }}</a>
                  {%- for alloc in item.line_level_discount_allocations -%}
                    <span class="shc-item__badge">
                      {%- render 'shc-tag' -%}{{ alloc.discount_application.title }}
                    </span>
                  {%- endfor -%}
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="shc-item__opts">
                      {%- for opt in item.options_with_values -%}
                        {{ opt.name }}: {{ opt.value }}{% unless forloop.last %} &middot; {% endunless %}
                      {%- endfor -%}
                    </p>
                  {%- endunless -%}
                  <div class="shc-qty">
                    <button type="button" data-shc-step="-1" aria-label="Decrease quantity">&minus;</button>
                    <span data-shc-qty>{{ item.quantity }}</span>
                    <button type="button" data-shc-step="1" aria-label="Increase quantity">+</button>
                  </div>
                </div>
                <div class="shc-item__right">
                  {%- if saving > 0 -%}
                    <s class="shc-item__was">{{ item.original_line_price | money }}</s>
                  {%- endif -%}
                  <span class="shc-item__now">{{ item.final_line_price | money }}</span>
                  {%- if saving > 0 -%}
                    <span class="shc-save">{%- render 'shc-tag' -%}You save {{ saving | money }}</span>
                  {%- endif -%}
                  <button type="button" class="shc-trash" data-shc-remove aria-label="Remove {{ item.title | escape }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/><path d="M10 11v6M14 11v6"/>
                    </svg>
                  </button>
                </div>
              </div>
            {%- endfor -%}

            {%- for item in cart.items -%}
              {%- unless item.variant_id == ship_id or item.variant_id == guar_id -%}{%- continue -%}{%- endunless -%}
              {%- assign saving = item.original_line_price | minus: item.final_line_price -%}
              <div class="shc-item shc-item--sub" data-shc-line data-key="{{ item.key }}">
                <span class="shc-item__arrow" aria-hidden="true">&#8627;</span>
                <div class="shc-item__media">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="56" height="56" loading="lazy">
                  {%- endif -%}
                </div>
                <div class="shc-item__main">
                  <span class="shc-item__name">{{ item.product.title }}</span>
                  <div class="shc-qty">
                    <button type="button" data-shc-step="-1" aria-label="Decrease quantity">&minus;</button>
                    <span data-shc-qty>{{ item.quantity }}</span>
                    <button type="button" data-shc-step="1" aria-label="Increase quantity">+</button>
                  </div>
                </div>
                <div class="shc-item__right">
                  {%- if saving > 0 -%}
                    <s class="shc-item__was">{{ item.original_line_price | money }}</s>
                  {%- endif -%}
                  <span class="shc-item__now">{{ item.final_line_price | money }}</span>
                  {%- if saving > 0 -%}
                    <span class="shc-save">{%- render 'shc-tag' -%}You save {{ saving | money }}</span>
                  {%- endif -%}
                  <button type="button" class="shc-trash" data-shc-remove aria-label="Remove {{ item.title | escape }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/><path d="M10 11v6M14 11v6"/>
                    </svg>
                  </button>
                </div>
              </div>
            {%- endfor -%}

            <p class="shc-note" data-shc-msg hidden></p>
          </div>

          <div class="shc__foot drawer__footer">
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for discount in cart.cart_level_discount_applications -%}
                <p class="shc-disc">
                  Discounts
                  <span class="shc-disc__pill">{%- render 'shc-tag' -%}{{ discount.title | escape }}</span>
                  <span class="shc-disc__amt">&minus;{{ discount.total_allocated_amount | money }}</span>
                </p>
              {%- endfor -%}
            {%- endif -%}

            <p class="shc-total">
              <span class="shc-total__cap">Subtotal</span>
              {%- if cart.original_total_price > cart.total_price -%}
                <s class="shc-total__was">{{ cart.original_total_price | money }}</s>
              {%- endif -%}
              <span class="shc-total__now">{{ cart.total_price | money }}</span>
            </p>

            <form action="{{ routes.cart_url }}" method="post" id="CartDrawer-Form">
              <button type="submit" name="checkout" class="shc-checkout" id="CartDrawer-Checkout">
                {%- if settings.cartdrawer_show_lockicon -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
                  </svg>
                {%- endif -%}
                {{ settings.cartdrawer_button_text | default: 'CONTINUE TO CHECKOUT' }} &bull; {{ cart.total_price | money }}
              </button>

              {%- comment -%} Apple Pay / Shop Pay / Google Pay express buttons. {%- endcomment -%}
              {%- if additional_checkout_buttons -%}
                <div class="shc-wallets additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
            </form>

            <button type="button" class="shc-continue" data-shc-close>continue shopping</button>

            <small class="shc-tax">Taxes included. Discounts and shipping calculated at checkout.</small>

            {%- if settings.cartdrawer_show_card_icons -%}
              <div class="shc-pay">
                {%- for type in shop.enabled_payment_types limit: 8 -%}
                  {{ type | payment_type_svg_tag: class: 'payment-icon' }}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>

<script>
(function () {
  if (window.__shcCart) return;
  window.__shcCart = true;

  var KEY = 'shc_cart_deadline';
  var SPAN = 2 * 60 * 1000;

  function root() {
    return (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
  }

  function store(k, v) {
    try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch (e) {}
  }
  function read(k) {
    try { return localStorage.getItem(k); } catch (e) { return null; }
  }

  function pick(html, selector) {
    if (!html) return null;
    var el = new DOMParser().parseFromString(html, 'text/html').querySelector(selector);
    return el ? el.innerHTML : null;
  }

  function paint(state) {
    var sections = state.sections || {};
    var box = document.querySelector('#CartDrawer');
    var html = pick(sections['cart-drawer'], '#CartDrawer');
    if (box && html !== null) box.innerHTML = html;

    var bubble = document.getElementById('cart-icon-bubble');
    var bubbleHtml = pick(sections['cart-icon-bubble'], '.shopify-section');
    if (bubble && bubbleHtml !== null) bubble.innerHTML = bubbleHtml;

    var drawer = document.querySelector('cart-drawer');
    if (drawer) drawer.classList.toggle('is-empty', state.item_count === 0);

    arm(state.item_count);
    tick();
  }

  // Every cart change restarts the two minute hold.
  function arm(count) {
    if (count > 0) store(KEY, String(Date.now() + SPAN));
    else store(KEY, null);
  }
  window.shcResetCartTimer = arm;

  function post(path, body) {
    return fetch(root() + path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/javascript' },
      body: JSON.stringify(Object.assign({ sections: ['cart-drawer', 'cart-icon-bubble'] }, body || {}))
    }).then(function (r) { return r.json(); });
  }

  function change(key, quantity, row) {
    if (row) row.classList.add('is-busy');
    return post('cart/change.js', { id: key, quantity: quantity })
      .then(function (state) {
        if (state.status) throw new Error(state.description || state.message);
        paint(state);
      })
      .catch(function (e) {
        if (row) row.classList.remove('is-busy');
        var msg = document.querySelector('[data-shc-msg]');
        if (msg) {
          msg.textContent = (e && e.message) || 'Could not update your cart. Please try again.';
          msg.hidden = false;
        }
      });
  }

  function closeDrawer() {
    var drawer = document.querySelector('cart-drawer');
    if (!drawer) return;
    if (typeof drawer.close === 'function') {
      try { drawer.close(); return; } catch (e) {}
    }
    drawer.classList.remove('active');
    document.body.classList.remove('overflow-hidden');
  }

  document.addEventListener('click', function (e) {
    if (!e.target.closest) return;

    if (e.target.closest('[data-shc-close]') || e.target.closest('#CartDrawer-Overlay')) {
      e.preventDefault();
      closeDrawer();
      return;
    }

    var row = e.target.closest('[data-shc-line]');
    if (!row) return;

    if (e.target.closest('[data-shc-remove]')) {
      e.preventDefault();
      change(row.getAttribute('data-key'), 0, row);
      return;
    }

    var step = e.target.closest('[data-shc-step]');
    if (step) {
      e.preventDefault();
      var cell = row.querySelector('[data-shc-qty]');
      var next = Number(cell ? cell.textContent : 0) + Number(step.getAttribute('data-shc-step'));
      if (next < 0) next = 0;
      change(row.getAttribute('data-key'), next, row);
    }
  });

  function pad(n) { return n < 10 ? '0' + n : String(n); }

  function expire() {
    store(KEY, null);
    post('cart/clear.js').then(function (state) {
      paint(state);
      closeDrawer();
    });
  }

  function tick() {
    var box = document.querySelector('[data-shc-expiry]');
    if (!box) return;
    var raw = read(KEY);
    if (!raw) { box.hidden = true; return; }

    var left = Number(raw) - Date.now();
    if (left <= 0) { box.hidden = true; expire(); return; }

    box.hidden = false;
    var out = box.querySelector('[data-shc-timer]');
    if (out) {
      var secs = Math.ceil(left / 1000);
      out.textContent = Math.floor(secs / 60) + ':' + pad(secs % 60);
    }
  }

  function boot() {
    // A cart that survived a page load still gets its full two minutes.
    if (document.querySelector('[data-shc-expiry]') && !read(KEY)) arm(1);
    tick();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setInterval(tick, 1000);
})();
</script>
