<style>
  :root{
    --sh-navy:#0A3161; --sh-red:#B31942; --sh-cream:#F7F3E8;
    --sh-gold:#FFC72C; --sh-green:#1B8A4B; --sh-ink:#0A3161;
  }
  .sh-toprow{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem 1.6rem;margin:0 0 1rem}
  .sh-orders{display:inline-flex;align-items:center;gap:.7rem;font-size:1.35rem;font-weight:700;color:var(--sh-navy)}
  .sh-avatars{display:flex}
  .sh-avatars span{width:2.4rem;height:2.4rem;border-radius:50%;background:var(--sh-navy);color:#fff;
    font-size:.95rem;font-weight:700;display:flex;align-items:center;justify-content:center;
    border:2px solid #fff;margin-left:-.7rem;letter-spacing:.02em}
  .sh-avatars span:first-child{margin-left:0}
  .sh-rating{display:inline-flex;align-items:center;gap:.5rem;font-size:1.3rem;color:var(--sh-navy)}
  .sh-stars{color:var(--sh-gold);letter-spacing:.1em;font-size:1.45rem;line-height:1}
  .sh-rating a{color:inherit;text-decoration:underline;text-underline-offset:2px}

  /* ---- price + savings ---- */
  .sh-save{display:inline-flex;align-items:center;gap:.6rem;background:var(--sh-red);color:#fff;
    font-weight:800;font-size:1.25rem;letter-spacing:.03em;padding:.45rem 1rem;border-radius:999px}
  .sh-priceline{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin:.2rem 0 1rem}

  /* ---- countdown ---- */
  .sh-timer{background:linear-gradient(90deg,var(--sh-navy),#12447F);color:#fff;border-radius:10px;
    padding:1.1rem 1.3rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin:0 0 1.2rem}
  .sh-timer__label{font-size:1.25rem;font-weight:700;line-height:1.3}
  .sh-timer__label small{display:block;font-weight:500;opacity:.85;font-size:1.1rem}
  .sh-timer__clock{margin-left:auto;display:flex;gap:.5rem}
  .sh-timer__unit{background:rgba(255,255,255,.14);border-radius:6px;padding:.5rem .7rem;text-align:center;min-width:4.4rem}
  .sh-timer__num{display:block;font-size:1.9rem;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
  .sh-timer__cap{display:block;font-size:.85rem;text-transform:uppercase;letter-spacing:.08em;opacity:.8;margin-top:.2rem}

  /* ---- stock alert ---- */
  .sh-stock{display:flex;align-items:center;gap:.75rem;font-size:1.3rem;font-weight:700;
    color:var(--sh-red);margin:0 0 1rem}
  .sh-dot{width:1rem;height:1rem;border-radius:50%;background:var(--sh-red);position:relative;flex:0 0 auto}
  .sh-dot:after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--sh-red);
    animation:shPulse 1.4s ease-out infinite}
  @keyframes shPulse{0%{transform:scale(1);opacity:.7}100%{transform:scale(2.6);opacity:0}}
  .sh-stock__bar{height:6px;border-radius:3px;background:rgba(179,25,66,.15);overflow:hidden;margin:.5rem 0 1.2rem}
  .sh-stock__fill{height:100%;width:17%;background:linear-gradient(90deg,var(--sh-red),#E0364F)}

  /* ---- bundle box ---- */
  .sh-bundle{display:flex;flex-direction:column;gap:.9rem;margin:1.4rem 0}
  .sh-bundle__head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem}
  .sh-bundle__title{font-size:1.35rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--sh-navy)}
  .sh-bundle__hint{font-size:1.15rem;color:var(--sh-red);font-weight:700}
  .sh-tier{position:relative;display:flex;align-items:center;gap:1.1rem;width:100%;text-align:left;
    border:2px solid rgba(10,49,97,.18);border-radius:10px;padding:1.25rem 1.3rem;background:#fff;
    cursor:pointer;font-family:inherit;font-size:1.4rem;transition:border-color .15s,box-shadow .15s}
  .sh-tier:hover{border-color:rgba(10,49,97,.45)}
  .sh-tier.is-on{border-color:var(--sh-red);box-shadow:0 0 0 3px rgba(179,25,66,.12);background:#FFF8F9}
  .sh-tier__radio{width:2rem;height:2rem;border-radius:50%;border:2px solid rgba(10,49,97,.35);flex:0 0 auto;position:relative}
  .sh-tier.is-on .sh-tier__radio{border-color:var(--sh-red)}
  .sh-tier.is-on .sh-tier__radio:after{content:"";position:absolute;inset:4px;border-radius:50%;background:var(--sh-red)}
  .sh-tier__main{flex:1;line-height:1.35}
  .sh-tier__name{font-weight:800;color:var(--sh-navy);display:block}
  .sh-tier__sub{font-size:1.15rem;opacity:.75;display:block}
  .sh-tier__right{text-align:right;white-space:nowrap;line-height:1.3}
  .sh-tier__now{font-weight:800;font-size:1.55rem;color:var(--sh-navy);display:block}
  .sh-tier__was{font-size:1.15rem;opacity:.6;text-decoration:line-through;display:block}
  .sh-tier__each{font-size:1.05rem;color:var(--sh-green);font-weight:700;display:block}
  .sh-tier__flag{position:absolute;top:-1rem;left:1.2rem;background:var(--sh-red);color:#fff;
    font-size:1rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:.25rem .75rem;border-radius:999px}
  .sh-tier__flag--best{background:var(--sh-green)}

  /* ---- delivery ---- */
  .sh-deliver{display:flex;align-items:flex-start;gap:.8rem;font-size:1.3rem;color:var(--sh-navy);
    background:var(--sh-cream);border-radius:10px;padding:1rem 1.2rem;margin:1.2rem 0}
  .sh-deliver b{color:var(--sh-red)}
  .sh-deliver__dot{width:.9rem;height:.9rem;border-radius:50%;background:var(--sh-green);margin-top:.45rem;flex:0 0 auto}

  /* ---- animated ATC ---- */
  .product-form__submit{position:relative;overflow:hidden;font-weight:800!important;letter-spacing:.04em;
    animation:shBeat 2.6s ease-in-out infinite}
  .product-form__submit:after{content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;
    background:linear-gradient(120deg,transparent,rgba(255,255,255,.45),transparent);
    animation:shShine 3.4s ease-in-out infinite}
  @keyframes shBeat{0%,88%,100%{transform:scale(1)}92%{transform:scale(1.025)}96%{transform:scale(1)}}
  @keyframes shShine{0%{left:-60%}55%,100%{left:120%}}
  @media (prefers-reduced-motion:reduce){
    .product-form__submit,.product-form__submit:after,.sh-dot:after{animation:none}
  }

  /* ---- trust row ---- */
  .sh-trust{margin:1.4rem 0 0}
  .sh-trust__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1.2rem}
  .sh-trust__item{text-align:center;font-size:1.1rem;line-height:1.35;color:var(--sh-navy)}
  .sh-trust__item span{display:block;font-size:2rem;margin-bottom:.25rem}
  .sh-trust__item b{display:block;font-weight:700}
  .sh-secure{text-align:center;border-top:1px solid rgba(10,49,97,.12);padding-top:1.1rem}
  .sh-secure__cap{font-size:1.1rem;opacity:.7;margin-bottom:.6rem;color:var(--sh-navy)}
  .sh-secure__icons{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem}
  .sh-secure__icons img,.sh-secure__icons svg{height:2.4rem;width:auto;border-radius:4px}
</style>

<div class="sh-toprow">
  <span class="sh-orders">
    <span class="sh-avatars"><span>CM</span><span>GT</span><span>AB</span><span>LT</span><span>MM</span></span>
    🔥 100+ orders in the last 24h
  </span>
  <span class="sh-rating">
    <span class="sh-stars">★★★★★</span>
    <strong>4.6</strong> · <a href="#sh-reviews">5 verified reviews</a>
  </span>
</div>

<style>.product-form__quantity{display:none!important}</style>
