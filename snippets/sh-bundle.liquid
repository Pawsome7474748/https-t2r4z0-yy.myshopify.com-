{%- assign v = product.selected_or_first_available_variant -%}
{%- assign p1 = v.price -%}
{%- assign p2 = v.price | times: 2 | times: 0.85 | round -%}
{%- assign p3 = v.price | times: 3 | times: 0.85 | round -%}
{%- assign w1 = v.compare_at_price | default: v.price -%}
{%- assign w2 = w1 | times: 2 -%}
{%- assign w3 = w1 | times: 3 -%}
{%- assign s1 = w1 | minus: p1 -%}
{%- assign s2 = w2 | minus: p2 -%}
{%- assign s3 = w3 | minus: p3 -%}
{%- assign pct1 = s1 | times: 100.0 | divided_by: w1 | round -%}
{%- assign pct2 = s2 | times: 100.0 | divided_by: w2 | round -%}
{%- assign pct3 = s3 | times: 100.0 | divided_by: w3 | round -%}

{%- capture size_options -%}
  {%- for variant in product.variants -%}
    {%- if variant.available -%}
      <option value="{{ variant.id }}">{{ variant.option2 | default: variant.title }}</option>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div class="shb" data-shb>

  {%- for tier in (1..3) -%}
    {%- case tier -%}
      {%- when 1 -%}
        {%- assign t_now = p1 -%}{%- assign t_was = w1 -%}{%- assign t_pct = pct1 -%}
        {%- assign t_flag = '' -%}{%- assign t_on = '' -%}
      {%- when 2 -%}
        {%- assign t_now = p2 -%}{%- assign t_was = w2 -%}{%- assign t_pct = pct2 -%}
        {%- assign t_flag = 'Most Popular' -%}{%- assign t_on = ' is-on' -%}
      {%- when 3 -%}
        {%- assign t_now = p3 -%}{%- assign t_was = w3 -%}{%- assign t_pct = pct3 -%}
        {%- capture t_flag -%}Best Value · Save {{ pct3 }}% + Free Shipping{%- endcapture -%}
        {%- assign t_on = '' -%}
    {%- endcase -%}

    <div class="shb-tier{{ t_on }}" role="button" tabindex="0" aria-pressed="{% if t_on != blank %}true{% else %}false{% endif %}" data-qty="{{ tier }}">
      {%- if t_flag != blank -%}
        <span class="shb-flag{% if tier == 3 %} shb-flag--best{% endif %}">{{ t_flag }}</span>
      {%- endif -%}

      <div class="shb-tier__top">
        <span class="shb-tier__radio"></span>
        <span class="shb-tier__name">Buy {{ tier }}</span>
        <span class="shb-tier__save">You save {{ t_pct }}%</span>
        <span class="shb-tier__prices">
          <span class="shb-tier__now">{{ t_now | money }}</span>
          <span class="shb-tier__was">{{ t_was | money }}</span>
        </span>
      </div>

      <div class="shb-tier__body">
        <span class="shb-tier__label">
          {%- if tier == 1 -%}Choose your size{%- else -%}Choose your sizes{%- endif -%}
        </span>
        {%- for i in (1..tier) -%}
          <div class="shb-row">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="48" height="48">
            {%- endif -%}
            <select class="shb-select" data-shb-size aria-label="Size for shirt {{ i }}">{{ size_options }}</select>
          </div>
        {%- endfor -%}

        <div class="shb-addons">
          <label class="shb-addon" for="ShbShip-{{ tier }}">
            <input type="checkbox" id="ShbShip-{{ tier }}" data-shb-addon="49165504643242" checked>
            <span class="shb-addon__icon" aria-hidden="true">📦</span>
            <span class="shb-addon__name">+ Shipping Protection</span>
            <span class="shb-addon__price">$6.95</span>
          </label>
          <label class="shb-addon" for="ShbGuar-{{ tier }}">
            <input type="checkbox" id="ShbGuar-{{ tier }}" data-shb-addon="49165504708778" checked>
            <span class="shb-addon__icon" aria-hidden="true">🛡️</span>
            <span class="shb-addon__name">+ 15-Day Money-Back Guarantee</span>
            <span class="shb-addon__price">$8.95</span>
          </label>
        </div>
      </div>
    </div>
  {%- endfor -%}

  <p class="shb-error" data-shb-error hidden></p>
</div>

<style>
  .shb-tier__body .shb-addons{margin:1.2rem -1.5rem -1.4rem;border-radius:0 0 10px 10px;overflow:hidden}
  .shb-tier__body .shb-addon:first-child{border-radius:0}
  .shb-tier__body .shb-addon:last-child{border-radius:0 0 10px 10px}
  .shb-tier:focus-visible{outline:3px solid var(--sh-blue);outline-offset:2px}
</style>

<script>
(function () {
  var root = document.querySelector('[data-shb]');
  if (!root) return;
  var tiers = root.querySelectorAll('.shb-tier');
  var err = root.querySelector('[data-shb-error]');

  function select(tier) {
    tiers.forEach(function (t) {
      t.classList.remove('is-on');
      t.setAttribute('aria-pressed', 'false');
    });
    tier.classList.add('is-on');
    tier.setAttribute('aria-pressed', 'true');
  }

  tiers.forEach(function (tier) {
    tier.addEventListener('click', function (e) {
      // Let the size dropdowns and the add-on checkboxes work on their own.
      if (e.target.closest('select') || e.target.closest('.shb-addon')) return;
      select(tier);
    });
    tier.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      if (e.target.closest('select') || e.target.closest('.shb-addon')) return;
      e.preventDefault();
      select(tier);
    });
  });

  function activeTier() { return root.querySelector('.shb-tier.is-on'); }

  function shirtItems() {
    var tier = activeTier();
    if (!tier) return [];
    var counts = {};
    tier.querySelectorAll('[data-shb-size]').forEach(function (sel) {
      counts[sel.value] = (counts[sel.value] || 0) + 1;
    });
    return Object.keys(counts).map(function (id) {
      return { id: Number(id), quantity: counts[id] };
    });
  }

  function addonItems() {
    var tier = activeTier();
    if (!tier) return [];
    var items = [];
    // Only the selected tier's add-on checkboxes count.
    tier.querySelectorAll('[data-shb-addon]').forEach(function (cb) {
      if (cb.checked) items.push({ id: Number(cb.getAttribute('data-shb-addon')), quantity: 1 });
    });
    return items;
  }

  function sectionsToRender() {
    var drawer = document.querySelector('cart-drawer');
    if (drawer && drawer.getSectionsToRender) {
      return drawer.getSectionsToRender().map(function (s) { return s.id; });
    }
    return ['cart-drawer', 'cart-icon-bubble'];
  }

  function cartRoot() {
    return (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
  }

  function post(items) {
    return fetch(cartRoot() + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/javascript' },
      body: JSON.stringify({ items: items, sections: sectionsToRender() })
    }).then(function (r) { return r.json(); });
  }

  function show(state) {
    var drawer = document.querySelector('cart-drawer');
    if (drawer && drawer.renderContents) {
      drawer.renderContents(state);
    } else {
      window.location = cartRoot() + 'cart';
    }
  }

  function addToCart(btn) {
    var shirts = shirtItems();
    if (!shirts.length) return;
    var addons = addonItems();

    btn.setAttribute('aria-busy', 'true');
    btn.classList.add('is-loading');
    if (err) { err.hidden = true; err.textContent = ''; }

    post(shirts.concat(addons))
      .then(function (state) {
        if (!state.status) return show(state);
        // /cart/add.js is all-or-nothing, so one unavailable add-on would
        // otherwise block the shirts. Fall back to the shirts alone.
        if (!addons.length) throw new Error(state.description || state.message);
        return post(shirts).then(function (retry) {
          if (retry.status) throw new Error(retry.description || retry.message);
          show(retry);
          if (err) {
            err.textContent = 'Added, but the extras are unavailable right now.';
            err.hidden = false;
          }
        });
      })
      .catch(function (e) {
        if (err) {
          err.textContent = (e && e.message) || 'Something went wrong. Please try again.';
          err.hidden = false;
        }
      })
      .finally(function () {
        btn.removeAttribute('aria-busy');
        btn.classList.remove('is-loading');
      });
  }

  function hook() {
    var btn = document.querySelector('.product-form__submit');
    if (!btn || btn.dataset.shbHooked) return;
    btn.dataset.shbHooked = '1';
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      addToCart(btn);
    }, true);
  }
  hook();
  document.addEventListener('DOMContentLoaded', hook);
})();
</script>
