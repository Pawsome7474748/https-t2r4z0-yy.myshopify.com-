{%- assign now_s = 'now' | date: '%s' | plus: 0 -%}
{%- assign ready_a = now_s | plus: 86400 -%}
{%- assign ready_b = now_s | plus: 172800 -%}
{%- assign del_a = now_s | plus: 864000 -%}
{%- assign del_b = now_s | plus: 1296000 -%}

<div class="sh-tl">
  <div class="sh-tl__step">
    <span class="sh-tl__dot">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/>
      </svg>
    </span>
    <span class="sh-tl__date">{{ now_s | date: '%b %-d' }}</span>
    <span class="sh-tl__cap">Ordered</span>
  </div>

  <div class="sh-tl__step">
    <span class="sh-tl__dot">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7z"/>
        <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
      </svg>
    </span>
    <span class="sh-tl__date">{{ ready_a | date: '%b %-d' }} – {{ ready_b | date: '%b %-d' }}</span>
    <span class="sh-tl__cap">Order Ready</span>
  </div>

  <div class="sh-tl__step">
    <span class="sh-tl__dot">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/>
        <line x1="12" y1="22" x2="12" y2="7"/>
        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
      </svg>
    </span>
    <span class="sh-tl__date">{{ del_a | date: '%b %-d' }} – {{ del_b | date: '%b %-d' }}</span>
    <span class="sh-tl__cap">Delivered</span>
  </div>
</div>
