    "symptoms": {
      "type": "pp-image-with-benefits",
      "blocks": {
        "benefit_1": {
          "type": "benefit",
          "settings": {
            "emoji": "😖",
            "emoji_size": "medium",
            "heading": "That gritty, burning feeling",
            "heading_size": "h2",
            "heading_color": "#14312d",
            "text": "<p>Like sand in your eyes that won't go away — often worse by mid-afternoon, sometimes bad enough to make you want to close your eyes and just not open them for a while.</p>",
            "text_style": "subtitle",
            "text_color": "#3f5854"
          }
        },
        "benefit_2": {
          "type": "benefit",
          "settings": {
            "emoji": "📱",
            "emoji_size": "medium",
            "heading": "Screens make it so much worse",
            "heading_size": "h2",
            "heading_color": "#14312d",
            "text": "<p>Every scroll and every email dries your eyes out faster and blurs your focus.</p>",
            "text_style": "subtitle",
            "text_color": "#3f5854"
          }
        },
        "benefit_3": {
          "type": "benefit",
          "settings": {
            "emoji": "😴",
            "emoji_size": "medium",
            "heading": "Waking up already dry",
            "heading_size": "h2",
            "heading_color": "#14312d",
            "text": "<p>Tear production naturally dips overnight — for many women in perimenopause, that dip runs deeper.</p>",
            "text_style": "subtitle",
            "text_color": "#3f5854"
          }
        },
        "benefit_4": {
          "type": "benefit",
          "settings": {
            "emoji": "🪞",
            "emoji_size": "medium",
            "heading": "Looking more tired than you feel",
            "heading_size": "h2",
            "heading_color": "#14312d",
            "text": "<p>Red, glassy, puffy-looking eyes can make you look — and feel — exhausted, even on a good day.</p>",
            "text_style": "subtitle",
            "text_color": "#3f5854"
          }
        }
      },
      "block_order": ["benefit_1", "benefit_2", "benefit_3", "benefit_4"],
