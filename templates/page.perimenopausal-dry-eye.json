    "solution_intro": {
      "type": "pp-image-with-text",
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "heading": "Two Simple, Real Things That Can Help",
            "heading_size": "h0",
            "heading_alignment": "left",
            "heading_mobilealignment": "center",
            "heading_color": "#14312d"
          }
        },
        "text_1": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Omega-3 fatty acids</strong> are one of the most studied nutritional supports for the oil layer of your tear film — the exact layer perimenopause disrupts.</p><p>And when your eyes need relief right now, not in a few weeks, a <strong>cooling gel compress</strong> calms puffiness, soothes irritation, and just plain feels good in the moment.</p><p>Neither one is a miracle cure, and we won't pretend otherwise. But together, they're a real, honest way to support your eyes while your body moves through this transition. Build your own comfort bundle below and save more the more you add.</p>",
            "text_style": "subtitle",
            "text_alignment": "left",
            "text_mobilealignment": "left",
            "text_color": "#3f5854"
          }
        }
      },
      "block_order": ["heading_1", "text_1"],
