    "hero_intro": {
      "type": "pp-guarantee",
      "blocks": {
        "icon_1": {
          "type": "icon",
          "settings": {
            "icon_type": "heart",
            "icon_size": 48,
            "icon_alignment": "center",
            "icon_mobilealignment": "center",
            "icon_color": "#2a7a72"
