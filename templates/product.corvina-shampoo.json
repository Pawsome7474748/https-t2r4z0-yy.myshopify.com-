          "type": "faq",
          "settings": {
            "question": "How do I use it?",
            "answer": "<p>Apply to wet hair, massage into a lather, leave for a few minutes, then rinse. Repeat with each wash until you reach your desired shade, then use as needed to maintain it.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Is this a substitute for medical advice?",
            "answer": "<p>No. This is a cosmetic hair colour product and doesn't diagnose or treat any condition. If you have scalp irritation or a known allergy, please check with a doctor before use.</p>"
