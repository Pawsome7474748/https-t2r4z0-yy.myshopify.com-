    "pp_faq_shirt01": {
      "type": "pp-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "heading": "Is it actually 3D printed, or just an iron-on sticker?",
            "heading_size": "h3",
            "heading_color": "#0A3161",
            "text": "<p>Printed straight into the fabric with a high-definition process &mdash; not a transfer sitting on top. That's why it doesn't crack or peel like the cheap ones do.</p>",
            "text_style": "body",
            "text_color": "#0A3161"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "heading": "Will people really think it's real?",
            "heading_size": "h3",
            "heading_color": "#0A3161",
            "text": "<p>From across a room or in a photo, most people do a double-take. Up close it's obviously a print &mdash; that's the joke, and that's when the laughing starts.</p>",
            "text_style": "body",
            "text_color": "#0A3161"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "heading": "What size should I order?",
            "heading_size": "h3",
            "heading_color": "#0A3161",
            "text": "<p>We run XXS to 6XL. Order your usual size for a normal fit. If you're between sizes or want it looser, size up &mdash; a closer fit shows the illusion off best.</p>",
            "text_style": "body",
            "text_color": "#0A3161"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "heading": "How do I wash it?",
            "heading_size": "h3",
            "heading_color": "#0A3161",
            "text": "<p>Machine wash cold, inside out, tumble dry low. Don't iron directly on the print. That's it.</p>",
            "text_style": "body",
            "text_color": "#0A3161"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "heading": "How long does shipping take?",
            "heading_size": "h3",
            "heading_color": "#0A3161",
            "text": "<p>We dispatch within 24 hours and delivery lands 10&ndash;15 days from your order, tracked the whole way.</p>",
            "text_style": "body",
            "text_color": "#0A3161"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "heading": "What if I don't like it?",
            "heading_size": "h3",
            "heading_color": "#0A3161",
            "text": "<p>Add the 15-Day Money-Back Guarantee at checkout and you can send it back within 15 days of delivery for a full refund. No forms, no questions.</p>",
            "text_style": "body",
            "text_color": "#0A3161"
          }
        }
      },
