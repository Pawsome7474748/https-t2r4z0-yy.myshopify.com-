p Pack</span>\n      <span class=\"sh-tier__sub\">Three designs, free shipping</span>\n    </span>\n    <span class=\"sh-tier__right\">\n      <span class=\"sh-tier__now\">{{ p3 | money }}</span>\n      <span class=\"sh-tier__was\">{{ w3 | money }}</span>\n      <span class=\"sh-tier__each\">{{ e3 | money }} each</span>\n    </span>\n  </button>\n</div>\n\n<script>\n(function(){\n  var tiers=document.querySelectorAll('.sh-tier');\n  var qty=document.getElementById('Quantity-{{ section.id }}');\n  if(!tiers.length)return;\n  tiers.forEach(function(t){\n    t.addEventListener('click',function(){\n      tiers.forEach(function(x){x.classList.remove('is-on')});\n      t.classList.add('is-on');\n      if(qty){qty.value=t.getAttribute('data-sh-qty');qty.dispatchEvent(new Event('change',{bubbles:true}));}\n    });\n  });\n  if(qty){qty.value='2';qty.dispatchEvent(new Event('change',{bubbles:true}));}\n})();\n</script>\n"
