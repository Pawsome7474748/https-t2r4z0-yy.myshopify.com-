          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign v = product.selected_or_first_available_variant -%}\n{%- if v.compare_at_price > v.price -%}\n  {%- assign saved = v.compare_at_price | minus: v.price -%}\n  {%- assign pct = saved | times: 100.0 | divided_by: v.compare_at_price | round -%}\n  <div class=\"sh-priceline\">\n    <span class=\"sh-save\">SAVE {{ saved | money }} · {{ pct }}% OFF</span>\n  </div>\n{%- endif -%}\n\n<div class=\"sh-timer\" data-sh-timer>\n  <div class=\"sh-timer__label\">\n    ⚡ Launch offer ends in\n    <small>Price returns to {{ v.compare_at_price | money }} when the timer hits zero</small>\n  </div>\n  <div class=\"sh-timer__clock\">\n    <div class=\"sh-timer__unit\"><span class=\"sh-timer__num\" data-sh-h>--</span><span class=\"sh-timer__cap\">Hrs</span></div>\n    <div class=\"sh-timer__unit\"><span class=\"sh-timer__num\" data-sh-m>--</span><span class=\"sh-timer__cap\">Min</span></div>\n    <div class=\"sh-timer__unit\"><span class=\"sh-timer__num\" data-sh-s>--</span><span class=\"sh-timer__cap\">Sec</span></div>\n  </div>\n</div>\n\n<script>\n(function(){\n  var KEY='sh_offer_deadline', WINDOW=24*60*60*1000;\n  function read(){try{return parseInt(localStorage.getItem(KEY),10)||0}catch(e){return 0}}\n  function write(v){try{localStorage.setItem(KEY,String(v))}catch(e){}}\n  function deadline(){\n    var d=read();\n    if(!d||d<=Date.now()){d=Date.now()+WINDOW;write(d);}\n    return d;\n  }\n  var end=deadline();\n  var root=document.querySelector('[data-sh-timer]');\n  if(!root)return;\n  var h=root.querySelector('[data-sh-h]'),m=root.querySelector('[data-sh-m]'),s=root.querySelector('[data-sh-s]');\n  function pad(n){return n<10?'0'+n:''+n}\n  function tick(){\n    var left=end-Date.now();\n    if(left<=0){end=Date.now()+WINDOW;write(end);left=WINDOW;}\n    var t=Math.floor(left/1000);\n    h.textContent=pad(Math.floor(t/3600));\n    m.textContent=pad(Math.floor(t%3600/60));\n    s.textContent=pad(t%60);\n  }\n  tick();setInterval(tick,1000);\n})();\n</script>\n\n<div class=\"sh-stock\">\n  <span class=\"sh-dot\"></span>\n  Almost out of stock — selling fast in this design\n</div>\n<div class=\"sh-stock__bar\"><div class=\"sh-stock__fill\"></div></div>\n"
