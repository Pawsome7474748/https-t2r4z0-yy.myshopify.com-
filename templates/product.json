te;inset:4px;border-radius:50%;background:var(--sh-red)}\n  .sh-tier__main{flex:1;line-height:1.35}\n  .sh-tier__name{font-weight:800;color:var(--sh-navy);display:block}\n  .sh-tier__sub{font-size:1.15rem;opacity:.75;display:block}\n  .sh-tier__right{text-align:right;white-space:nowrap;line-height:1.3}\n  .sh-tier__now{font-weight:800;font-size:1.55rem;color:var(--sh-navy);display:block}\n  .sh-tier__was{font-size:1.15rem;opacity:.6;text-decoration:line-through;display:block}\n  .sh-tier__each{font-size:1.05rem;color:var(--sh-green);font-weight:700;display:block}\n  .sh-tier__flag{position:absolute;top:-1rem;left:1.2rem;background:var(--sh-red);color:#fff;\n    font-size:1rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:.25rem .75rem;border-radius:999px}\n  .sh-tier__flag--best{background:var(--sh-green)}\n\n  /* ---- delivery ---- */\n  .sh-deliver{display:flex;align-items:flex-start;gap:.8rem;font-size:1.3rem;color:var(--sh-navy);\n    background:var(--sh-cream);border-radius:10px;padding:1rem 1.2rem;margin:1.2rem 0}\n  .sh-deliver b{color:var(--sh-red)}\n  .sh-deliver__dot{width:.9rem;height:.9rem;border-radius:50%;background:var(--sh-green);margin-top:.45rem;flex:0 0 auto}\n\n  /* ---- animated ATC ---- */\n  .product-form__submit{position:relative;overflow:hidden;font-weight:800!important;letter-spacing:.04em;\n    animation:shBeat 2.6s ease-in-out infinite}\n  .product-form__submit:after{content:\"\";position:absolute;top:0;left:-60%;width:40%;height:100%;\n    background:linear-gradient(120deg,transparent,rgba(255,255,255,.45),transparent);\n    animation:shShine 3.4s ease-in-out infinite}\n  @keyframes shBeat{0%,88%,100%{transform:scale(1)}92%{transform:scale(1.025)}96%{transform:scale(1)}}\n  @keyframes shShine{0%{left:-60%}55%,100%{left:120%}}\n  @media (prefers-reduced-motion:reduce){\n    .product-form__submit,.product-form__submit:after,.sh-dot:after{animation:none}\n  }\n\n  /* ---- trust row ---- */\n  .sh-trust{margin:1.4rem 