            "custom_liquid": "<div class=\"bundle-box\">\n  <button type=\"button\" class=\"bundle-box__tier is-selected\" data-bundle-qty=\"1\">\n    <span class=\"bundle-box__radio\"></span>\n    <span class=\"bundle-box__label\"><strong>Buy One</strong><br><span class=\"bundle-box__sub\">Single tee</span></span>\n    <span class=\"bundle-box__price\">{{ product.selected_or_first_available_variant.price | money }}</span>\n  </button>\n  <button type=\"button\" class=\"bundle-box__tier bundle-box__tier--highlight\" data-bundle-qty=\"2\">\n    <span class=\"bundle-box__badge\">Save 15%</span>\n    <span class=\"bundle-box__radio\"></span>\n    <span class=\"bundle-box__label\"><strong>Buy Two</strong><br><span class=\"bundle-box__sub\">Mix and match designs</span></span>\n    <span class=\"bundle-box__price\">{{ product.selected_or_first_available_variant.price | times: 2 | times: 0.85 | money }}</span>\n  </button>\n  <button type=\"button\" class=\"bundle-box__tier\" data-bundle-qty=\"3\">\n    <span class=\"bundle-box__badge bundle-box__badge--best\">Best Value</span>\n    <span class=\"bundle-box__radio\"></span>\n    <span class=\"bundle-box__label\"><strong>Buy Three</strong><br><span class=\"bundle-box__sub\">Save 15%, mix and match</span></span>\n    <span class=\"bundle-box__price\">{{ product.selected_or_first_available_variant.price | times: 3 | times: 0.85 | money }}</span>\n  </button>\n</div>\n<style>\n  .bundle-box { display: flex; flex-direction: column; gap: 0.8rem; margin: 1.2rem 0; }\n  .bundle-box__tier {\n    display: flex; align-items: center; gap: 1.2rem;\n    width: 100%; text-align: left; position: relative;\n    border: 1px solid rgba(22,33,62,0.2); border-radius: 8px;\n    padding: 1.2rem 1.4rem; background: rgb(var(--color-background));\n    cursor: pointer; font-family: inherit; font-size: 1.4rem;\n  }\n  .bundle-box__tier.is-selected { border-color: #A6293D; border-width: 2px; background: rgba(166,41,61,0.04); }\n  .bundle-box__tier--highlight { border-color: rgba(166,41,61,0.4); }\n  .bundle-box__radio {\n    width: 1.8rem; height: 1.8rem; border-radius: 50%;\n    border: 2px solid rgba(22,33,62,0.35); flex-shrink: 0; position: relative;\n  }\n  .bundle-box__tier.is-selected .bundle-box__radio { border-color: #A6293D; }\n  .bundle-box__tier.is-selected .bundle-box__radio:after {\n    content: ''; position: absolute; inset: 3px; border-radius: 50%; background: #A6293D;\n  }\n  .bundle-box__label { flex: 1; line-height: 1.4; }\n  .bundle-box__sub { font-size: 1.2rem; opacity: 0.7; }\n  .bundle-box__price { font-weight: 700; white-space: nowrap; }\n  .bundle-box__badge {\n    position: absolute; top: -0.9rem; left: 1.2rem;\n    background: #A6293D; color: #fff; font-size: 1.05rem; font-weight: 700;\n    padding: 0.2rem 0.8rem; border-radius: 999px; letter-spacing: 0.02em;\n  }\n</style>\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var tiers = document.querySelectorAll('.bundle-box__tier');\n    var qtyInput = document.getElementById('Quantity-{{ section.id }}');\n    if (!qtyInput) return;\n    tiers.forEach(function (tier) {\n      tier.addEventListener('click', function () {\n        tiers.forEach(function (t) { t.classList.remove('is-selected'); });\n        tier.classList.add('is-selected');\n        qtyInput.value = tier.getAttribute('data-bundle-qty');\n        qtyInput.dispatchEvent(new Event('change', { bubbles: true }));\n      });\n    });\n  });\n</script>"
