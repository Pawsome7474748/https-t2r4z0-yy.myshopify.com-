    "pp_faq_shirt01": {
      "type": "pp-faq",
      "blocks": {
        "question_UUEbPG": {
          "type": "question",
          "settings": {
            "heading": "Is the design actually 3D printed, or is it an iron-on sticker?",
            "heading_size": "h3",
            "heading_color": "#16213E",
            "text": "<p>It's printed directly into the fabric with a high-definition 3D print process, not a transfer stuck on top. That's why it doesn't crack or peel in the wash the way iron-on tees do.</p>",
            "text_style": "body",
            "text_color": "#16213E"
          }
        },
        "question_iwgzRn": {
          "type": "question",
          "settings": {
            "heading": "What sizes do you carry?",
            "heading_size": "h3",
            "heading_color": "#16213E",
            "text": "<p>XXS through 6XL. If you're between sizes, or want a more relaxed fit, size up &mdash; a closer fit shows the illusion print off best.</p>",
            "text_style": "body",
            "text_color": "#16213E"
          }
        },
        "question_gNmdPq": {
          "type": "question",
          "settings": {
            "heading": "Can I mix designs in one order?",
            "heading_size": "h3",
            "heading_color": "#16213E",
            "text": "<p>Yes. There are 6 designs, and the Buy Two and Buy Three bundles let you pick a different design for each shirt.</p>",
            "text_style": "body",
            "text_color": "#16213E"
          }
        },
        "question_NpRfRa": {
          "type": "question",
          "settings": {
            "heading": "How do I wash it without damaging the print?",
            "heading_size": "h3",
            "heading_color": "#16213E",
            "text": "<p>Machine wash cold, inside out, tumble dry low. Avoid ironing directly on the print.</p>",
            "text_style": "body",
            "text_color": "#16213E"
          }
        },
        "question_cwFiY9": {
          "type": "question",
          "settings": {
            "heading": "What if I'm not happy with it?",
            "heading_size": "h3",
            "heading_color": "#16213E",
            "text": "<p>You've got 15 days from delivery to send it back for a full refund, no questions asked.</p>",
            "text_style": "body",
            "text_color": "#16213E"
          }
        }
      },
