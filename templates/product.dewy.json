        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "How does Omega-3 support eye comfort?",
            "answer": "<p>Perimenopause can disrupt the oily layer of your tear film. Omega-3 fatty acids (EPA & DHA) are among the most studied nutrients for supporting that layer and overall tear quality, alongside heart and brain health.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "How do I take it?",
            "answer": "<p>2 capsules daily, ideally with a meal and plenty of water.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Is this a substitute for medical advice?",
            "answer": "<p>No. This supports day-to-day comfort but doesn't diagnose or treat any condition. If your symptoms are severe or sudden, please see a doctor or eye care professional.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "How should I store it?",
            "answer": "<p>Keep in a cool, dry place away from direct sunlight and heat. Reseal the bottle tightly after each use.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "Is it safe to take with medication or if I'm pregnant or nursing?",
            "answer": "<p>If you're pregnant, nursing, taking medication (especially blood thinners), or have a medical condition, please check with your doctor before starting any new supplement.</p>"
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "question": "How long before I notice a difference?",
