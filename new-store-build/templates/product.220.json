        "pp_rating": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign r = product.metafields.reviews.rating.value -%}\n{%- if r != blank and r.rating > 0 -%}\n  {%- assign rounded = r.rating | round -%}\n  <div class=\"pp-rating\">\n    <span class=\"pp-rating__stars\" aria-hidden=\"true\">\n      {%- for i in (1..5) -%}{%- if i <= rounded -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}\n    </span>\n    <span>Rated {{ r.rating }} out of {{ r.scale_max }}\n      {%- assign c = product.metafields.reviews.rating_count -%}\n      {%- if c > 0 %} · {{ c }} review{% if c != 1 %}s{% endif %}{% endif -%}\n    </span>\n  </div>\n{%- endif -%}"
          }
        },
        "pp_stock_meter": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"pp-stock\" id=\"pp-stock-{{ section.id }}\" role=\"status\" hidden>\n  <div class=\"pp-stock__bar\"><span class=\"pp-stock__fill\" style=\"width:0%\"></span></div>\n  <span class=\"pp-stock__label\"></span>\n</div>"
          }
