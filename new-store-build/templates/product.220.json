        "pp_ui": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{{ 'pp-ligne.css' | asset_url | stylesheet_tag }}\n<div id=\"pp-ligne\" data-section=\"{{ section.id }}\" hidden></div>\n<script type=\"application/json\" id=\"pp-variants-{{ section.id }}\">\n{%- capture pp_vmap -%}\n{%- for v in product.variants -%}\n{%- assign q = 1 -%}\n{%- if v.option2 contains '3' -%}{%- assign q = 3 -%}{%- elsif v.option2 contains '2' -%}{%- assign q = 2 -%}{%- endif -%}\n\"{{ v.id }}\":{\"q\":{{ q }},\"s\":{{ v.option1 | json }},\"st\":{{ v.inventory_quantity | default: 0 }}}{%- unless forloop.last -%},{%- endunless -%}\n{%- endfor -%}\n{%- endcapture -%}\n{ {{- pp_vmap -}} }\n</script>\n<script src=\"{{ 'pp-ligne.js' | asset_url }}\" defer></script>"
          }
        },
        "pp_rating": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign r = product.metafields.reviews.rating.value -%}\n{%- if r != blank and r.rating > 0 -%}\n  {%- assign rounded = r.rating | round -%}\n  <div class=\"pp-rating\">\n    <span class=\"pp-rating__stars\" aria-hidden=\"true\">\n      {%- for i in (1..5) -%}{%- if i <= rounded -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}\n    </span>\n    <span>Rated {{ r.rating }} out of {{ r.scale_max }}\n      {%- assign c = product.metafields.reviews.rating_count -%}\n      {%- if c > 0 %} · {{ c }} review{% if c != 1 %}s{% endif %}{% endif -%}\n    </span>\n  </div>\n{%- endif -%}"
          }
        },
        "pp_stock_meter": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"pp-stock\" id=\"pp-stock-{{ section.id }}\" role=\"status\" hidden>\n  <div class=\"pp-stock__bar\"><span class=\"pp-stock__fill\" style=\"width:0%\"></span></div>\n  <span class=\"pp-stock__label\"></span>\n</div>"
          }
        },
        "pp_bundles": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- liquid\n  assign pack_pos = 0\n  assign shade_pos = 0\n  for o in product.options_with_values\n    if o.name == 'Pack'\n      assign pack_pos = o.position\n    endif\n    if o.name == 'Shade'\n      assign shade_pos = o.position\n      assign shade_opt = o\n    endif\n  endfor\n-%}\n{%- if pack_pos > 0 -%}\n<div class=\"pp-bundles\" id=\"pp-bundles-{{ section.id }}\" data-pack-name=\"Pack-{{ pack_pos }}\">\n  {%- assign seen = '|' -%}\n  {%- for v in product.variants -%}\n    {%- unless seen contains v.option2 -%}\n      {%- assign seen = seen | append: v.option2 | append: '|' -%}\n      {%- if v.option2 contains '3' -%}{%- assign qty = 3 -%}\n      {%- elsif v.option2 contains '2' -%}{%- assign qty = 2 -%}\n      {%- else -%}{%- assign qty = 1 -%}{%- endif -%}\n      <button type=\"button\" class=\"pp-bundle\" data-value=\"{{ v.option2 | escape }}\" data-qty=\"{{ qty }}\" aria-pressed=\"false\">\n        {%- if qty == 2 -%}<span class=\"pp-bundle__ribbon\">Save 11%</span>\n        {%- elsif qty == 3 -%}<span class=\"pp-bundle__ribbon pp-bundle__ribbon--best\">Best Value</span>\n        {%- endif -%}\n        <span class=\"pp-bundle__row\">\n          <span class=\"pp-bundle__qty\" aria-hidden=\"true\">{{ qty }}<small>×</small></span>\n          <span class=\"pp-bundle__text\">\n            <span class=\"pp-bundle__title\">\n              {%- if qty == 1 -%}Buy One{%- elsif qty == 2 -%}Buy Two{%- else -%}Buy Three{%- endif -%}\n            </span>\n            <span class=\"pp-bundle__sub\">\n              {%- if v.compare_at_price > v.price -%}\n                You save {{ v.compare_at_price | minus: v.price | money }}\n              {%- else -%}\n                Single pencil\n              {%- endif -%}\n            </span>\n          </span>\n          <span class=\"pp-bundle__price\">\n            <span class=\"pp-bundle__now\">{{ v.price | money }}</span>\n            {%- if v.compare_at_price > v.price -%}\n              <s class=\"pp-bundle__was\">{{ v.compare_at_price | money }}</s>\n            {%- endif -%}\n          </span>\n        </span>\n        {%- if qty > 1 -%}\n          <span class=\"pp-bundle__note\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Mix any shades · {{ v.price | divided_by: qty | money }} per pencil\n          </span>\n        {%- endif -%}\n      </button>\n    {%- endunless -%}\n  {%- endfor -%}\n\n  {%- if shade_pos > 0 -%}\n  <div class=\"pp-mix\" id=\"pp-mix-{{ section.id }}\" data-shade-name=\"Shade-{{ shade_pos }}\">\n    <p class=\"pp-mix__head\">Choose your shades <span>— mix and match, one per pencil</span></p>\n    {%- for i in (1..3) -%}\n      <label class=\"pp-mix__row\" data-slot=\"{{ i }}\" hidden>\n        <span class=\"pp-mix__label\">Pencil {{ i }}</span>\n        <select class=\"pp-mix__select\" data-slot=\"{{ i }}\" aria-label=\"Shade for pencil {{ i }}\">\n          {%- for val in shade_opt.values -%}\n            <option value=\"{{ val | escape }}\">{{ val }}</option>\n          {%- endfor -%}\n        </select>\n      </label>\n    {%- endfor -%}\n    <input type=\"hidden\" data-prop=\"2\" name=\"properties[Pencil 2 shade]\" form=\"product-form-{{ section.id }}\" disabled>\n    <input type=\"hidden\" data-prop=\"3\" name=\"properties[Pencil 3 shade]\" form=\"product-form-{{ section.id }}\" disabled>\n  </div>\n  {%- endif -%}\n\n  <p class=\"pp-delivery\">\n    <span class=\"pp-delivery__dot\" aria-hidden=\"true\"></span>\n    Order today for delivery by <strong data-pp-deliver-by>—</strong>\n  </p>\n</div>\n{%- endif -%}"
          }
        },
