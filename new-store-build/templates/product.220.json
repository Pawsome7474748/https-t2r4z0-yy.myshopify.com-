        "pp_ui": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  :root{--pp-plum:#5e2a3b;--pp-plum2:#7a4257;--pp-blush:#f5e9ec;--pp-red:#dc2626}\n  .pp-opt-hidden{display:none !important}\n  /* author display rules outrank the UA [hidden] rule, so restate it */\n  .pp-mix[hidden],.pp-mix__row[hidden],.pp-stock[hidden]{display:none !important}\n\n  .pp-bundles{display:flex;flex-direction:column;gap:1rem;margin:1.4rem 0 0}\n  .pp-bundle{position:relative;display:block;width:100%;text-align:left;cursor:pointer;\n    background:#fff;border:1.5px solid #e3d9dc;border-radius:12px;padding:1.4rem 1.5rem;\n    font:inherit;color:inherit;transition:border-color .15s,background .15s,box-shadow .15s}\n  .pp-bundle:hover{border-color:var(--pp-plum2)}\n  .pp-bundle.is-active{border-color:var(--pp-plum);background:var(--pp-blush);\n    box-shadow:0 0 0 1px var(--pp-plum)}\n  .pp-bundle__ribbon{position:absolute;top:-11px;right:14px;background:var(--pp-plum2);\n    color:#fff;font-size:1.1rem;font-weight:600;letter-spacing:.02em;\n    padding:.35rem .9rem;border-radius:999px;white-space:nowrap}\n  .pp-bundle__ribbon--best{background:var(--pp-plum)}\n  .pp-bundle__row{display:flex;align-items:center;gap:1.2rem}\n  .pp-bundle__qty{flex:0 0 auto;display:flex;align-items:center;justify-content:center;\n    width:42px;height:42px;border-radius:10px;background:var(--pp-blush);\n    color:var(--pp-plum);font-weight:700;font-size:1.8rem;line-height:1}\n  .pp-bundle__qty small{font-size:1.1rem;margin-left:1px;opacity:.7}\n  .pp-bundle.is-active .pp-bundle__qty{background:var(--pp-plum);color:#fff}\n  .pp-bundle__text{flex:1 1 auto;min-width:0}\n  .pp-bundle__title{display:block;font-weight:700;font-size:1.6rem;line-height:1.25}\n  .pp-bundle__sub{display:block;font-size:1.3rem;opacity:.72;margin-top:.2rem}\n  .pp-bundle__price{flex:0 0 auto;text-align:right;line-height:1.3}\n  .pp-bundle__now{display:block;font-weight:700;font-size:1.7rem;color:var(--pp-plum)}\n  .pp-bundle__was{display:block;font-size:1.3rem;opacity:.55}\n  .pp-bundle__note{display:flex;align-items:center;gap:.5rem;margin-top:1rem;\n    padding-top:1rem;border-top:1px solid rgba(94,42,59,.18);\n    font-size:1.3rem;color:var(--pp-plum);font-weight:600}\n\n  .pp-mix{margin:.4rem 0 0;padding:1.3rem 1.5rem;border:1.5px solid var(--pp-plum);\n    border-radius:12px;background:var(--pp-blush)}\n  .pp-mix__head{margin:0 0 1rem;font-weight:700;font-size:1.4rem;color:var(--pp-plum)}\n  .pp-mix__head span{font-weight:400;opacity:.75}\n  .pp-mix__row{display:flex;align-items:center;gap:1rem;margin-top:.7rem}\n  .pp-mix__label{flex:0 0 78px;font-size:1.3rem;font-weight:600}\n  .pp-mix__select{flex:1 1 auto;min-width:0;padding:.7rem .9rem;font:inherit;font-size:1.4rem;\n    border:1px solid #cbb8be;border-radius:8px;background:#fff;color:inherit}\n\n  .pp-delivery{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem;\n    margin:.3rem 0 0;padding-top:1.1rem;border-top:1px dashed #d9cdd1;font-size:1.35rem}\n  .pp-delivery__dot{width:8px;height:8px;border-radius:50%;background:#1f9d55;flex:0 0 auto}\n  .pp-delivery strong{color:var(--pp-plum)}\n\n  .pp-stock{margin:1.4rem 0 .6rem}\n  .pp-stock__bar{height:9px;border-radius:999px;background:#e8e2e4;overflow:hidden}\n  .pp-stock__fill{display:block;height:100%;border-radius:999px;background:var(--pp-red);\n    transition:width .5s ease}\n  .pp-stock__label{display:inline-block;margin-top:.5rem;font-size:1.3rem;\n    font-weight:700;color:var(--pp-red)}\n\n  .pp-pay{margin:1.2rem 0 0;text-align:center}\n  .pp-pay__label{display:block;font-size:1.2rem;opacity:.65;margin-bottom:.6rem}\n  .pp-pay__list{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;\n    list-style:none;margin:0;padding:0}\n  .pp-pay__list li{display:flex}\n  .pp-pay__icon{height:24px;width:auto}\n\n  .pp-rating{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;\n    margin:0 0 1rem;font-size:1.35rem}\n  .pp-rating__stars{color:#f5a623;letter-spacing:.1em}\n\n  #Inventory-{{ section.id }}{display:flex;align-items:center;gap:.6rem;margin-top:1rem}\n  #Inventory-{{ section.id }}:has(circle[fill=\"rgb(238,148,65)\"]){\n    color:var(--pp-red);font-weight:700;background:#151515;border-radius:8px;\n    padding:.8rem 1rem;border:1px solid rgba(220,38,38,.4)}\n  #Inventory-{{ section.id }} circle[fill=\"rgb(238,148,65, 0.3)\"]{fill:rgba(220,38,38,.3)}\n  #Inventory-{{ section.id }} circle[fill=\"rgb(238,148,65)\"]{fill:var(--pp-red);\n    animation:ppFlash 1s steps(1,end) infinite;transform-origin:center}\n  @keyframes ppFlash{0%,49%{opacity:1}50%,100%{opacity:.15}}\n  @media (prefers-reduced-motion:reduce){\n    #Inventory-{{ section.id }} circle{animation:none}\n    .pp-stock__fill{transition:none}\n  }\n</style>\n<script type=\"application/json\" id=\"pp-stock-data-{{ section.id }}\">\n{% capture pp_stock %}{% for v in product.variants %}\"{{ v.id }}\":{{ v.inventory_quantity | default: 0 }}{% unless forloop.last %},{% endunless %}{% endfor %}{% endcapture %}{ {{- pp_stock -}} }\n</script>\n<script>\n(function(){\n  var SID={{ section.id | json }};\n  var DELIVERY_DAYS=7;\n  var STOCK_SCALE=10, STOCK_SHOW_AT=10;\n\n  function $(s,r){return (r||document).querySelector(s);}\n  function $$(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s));}\n  function form(){return document.getElementById('product-form-'+SID);}\n  function idInput(){var f=form();return f?f.querySelector('input[name=\"id\"]'):null;}\n  function bundles(){return document.getElementById('pp-bundles-'+SID);}\n  function mix(){return document.getElementById('pp-mix-'+SID);}\n\n  var stock={};\n  try{ stock=JSON.parse(($('#pp-stock-data-'+SID)||{}).textContent||'{}'); }catch(e){}\n\n  function radios(name){return $$('input[name=\"'+name+'\"]');}\n  function packName(){var b=bundles();return b?b.dataset.packName:null;}\n  function shadeName(){var m=mix();return m?m.dataset.shadeName:null;}\n  function checkedVal(name){\n    var r=radios(name).filter(function(i){return i.checked;})[0];\n    return r?r.value:null;\n  }\n  function pick(name,value){\n    var t=radios(name).filter(function(i){return i.value===value;})[0];\n    if(t && !t.disabled && !t.checked){ t.click(); return true; }\n    return false;\n  }\n\n  function setDelivery(){\n    var el=$('[data-pp-deliver-by]'); if(!el) return;\n    var d=new Date(Date.now()+DELIVERY_DAYS*864e5);\n    el.textContent=d.toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});\n  }\n\n  function hideNativeOptions(){\n    [packName(),shadeName()].forEach(function(n){\n      if(!n) return;\n      var i=radios(n)[0]; if(!i) return;\n      var fs=i.closest('fieldset,.product-form__input');\n      if(fs) fs.classList.add('pp-opt-hidden');\n    });\n  }\n\n  function currentQty(){\n    var v=checkedVal(packName())||'';\n    var n=parseInt(v,10);\n    return (n>=1&&n<=3)?n:1;\n  }\n\n  function syncCards(){\n    var b=bundles(); if(!b) return;\n    var val=checkedVal(packName());\n    $$('.pp-bundle',b).forEach(function(c){\n      var on=c.dataset.value===val;\n      c.classList.toggle('is-active',on);\n      c.setAttribute('aria-pressed',on?'true':'false');\n    });\n  }\n\n  /* show one shade dropdown per pencil; slots 2-3 ride along as line item properties */\n  function syncMix(){\n    var m=mix(); if(!m) return;\n    var qty=currentQty(), shade=checkedVal(shadeName());\n    m.hidden=false;\n    $$('.pp-mix__row',m).forEach(function(row){\n      var slot=+row.dataset.slot;\n      row.hidden = slot>qty;\n      if(slot===1 && shade){ $('select',row).value=shade; }\n    });\n    $$('input[data-prop]',m).forEach(function(inp){\n      var slot=+inp.dataset.prop;\n      if(slot<=qty){\n        var sel=$('.pp-mix__select[data-slot=\"'+slot+'\"]',m);\n        inp.disabled=false;\n        inp.value=sel?sel.value:'';\n      } else {\n        inp.disabled=true;\n        inp.value='';\n      }\n    });\n  }\n\n  function wire(){\n    var b=bundles(); if(b){\n      $$('.pp-bundle',b).forEach(function(c){\n        c.addEventListener('click',function(){\n          pick(packName(),c.dataset.value);\n          syncCards(); syncMix();\n          setTimeout(function(){syncCards();syncMix();},80);\n        });\n      });\n    }\n    var m=mix(); if(m){\n      $$('.pp-mix__select',m).forEach(function(sel){\n        sel.addEventListener('change',function(){\n          if(+sel.dataset.slot===1){ pick(shadeName(),sel.value); }\n          syncMix();\n          setTimeout(syncMix,80);\n        });\n      });\n    }\n  }\n\n  function setStock(){\n    var el=document.getElementById('pp-stock-'+SID); if(!el) return;\n    var inp=idInput(); var q=inp?stock[inp.value]:undefined;\n    if(typeof q!=='number'||q<=0||q>STOCK_SHOW_AT){el.hidden=true;return;}\n    el.hidden=false;\n    var pct=Math.max(6,Math.min(100,Math.round(q/STOCK_SCALE*100)));\n    $('.pp-stock__fill',el).style.width=pct+'%';\n    $('.pp-stock__label',el).textContent='Only '+q+' left in stock';\n  }\n\n  function reword(){\n    var el=document.getElementById('Inventory-'+SID); if(!el) return;\n    (function walk(n){\n      n.childNodes.forEach(function(c){\n        if(c.nodeType===3){\n          var t=c.nodeValue,v=t\n            .replace(/Low stock:\\s*(\\d+)\\s*left/i,'Almost out of stock')\n            .replace(/^(\\s*)Low stock(\\s*)$/i,'$1Almost out of stock$2');\n          if(v!==t) c.nodeValue=v;\n        } else if(c.nodeType===1) walk(c);\n      });\n    })(el);\n  }\n\n  function update(){ syncCards(); syncMix(); setStock(); reword(); }\n\n  function init(){\n    setDelivery(); hideNativeOptions(); wire(); update();\n    var price=document.getElementById('price-'+SID);\n    if(price) new MutationObserver(update).observe(price,{childList:true,subtree:true});\n    var inv=document.getElementById('Inventory-'+SID);\n    if(inv) new MutationObserver(reword).observe(inv,{childList:true,subtree:true,characterData:true});\n    document.addEventListener('change',function(e){\n      if(e.target && e.target.name && e.target.name.indexOf('-')>-1) setTimeout(update,60);\n    });\n  }\n  document.readyState==='loading'?document.addEventListener('DOMContentLoaded',init):init();\n})();\n</script>"
