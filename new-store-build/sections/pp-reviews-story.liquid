{%- liquid
  assign r = product.metafields.reviews.rating.value
  assign rc = product.metafields.reviews.rating_count
-%}
<div class="pp-html" style="padding:56px 0;background:linear-gradient(180deg,#f5e9ec,#ffffff)">
  <div class="page-width">
    <div class="pp-rev">
      <header class="pp-rev__head">
        <h2 class="pp-rev__title">In their words</h2>
        {%- if r != blank and r.rating > 0 -%}
          {%- assign pct = r.rating | times: 20.0 -%}
          <p class="pp-rev__agg">
            <span class="pp-rev__stars" role="img" aria-label="{{ r.rating }} out of {{ r.scale_max }} stars">
              <span class="pp-rev__stars-fill" style="width:{{ pct }}%">★★★★★</span>
            </span>
            <span>{{ r.rating }} out of {{ r.scale_max }}{% if rc > 0 %} · {{ rc }} review{% if rc != 1 %}s{% endif %}{% endif %}</span>
          </p>
        {%- endif -%}
      </header>

      <div class="pp-rev__grid">
        {%- for block in section.blocks -%}
          {%- assign stars = block.settings.stars -%}
          {%- assign spct = stars | times: 20.0 -%}
          <article class="pp-rev__card" {{ block.shopify_attributes }}>
            {%- if block.settings.photo != blank -%}
              <img class="pp-rev__photo" src="{{ block.settings.photo | image_url: width: 640 }}"
                   alt="" loading="lazy" width="320" height="320">
            {%- endif -%}
            <span class="pp-rev__stars" role="img" aria-label="{{ stars }} out of 5 stars">
              <span class="pp-rev__stars-fill" style="width:{{ spct }}%">★★★★★</span>
            </span>
            <p class="pp-rev__name">
              {%- unless block.settings.photo != blank -%}
                <span class="pp-rev__avatar" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>
              {%- endunless -%}
              {{ block.settings.name }}
            </p>
            <div class="pp-rev__body" data-pp-clamp>{{ block.settings.body }}</div>
            <button type="button" class="pp-rev__more" hidden>Read more</button>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PP - Story reviews",
  "tag": "section",
  "class": "pp-reviews-story-section",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Reviewer name", "default": "Name" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 0.5, "default": 5 },
        { "type": "image_picker", "id": "photo", "label": "Reviewer photo" },
        { "type": "richtext", "id": "body", "label": "Review" }
      ]
    }
  ],
  "presets": [{ "name": "PP - Story reviews", "blocks": [{ "type": "review" }] }]
}
{% endschema %}
