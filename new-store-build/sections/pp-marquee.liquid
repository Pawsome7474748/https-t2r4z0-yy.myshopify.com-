{%- liquid
  comment
    Lowest stock across the shades that are still sellable — summing every
    variant would just report the whole catalogue and mean nothing.
  endcomment
  assign mp = section.settings.product
  assign stock = 0
  if mp != blank
    for v in mp.variants
      if v.available and v.inventory_quantity > 0
        if stock == 0 or v.inventory_quantity < stock
          assign stock = v.inventory_quantity
        endif
      endif
    endfor
  endif
-%}
{% style %}
  .pp-mq{--pp-mq-gap:{{ section.settings.gap }}px;overflow:hidden;position:relative;
    background:{{ section.settings.background }};color:{{ section.settings.text_color }}}
  .pp-mq__track{display:flex;width:max-content;
    animation:ppMarquee {{ section.settings.speed }}s linear infinite}
  .pp-mq:hover .pp-mq__track{animation-play-state:paused}
  .pp-mq__set{display:flex;align-items:center;flex:0 0 auto;
    gap:var(--pp-mq-gap);padding-right:var(--pp-mq-gap)}
  .pp-mq__item{display:flex;align-items:center;gap:.6rem;flex:0 0 auto;
    font-size:{{ section.settings.font_size }}rem;line-height:1;padding:11px 0;
    letter-spacing:.02em;white-space:nowrap}
  .pp-mq__item b{font-weight:700}
  .pp-mq__icon{font-size:1.15em;line-height:1}
  .pp-mq__item--hot{color:{{ section.settings.accent_color }};font-weight:700}
  @keyframes ppMarquee{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}
  @media (prefers-reduced-motion:reduce){
    .pp-mq__track{animation:none}
    .pp-mq{overflow-x:auto;scrollbar-width:none}
    .pp-mq::-webkit-scrollbar{display:none}
  }
{% endstyle %}

{%- capture pp_mq_set -%}
  <div class="pp-mq__set" aria-hidden="false">
    {%- if section.settings.show_stock and mp != blank and stock > 0 and stock <= section.settings.stock_threshold -%}
      <span class="pp-mq__item pp-mq__item--hot">
        <span class="pp-mq__icon" aria-hidden="true">&#9889;</span>
        Only {{ stock }} left in some shades &mdash; selling fast
      </span>
    {%- endif -%}
    {%- for block in section.blocks -%}
      <span class="pp-mq__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <span class="pp-mq__icon" aria-hidden="true">{{ block.settings.icon }}</span>
        {%- endif -%}
        {{ block.settings.text }}
      </span>
    {%- endfor -%}
  </div>
{%- endcapture -%}

<div class="pp-mq">
  <div class="pp-mq__track">
    {{ pp_mq_set }}
    {%- comment -%} the second copy is what makes the loop seamless {%- endcomment -%}
    {{ pp_mq_set | replace: 'aria-hidden="false"', 'aria-hidden="true"' }}
  </div>
</div>

{% schema %}
{
  "name": "PP - Scrolling banner",
  "tag": "section",
  "class": "pp-marquee-section",
  "max_blocks": 14,
  "settings": [
    { "type": "product", "id": "product", "label": "Product for the live stock count" },
    { "type": "checkbox", "id": "show_stock", "label": "Show live low-stock message", "default": true },
    { "type": "range", "id": "stock_threshold", "label": "Show it when stock is at or below", "min": 1, "max": 50, "step": 1, "default": 10 },
    { "type": "range", "id": "speed", "label": "Seconds per loop", "min": 10, "max": 90, "step": 5, "default": 45 },
    { "type": "range", "id": "gap", "label": "Gap between items (px)", "min": 16, "max": 96, "step": 4, "default": 44 },
    { "type": "range", "id": "font_size", "label": "Text size (rem)", "min": 1.1, "max": 1.8, "step": 0.1, "default": 1.3 },
    { "type": "color_background", "id": "background", "label": "Background", "default": "linear-gradient(57deg, #5e2a3b, #7a4257 98%)" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Urgency text", "default": "#ffd479" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji icon", "default": "✨" },
        { "type": "text", "id": "text", "label": "Text", "default": "Benefit" }
      ]
    }
  ],
  "presets": [{ "name": "PP - Scrolling banner", "blocks": [{ "type": "item" }] }]
}
{% endschema %}
