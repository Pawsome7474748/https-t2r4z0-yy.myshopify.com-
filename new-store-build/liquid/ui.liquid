{{ 'pp-ligne.css' | asset_url | stylesheet_tag }}
<div id="pp-ligne" data-section="{{ section.id }}" hidden></div>
<script type="application/json" id="pp-variants-{{ section.id }}">
{%- capture pp_vmap -%}
{%- for v in product.variants -%}
{%- assign q = 1 -%}
{%- if v.option2 contains '3' -%}{%- assign q = 3 -%}{%- elsif v.option2 contains '2' -%}{%- assign q = 2 -%}{%- endif -%}
"{{ v.id }}":{"q":{{ q }},"s":{{ v.option1 | json }},"st":{{ v.inventory_quantity | default: 0 }}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
{%- endcapture -%}
{ {{- pp_vmap -}} }
</script>
<script src="{{ 'pp-ligne.js' | asset_url }}" defer></script>
