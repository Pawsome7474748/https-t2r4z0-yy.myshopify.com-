<style>
  :root{--pp-plum:#5e2a3b;--pp-plum2:#7a4257;--pp-blush:#f5e9ec;--pp-red:#dc2626}
  /* hide the native Pack picker — the bundle cards drive it */
  .pp-pack-hidden{display:none !important}

  .pp-bundles{display:flex;flex-direction:column;gap:1rem;margin:1.4rem 0 0}
  .pp-bundle{position:relative;display:block;width:100%;text-align:left;cursor:pointer;
    background:#fff;border:1.5px solid #e3d9dc;border-radius:12px;padding:1.4rem 1.5rem;
    font:inherit;color:inherit;transition:border-color .15s,background .15s,box-shadow .15s}
  .pp-bundle:hover{border-color:var(--pp-plum2)}
  .pp-bundle.is-active{border-color:var(--pp-plum);background:var(--pp-blush);
    box-shadow:0 0 0 1px var(--pp-plum)}
  .pp-bundle__ribbon{position:absolute;top:-11px;right:14px;background:var(--pp-plum2);
    color:#fff;font-size:1.1rem;font-weight:600;letter-spacing:.02em;
    padding:.35rem .9rem;border-radius:999px;white-space:nowrap}
  .pp-bundle__ribbon--best{background:var(--pp-plum)}
  .pp-bundle__row{display:flex;align-items:center;gap:1.2rem}
  .pp-bundle__imgs{flex:0 0 auto;display:flex}
  .pp-bundle__imgs img{width:44px;height:44px;object-fit:contain;border-radius:6px;
    background:#fff;border:1px solid #eee}
  .pp-bundle__imgs--2 img+img,.pp-bundle__imgs--3 img+img{margin-left:-14px}
  .pp-bundle__text{flex:1 1 auto;min-width:0}
  .pp-bundle__title{display:block;font-weight:700;font-size:1.6rem;line-height:1.25}
  .pp-bundle__sub{display:block;font-size:1.3rem;opacity:.72;margin-top:.2rem}
  .pp-bundle__price{flex:0 0 auto;text-align:right;line-height:1.3}
  .pp-bundle__now{display:block;font-weight:700;font-size:1.7rem;color:var(--pp-plum)}
  .pp-bundle__was{display:block;font-size:1.3rem;opacity:.55}
  .pp-bundle__note{display:flex;align-items:center;gap:.5rem;margin-top:1rem;
    padding-top:1rem;border-top:1px solid rgba(94,42,59,.18);
    font-size:1.3rem;color:var(--pp-plum);font-weight:600}

  .pp-delivery{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem;
    margin:.3rem 0 0;padding-top:1.1rem;border-top:1px dashed #d9cdd1;font-size:1.35rem}
  .pp-delivery__dot{width:8px;height:8px;border-radius:50%;background:#1f9d55;flex:0 0 auto}
  .pp-delivery strong{color:var(--pp-plum)}

  .pp-stock{margin:1.4rem 0 .6rem}
  .pp-stock__bar{height:9px;border-radius:999px;background:#e8e2e4;overflow:hidden}
  .pp-stock__fill{display:block;height:100%;border-radius:999px;background:var(--pp-red);
    transition:width .5s ease}
  .pp-stock__label{display:inline-block;margin-top:.5rem;font-size:1.3rem;
    font-weight:700;color:var(--pp-red)}

  .pp-pay{margin:1.2rem 0 0;text-align:center}
  .pp-pay__label{display:block;font-size:1.2rem;opacity:.65;margin-bottom:.6rem}
  .pp-pay__list{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;
    list-style:none;margin:0;padding:0}
  .pp-pay__list li{display:flex}
  .pp-pay__icon{height:24px;width:auto}

  .pp-rating{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;
    margin:0 0 1rem;font-size:1.35rem}
  .pp-rating__stars{color:#f5a623;letter-spacing:.1em}

  /* flashing almost-out-of-stock pill */
  #Inventory-{{ section.id }}{display:flex;align-items:center;gap:.6rem;margin-top:1rem}
  #Inventory-{{ section.id }}:has(circle[fill="rgb(238,148,65)"]){
    color:var(--pp-red);font-weight:700;background:#151515;border-radius:8px;
    padding:.8rem 1rem;border:1px solid rgba(220,38,38,.4)}
  #Inventory-{{ section.id }} circle[fill="rgb(238,148,65, 0.3)"]{fill:rgba(220,38,38,.3)}
  #Inventory-{{ section.id }} circle[fill="rgb(238,148,65)"]{fill:var(--pp-red);
    animation:ppFlash 1s steps(1,end) infinite;transform-origin:center}
  @keyframes ppFlash{0%,49%{opacity:1}50%,100%{opacity:.15}}
  @media (prefers-reduced-motion:reduce){
    #Inventory-{{ section.id }} circle{animation:none}
    .pp-stock__fill{transition:none}
  }
</style>
<script type="application/json" id="pp-stock-data-{{ section.id }}">
{% capture pp_stock %}{% for v in product.variants %}"{{ v.id }}":{{ v.inventory_quantity | default: 0 }}{% unless forloop.last %},{% endunless %}{% endfor %}{% endcapture %}{ {{- pp_stock -}} }
</script>
<script>
(function(){
  var SID={{ section.id | json }};
  var DELIVERY_DAYS=7;              /* calendar days shown in the delivery promise */
  var STOCK_SCALE=10, STOCK_SHOW_AT=10;

  function $(s,r){return (r||document).querySelector(s);}
  function form(){return document.getElementById('product-form-'+SID);}
  function idInput(){var f=form();return f?f.querySelector('input[name="id"]'):null;}

  var stock={};
  try{ stock=JSON.parse(($('#pp-stock-data-'+SID)||{}).textContent||'{}'); }catch(e){}

  /* ---- delivery date ---- */
  function setDelivery(){
    var el=document.querySelector('[data-pp-deliver-by]'); if(!el) return;
    var d=new Date(Date.now()+DELIVERY_DAYS*864e5);
    el.textContent=d.toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});
  }

  /* ---- bundle cards drive the native Pack radios ---- */
  function bundles(){return document.getElementById('pp-bundles-'+SID);}
  function packInputs(){
    var b=bundles(); if(!b) return [];
    return Array.prototype.slice.call(
      document.querySelectorAll('input[name="'+b.dataset.packName+'"]'));
  }
  function hideNativePack(){
    var i=packInputs()[0]; if(!i) return;
    var fs=i.closest('fieldset,.product-form__input');
    if(fs) fs.classList.add('pp-pack-hidden');
  }
  function syncCards(){
    var b=bundles(); if(!b) return;
    var checked=packInputs().filter(function(i){return i.checked;})[0];
    var val=checked?checked.value:null;
    Array.prototype.forEach.call(b.querySelectorAll('.pp-bundle'),function(c){
      var on=c.dataset.value===val;
      c.classList.toggle('is-active',on);
      c.setAttribute('aria-pressed',on?'true':'false');
    });
  }
  function wireCards(){
    var b=bundles(); if(!b) return;
    Array.prototype.forEach.call(b.querySelectorAll('.pp-bundle'),function(c){
      c.addEventListener('click',function(){
        var t=packInputs().filter(function(i){return i.value===c.dataset.value;})[0];
        if(t && !t.disabled && !t.checked) t.click();
        else syncCards();
      });
    });
  }

  /* ---- stock meter, from real inventory ---- */
  function setStock(){
    var el=document.getElementById('pp-stock-'+SID); if(!el) return;
    var inp=idInput(); var q=inp?stock[inp.value]:undefined;
    if(typeof q!=='number'||q<=0||q>STOCK_SHOW_AT){el.hidden=true;return;}
    el.hidden=false;
    var pct=Math.max(6,Math.min(100,Math.round(q/STOCK_SCALE*100)));
    $('.pp-stock__fill',el).style.width=pct+'%';
    $('.pp-stock__label',el).textContent='Only '+q+' left in stock';
  }

  /* ---- reword the native low-stock line ---- */
  function reword(){
    var el=document.getElementById('Inventory-'+SID); if(!el) return;
    (function walk(n){
      n.childNodes.forEach(function(c){
        if(c.nodeType===3){
          var t=c.nodeValue,v=t
            .replace(/Low stock:\s*(\d+)\s*left/i,'Almost out of stock')
            .replace(/^(\s*)Low stock(\s*)$/i,'$1Almost out of stock$2');
          if(v!==t) c.nodeValue=v;
        } else if(c.nodeType===1) walk(c);
      });
    })(el);
  }

  function update(){ syncCards(); setStock(); reword(); }

  function init(){
    setDelivery(); hideNativePack(); wireCards(); update();
    var price=document.getElementById('price-'+SID);
    if(price) new MutationObserver(update).observe(price,{childList:true,subtree:true});
    var inv=document.getElementById('Inventory-'+SID);
    if(inv) new MutationObserver(reword).observe(inv,{childList:true,subtree:true,characterData:true});
    document.addEventListener('change',function(e){
      if(e.target && e.target.name && e.target.name.indexOf('-')>-1) setTimeout(update,60);
    });
  }
  document.readyState==='loading'?document.addEventListener('DOMContentLoaded',init):init();
})();
</script>
