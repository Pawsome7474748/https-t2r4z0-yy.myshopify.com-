{%- if shop.enabled_payment_types.size > 0 -%}
<div class="pp-pay">
  <span class="pp-pay__label">Secure checkout with</span>
  <ul class="pp-pay__list" role="list">
    {%- for type in shop.enabled_payment_types -%}
      <li>{{ type | payment_type_svg_tag: class: 'pp-pay__icon' }}</li>
    {%- endfor -%}
  </ul>
</div>
{%- endif -%}
